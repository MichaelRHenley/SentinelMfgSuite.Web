@using SentinelMfgSuite.Web.Models
@{
    ViewBag.Title = "Pricing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* Align with site-wide design system */
    body {
        background: radial-gradient(circle at top left, #131b3a 0, #050713 35%, #050b16 100%);
        color: #f4f7ff;
    }

    body::before {
        content: none !important;
        display: none !important;
    }

    .sentinel-section {
        padding: 3.5rem 0;
    }

    .sentinel-kicker {
        letter-spacing: .12em;
        text-transform: uppercase;
        font-size: .8rem;
        font-weight: 650;
        color: #7ea8ff;
        margin-bottom: .6rem;
    }

    .sentinel-hero-title {
        font-size: clamp(2.2rem, 2.6vw + 1.4rem, 3.2rem);
        font-weight: 750;
        line-height: 1.1;
    }

    .sentinel-hero-subtitle {
        color: rgba(219, 229, 255, .78);
        font-size: 1.05rem;
    }

    .sentinel-muted {
        color: rgba(219, 229, 255, .72);
    }

    .sentinel-list {
        margin: .6rem 0 0;
        padding-left: 1.05rem;
        color: rgba(219, 229, 255, .75);
    }

    .glass-card {
        background: radial-gradient(circle at top left, rgba(77, 184, 255, .14), rgba(4, 8, 26, .92));
        border-radius: 1.5rem;
        padding: 1.5rem;
        border: 1px solid rgba(130, 189, 255, .35);
        box-shadow: 0 0 26px rgba(36, 112, 212, .45);
        backdrop-filter: blur(18px);
    }

    .glass-card--soft {
        background: radial-gradient(circle at top left, rgba(14, 20, 54, .70), rgba(4, 7, 22, .96));
        border-radius: 1.25rem;
        border: 1px solid rgba(103, 146, 235, .26);
        box-shadow: 0 0 20px rgba(20, 73, 185, .32);
        backdrop-filter: blur(14px);
    }

    .glass-card-label, .glass-label {
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .18em;
        color: #8fb6ff;
        margin-bottom: .75rem;
    }

    .btn-sentinel-primary {
        border-radius: 999px;
        padding: .75rem 1.75rem;
        font-weight: 600;
        font-size: .95rem;
        border: none;
        background: radial-gradient(circle at top left, #4ef0ff 0, #2d8cff 30%, #1742ff 100%);
        color: #050713 !important;
        box-shadow: 0 0 18px rgba(77, 184, 255, .75);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all .12s ease-out;
    }

    .btn-sentinel-primary:hover {
        filter: brightness(1.07);
        box-shadow: 0 0 24px rgba(77, 184, 255, .95);
        transform: translateY(-1px);
        color: #020308 !important;
    }

    .btn-sentinel-ghost {
        border-radius: 999px;
        padding: .7rem 1.6rem;
        font-weight: 500;
        border: 1px solid rgba(132, 170, 255, .6);
        background: rgba(4, 10, 32, .6);
        color: #d3deff !important;
        text-decoration: none;
        backdrop-filter: blur(14px);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .btn-sentinel-ghost:hover {
        background: rgba(12, 24, 66, .9);
        color: #fff !important;
    }

    /* Billing toggle - matches site patterns */
    .billing-toggle {
        display: inline-flex;
        border-radius: 999px;
        border: 1px solid rgba(132, 170, 255, .4);
        padding: .35rem;
        gap: .35rem;
        background: rgba(4, 10, 32, .6);
        backdrop-filter: blur(14px);
    }

    .billing-toggle-btn {
        border: none;
        background: transparent;
        padding: .5rem 1.25rem;
        border-radius: 999px;
        color: rgba(219, 229, 255, .78);
        font-weight: 500;
        font-size: .9rem;
        cursor: pointer;
        transition: all .2s ease;
    }

    .billing-toggle-btn:hover {
        color: #f4f7ff;
    }

    .billing-toggle-btn.is-active {
        background: radial-gradient(circle at top left, #4ef0ff 0, #2d8cff 30%, #1742ff 100%);
        color: #050713;
        box-shadow: 0 0 12px rgba(77, 184, 255, .5);
    }

    .price-monthly.text-success {
        text-decoration: line-through;
        opacity: .5;
    }

    .price-annual.d-none {
        display: none;
    }

    /* Form inputs - consistent with site */
    .sentinel-input,
    .sentinel-select {
        width: 100%;
        padding: .65rem .85rem;
        border-radius: .8rem;
        border: 1px solid rgba(130, 189, 255, .35);
        background: rgba(4, 10, 32, .6);
        color: #f4f7ff;
        font-size: .9rem;
        backdrop-filter: blur(14px);
    }

    .sentinel-input:focus,
    .sentinel-select:focus {
        outline: none;
        border-color: rgba(77, 184, 255, .8);
        box-shadow: 0 0 12px rgba(77, 184, 255, .3);
    }

    .sentinel-range {
        width: 100%;
        height: 6px;
        border-radius: 3px;
        background: rgba(132, 170, 255, .3);
        outline: none;
        appearance: none;
    }

    .sentinel-range::-webkit-slider-thumb {
        appearance: none;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: radial-gradient(circle at top left, #4ef0ff 0, #2d8cff 50%, #1742ff 100%);
        cursor: pointer;
        box-shadow: 0 0 10px rgba(77, 184, 255, .6);
    }

    .sentinel-range::-moz-range-thumb {
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: radial-gradient(circle at top left, #4ef0ff 0, #2d8cff 50%, #1742ff 100%);
        cursor: pointer;
        box-shadow: 0 0 10px rgba(77, 184, 255, .6);
        border: none;
    }

    .sentinel-label {
        font-size: .8rem;
        color: #8fb6ff;
        margin-bottom: .4rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* FAQ - consistent with site */
    .faq-item {
        border-bottom: 1px solid rgba(132, 170, 255, .2);
        padding: .85rem 0;
    }

    .faq-btn {
        width: 100%;
        background: none;
        border: none;
        color: #f4f7ff;
        font-weight: 650;
        font-size: .95rem;
        text-align: left;
        padding: 0;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .faq-btn:hover {
        color: #7ea8ff;
    }

    .faq-body {
        padding-top: .75rem;
        color: rgba(219, 229, 255, .78);
        font-size: .9rem;
    }

    /* Grid layouts */
    .included-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 1rem;
    }

    .included-grid .col-4 {
        grid-column: span 4;
    }

    .included-grid .col-6 {
        grid-column: span 6;
    }

    @@media (max-width: 768px) {
        .included-grid .col-4,
        .included-grid .col-6 {
            grid-column: span 12;
        }
    }

    /* Pilot Partner Tier - special highlight */
    .pilot-partner-tier {
        position: relative;
        border: 2px solid rgba(111, 255, 210, .9) !important;
        box-shadow: 0 0 32px rgba(111, 255, 210, .6) !important;
        background: radial-gradient(circle at top left, rgba(111, 255, 210, .18), rgba(5, 9, 30, .95)) !important;
    }

    .pilot-badge {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        background: linear-gradient(135deg, #4ef0ff, #2d8cff);
        color: #050713;
        padding: .35rem 1rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        box-shadow: 0 4px 12px rgba(77, 184, 255, .5);
    }
</style>

<main class="sentinel-main">
    <div class="sentinel-page">
        <div class="container-xl">

            <!-- HERO -->
            <section class="sentinel-section" style="padding-top:4rem;padding-bottom:2.5rem;">
                <div class="row g-4 align-items-center">
                    <div class="col-lg-7">
                        <div class="sentinel-kicker">Pricing</div>
                        <h1 class="sentinel-hero-title">
                            Tiered to grow with your factory.
                        </h1>

                        <p class="sentinel-hero-subtitle">
                            Start with the <strong>Emergency Maintenance Module</strong> launching Q2 2026. 
                            Add production, quality, and AI as your digital roadmap matures. 
                            <strong>Pilot partners get 50% off for 12 months.</strong>
                        </p>
                    </div>

                    <div class="col-lg-5">
                        <div class="glass-card">
                            <div class="glass-card-label">What's included</div>
                            <div style="font-size:1.1rem;font-weight:750;margin-bottom:.4rem;">
                                Predictable pricing. Real ROI.
                            </div>

                            <div style="display:inline-flex;align-items:center;gap:.5rem;padding:.4rem .9rem;border-radius:999px;background:rgba(111,255,210,.15);border:1px solid rgba(111,255,210,.5);margin-bottom:.9rem;">
                                <span style="font-size:.85rem;color:#6fffd2;font-weight:650;">
                                    This system costs less than one hour of downtime per month.
                                </span>
                            </div>

                            <ul class="sentinel-list">
                                <li>Secure cloud hosting &amp; automatic updates</li>
                                <li>Unlimited viewer users, role-based access</li>
                                <li>Mobile-friendly web experience</li>
                                <li>Guided onboarding &amp; configuration</li>
                                <li>Email support &amp; knowledge base</li>
                            </ul>

                            <div class="mt-3">
                                <a asp-controller="Home" asp-action="Contact" asp-route-topic="pilot-application"
                                   class="btn-sentinel-primary"
                                   onclick="gtag('event', 'apply_pilot_program', {
                                       'button_location': 'pricing_hero',
                                       'event_category': 'conversion',
                                       'event_label': 'Pricing Hero Apply'
                                   });">
                                    Apply for Pilot Program
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- BILLING TOGGLE -->
            <section class="sentinel-section" style="padding-top:1.5rem;padding-bottom:2.5rem;">
                <div style="display:flex;justify-content:center;margin-bottom:2rem;">
                    <div class="billing-toggle">
                        <button type="button" id="billingToggleMonthly" class="billing-toggle-btn is-active">
                            Monthly
                        </button>
                        <button type="button" id="billingToggleAnnual" class="billing-toggle-btn">
                            Annual (save ~15%)
                        </button>
                    </div>
                </div>

                <!-- TIERS -->
                @await Html.PartialAsync("_SectionHeader", new SectionHeaderModel
                       {
                           Kicker = "Subscription Tiers",
                           Title = "Start with EM. Grow into the full suite.",
                           Subtitle = "The Emergency Maintenance Module launches Q2 2026. Pilot partners get early access, 50% discount, and co-design privileges. Other modules launch later in 2026."
                       })

                <div class="row g-4">

                    <!-- PILOT PARTNER TIER (NEW) -->
                    <div class="col-lg-4">
                        @await Html.PartialAsync("_TierCard", new TierCardViewModel
                               {
                                   TierLabel = "Pilot Partner",
                                   TierBadge = "Limited to 5-10 Partners",
                                   Title = "EM Module Early Access",
                                   Description = "Be first to deploy the EM Module when it launches Q2 2026. Co-design your deployment, get 50% off for 12 months, and shape the roadmap.",
                                   MonthlyPrice = 249,
                                   AnnualPrice = 2541,
                                   ButtonText = "Apply for Pilot Program",
                                   ButtonController = "Home",
                                   ButtonAction = "Contact",
                                   ButtonRouteTopic = "pilot-application",
                                   CssModifier = "pilot-partner-tier",
                                   Features = new[]
                                   {
                                       "🚀 Early access when EM Module launches Q2 2026",
                                       "💰 50% discount for 12 months ($249/mo vs $499 regular)",
                                       "🤝 Co-design your deployment with engineering",
                                       "🎯 Direct engineering access & priority support",
                                       "📊 Shape EM v2.0 and future module roadmap",
                                       "⏰ Priority access to future modules (Planned Maintenance, Production Tracking, Parts)",
                                       "✅ All Standard tier features when EM launches",
                                       "⚠️ Limited spots available — first-come, first-served"
                                   }
                               })
                    </div>

                    <!-- STANDARD TIER -->
                    <div class="col-lg-4">
                        @await Html.PartialAsync("_TierCard", new TierCardViewModel
                               {
                                   TierLabel = "Standard",
                                   Title = "EM Module + Core Platform",
                                   Description = "Start here after pilot program closes. Get the Emergency Maintenance Module, production tracking, quality/safety, and baseline AI.",
                                   MonthlyPrice = 499,
                                   AnnualPrice = 5085,
                                   ButtonText = "Reserve Standard Tier",
                                   ButtonController = "Home",
                                   ButtonAction = "Contact",
                                   ButtonRouteTopic = "pricing-conversation",
                                   CssModifier = "glass-card--soft",
                                   Features = new[]
                                   {
                                       "Available when EM Module launches Q2 2026",
                                       "Emergency Maintenance board with live chat",
                                       "Mobile responders, photos, machine status",
                                       "Production & downtime tracking",
                                       "Quality & safety incident capture",
                                       "Baseline AI assistance (suggested fixes, likely parts)",
                                       "Core dashboards & reports",
                                       "Email support & knowledge base",
                                       "Introductory pricing until Advanced launches"
                                   }
                               })
                    </div>

                    <!-- ADVANCED TIER -->
                    <div class="col-lg-4">
                        @await Html.PartialAsync("_TierCard", new TierCardViewModel
                               {
                                   TierLabel = "Advanced",
                                   TierBadge = "Coming Later 2026",
                                   Title = "Operations Intelligence",
                                   Description = "Deep analytics across EM, planned maintenance, production, and quality. Scheduling, reliability scoring, and advanced AI insights.",
                                   MonthlyPrice = 1999,
                                   AnnualPrice = 20385,
                                   ButtonText = "Talk about Advanced roadmap",
                                   ButtonController = "Home",
                                   ButtonAction = "Contact",
                                   ButtonRouteTopic = "enterprise-multi-site",
                                   CssModifier = "glass-card--soft",
                                   Features = new[]
                                   {
                                       "Planned availability: Later 2026",
                                       "Everything in Standard",
                                       "Planned Maintenance module",
                                       "Production & downtime by line/work center",
                                       "OEE KPIs and trend analysis",
                                       "Integrated EM + Production + Quality views",
                                       "Maintenance scheduling & route planning",
                                       "Reliability scoring & repeat issue detection",
                                       "Annual & multi-year agreements only"
                                   }
                               })
                    </div>

                </div>

                <div class="row g-4 mt-3">

                    <!-- PREMIUM TIER -->
                    <div class="col-lg-6">
                        @await Html.PartialAsync("_TierCard", new TierCardViewModel
                               {
                                   TierLabel = "Premium",
                                   TierBadge = "Coming Later 2026",
                                   Title = "Predictive & Multi-Site",
                                   Description = "For larger plants or multi-site operations. Predictive insights, Parts Intelligence module, customization, and deeper integrations.",
                                   MonthlyPrice = 5499,
                                   AnnualPrice = 56085,
                                   ButtonText = "Talk about Premium roadmap",
                                   ButtonController = "Home",
                                   ButtonAction = "Contact",
                                   ButtonRouteTopic = "enterprise-multi-site",
                                   CssModifier = "glass-card--soft",
                                   Features = new[]
                                   {
                                       "Planned availability: Later 2026",
                                       "Everything in Advanced",
                                       "Parts & BOM Intelligence module",
                                       "AI-assisted suggestions for fixes and parts",
                                       "Early-warning / recurrence and risk signals",
                                       "Multi-site rollups and benchmarking",
                                       "API / integration options for CMMS, ERP, historian, MES",
                                       "Premium support with success reviews",
                                       "Annual & multi-year agreements only",
                                       "3-year commitment: save ~15% versus annual"
                                   }
                               })
                    </div>

                    <!-- ENTERPRISE TIER -->
                    <div class="col-lg-6">
                        <div class="glass-card glass-card--soft h-100">
                            <div class="glass-card-label">Enterprise</div>
                            <div style="display: inline-flex; align-items: center; gap: .5rem; margin-bottom: .5rem;">
                                <div style="font-size:1.25rem;font-weight:750;">Elite Engineering & Consulting</div>
                            </div>

                            <p style="margin:0 0 1rem; color: rgba(219, 229, 255, 0.78); font-size: .95rem;">
                                For organizations ready to go all-in on smart factory transformation. 
                                Custom AI, PLC logic, reliability engineering, and transformation services.
                            </p>

                            <ul class="sentinel-list">
                                <li>Custom AI models trained on your data</li>
                                <li>PLC / SCADA integration engineering</li>
                                <li>Reliability consulting & RCA services</li>
                                <li>Dedicated success team & SLAs</li>
                                <li>White-glove deployment & training</li>
                                <li>Custom development & integrations</li>
                            </ul>

                            <div class="mt-3">
                                <a asp-controller="Home" asp-action="Contact" asp-route-topic="enterprise-multi-site"
                                   class="btn-sentinel-primary"
                                   onclick="gtag('event', 'enterprise_inquiry', {
                                       'button_location': 'pricing_tiers',
                                       'event_category': 'conversion',
                                       'event_label': 'Enterprise Tier Inquiry'
                                   });">
                                    Talk about Enterprise
                                </a>
                            </div>
                        </div>
                    </div>

                </div>

                <p class="sentinel-muted small mt-3 mb-0">
                    <strong>Pilot Partner tier:</strong> Limited to 5-10 partners, first-come first-served. 50% discount applies for first 12 months, then converts to Standard tier pricing. 
                    <strong>Standard tier:</strong> Available when EM Module launches Q2 2026. 
                    <strong>Advanced & Premium:</strong> Planned for later 2026 after EM stabilizes. 
                    All prices in USD, subject to taxes where applicable. Final pricing may vary based on site complexity and deployment scope.
                </p>
            </section>

            <!-- ROI -->
            <section id="roi" class="sentinel-section" style="padding-top:1.5rem;">
                <div class="glass-card">
                    <div class="row g-4 align-items-start">
                        <div class="col-lg-5">
                            <div class="glass-label">ROI estimator</div>
                            <div style="font-size:1.3rem;font-weight:750;margin-bottom:.6rem;">
                                What is downtime really costing you?
                            </div>
                            <p class="sentinel-muted mb-3">
                                Estimate what an hour of downtime is worth at your site, and how quickly a Sentinel tier could pay for itself.
                            </p>
                            <ul class="sentinel-list">
                                <li>Rough numbers are fine — this is directional.</li>
                                <li>Adjust expected reduction as you learn more.</li>
                                <li>We'll refine the model with you during a live conversation.</li>
                            </ul>
                        </div>

                        <div class="col-lg-7">
                            <div class="included-grid">
                                <div class="col-6">
                                    <div class="sentinel-label">Downtime hours per month</div>
                                    <input type="number" class="sentinel-input" id="roiHours" min="0" step="1" value="20" />
                                </div>
                                <div class="col-6">
                                    <div class="sentinel-label">Cost per hour of downtime (USD)</div>
                                    <input type="number" class="sentinel-input" id="roiCostPerHour" min="0" step="100" value="3000" />
                                </div>

                                <div class="col-6">
                                    <div class="sentinel-label">
                                        <span>Expected downtime reduction</span>
                                        <span id="roiReductionLabel" style="color:#7ea8ff;font-weight:650;">20%</span>
                                    </div>
                                    <input type="range" class="sentinel-range" id="roiReduction" min="5" max="60" step="5" value="20" />
                                </div>

                                <div class="col-6">
                                    <div class="sentinel-label">Compare against tier</div>
                                    <select id="roiTier" class="sentinel-select">
                                        <option value="249">Pilot Partner ($249/mo, 50% off)</option>
                                        <option value="499" selected>Standard ($499/mo)</option>
                                        <option value="1999">Advanced (planned, $1,999/mo)</option>
                                        <option value="5499">Premium (planned, $5,499/mo)</option>
                                    </select>
                                </div>
                            </div>

                            <hr style="border-color: rgba(132,170,255,.18); margin: 1.25rem 0;" />

                            <div class="included-grid">
                                <div class="col-4">
                                    <div class="glass-label">Estimated monthly savings</div>
                                    <div id="roiMonthlySavings" style="font-size:1.35rem;font-weight:750;">$0</div>
                                </div>
                                <div class="col-4">
                                    <div class="glass-label">Estimated annual savings</div>
                                    <div id="roiAnnualSavings" style="font-size:1.35rem;font-weight:750;">$0</div>
                                </div>
                                <div class="col-4">
                                    <div class="glass-label">12-month ROI vs tier</div>
                                    <div id="roiMultiplier" style="font-size:1.35rem;font-weight:750;">–</div>
                                </div>
                            </div>

                            <div class="mt-3 small sentinel-muted" id="roiSummaryLine">
                                Enter your numbers to see a quick payback estimate.
                            </div>

                            <div class="mt-3 d-flex flex-wrap gap-2">
                                <a asp-controller="Home" asp-action="Contact" asp-route-topic="pilot-application" class="btn-sentinel-primary">
                                    Apply for Pilot Program
                                </a>
                                <a asp-controller="Home" asp-action="Contact" asp-route-topic="pricing-conversation" class="btn-sentinel-ghost">
                                    Talk about pricing
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- INCLUDED -->
            <section class="sentinel-section" style="padding-top:1.5rem;">
                <div class="glass-card--soft" style="padding:1.5rem;">
                    <div class="glass-label">Included on every tier</div>
                    <div style="font-size:1.3rem;font-weight:750;margin-bottom:.9rem;">What's included on every tier</div>

                    <div class="included-grid">
                        <div class="col-4">
                            <div style="font-weight:750;margin-bottom:.35rem;color:#f4f7ff;">Platform &amp; security</div>
                            <ul class="sentinel-list">
                                <li>Secure cloud hosting</li>
                                <li>Automatic updates and new features</li>
                                <li>Single sign-on options</li>
                                <li>Environment separation for test / prod</li>
                            </ul>
                        </div>

                        <div class="col-4">
                            <div style="font-weight:750;margin-bottom:.35rem;color:#f4f7ff;">Users &amp; access</div>
                            <ul class="sentinel-list">
                                <li>Unlimited viewer users</li>
                                <li>Role-based permissions by team</li>
                                <li>Mobile-friendly web experience</li>
                                <li>Audit logs for key actions</li>
                            </ul>
                        </div>

                        <div class="col-4">
                            <div style="font-weight:750;margin-bottom:.35rem;color:#f4f7ff;">Support &amp; onboarding</div>
                            <ul class="sentinel-list">
                                <li>Guided onboarding call</li>
                                <li>Configuration of sites, areas, and work centers</li>
                                <li>Access to best-practice playbooks</li>
                                <li>Email support &amp; knowledge base</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>

            <!-- FAQ + CTA -->
            <section class="sentinel-section" style="padding-top:1.5rem;padding-bottom:4rem;">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="glass-label">FAQ</div>
                        <div style="font-size:1.3rem;font-weight:750;margin-bottom:.9rem;">Pricing questions</div>

                                        <div class="faq-item">
                                            <button class="faq-btn" type="button" data-bs-toggle="collapse" data-bs-target="#faqPilot" aria-expanded="false">
                                                What's included in the Pilot Partner program?
                                                <span style="opacity:.75;">+</span>
                                            </button>
                                            <div id="faqPilot" class="collapse">
                                                <div class="faq-body">
                                                    Pilot partners get early access to the EM Module when it launches Q2 2026, 
                                                    50% discount for 12 months ($249/mo instead of $499), direct engineering access, 
                                                    co-design privileges for your deployment, and priority access to future modules 
                                                    as they roll out later in 2026. Limited to 5-10 partners.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="faq-item">
                                            <button class="faq-btn" type="button" data-bs-toggle="collapse" data-bs-target="#faqOne" aria-expanded="false">
                                                How long does it take to get live?
                                                <span style="opacity:.75;">+</span>
                                            </button>
                                            <div id="faqOne" class="collapse">
                                                <div class="faq-body">
                                                    Pilot partners work directly with engineering to co-design their deployment — 
                                                    typically weeks from kickoff to first EM calls tracked. We focus first on 
                                                    EM visibility and mobile workflows, then expand from there.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="faq-item">
                                            <button class="faq-btn" type="button" data-bs-toggle="collapse" data-bs-target="#faqTwo" aria-expanded="false">
                                                What if we already have a CMMS or MES?
                                                <span style="opacity:.75;">+</span>
                                            </button>
                                            <div id="faqTwo" class="collapse">
                                                <div class="faq-body">
                                                    Sentinel is designed to sit alongside systems you already use.
                                                    We can pull or push data where it makes sense, but the goal is to give
                                                    your teams a unified operational view without ripping anything out.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="faq-item">
                                            <button class="faq-btn" type="button" data-bs-toggle="collapse" data-bs-target="#faqThree" aria-expanded="false">
                                                Can we start small and expand later?
                                                <span style="opacity:.75;">+</span>
                                            </button>
                                            <div id="faqThree" class="collapse">
                                                <div class="faq-body">
                                                    Yes. Start with the EM Module, then add Planned Maintenance, 
                                                    Production Tracking, and Parts Intelligence as they launch later in 2026. 
                                                    Pilot partners get priority access to all future modules.
                                                </div>
                                            </div>
                                        </div>

                                        <div class="faq-item">
                                            <button class="faq-btn" type="button" data-bs-toggle="collapse" data-bs-target="#faqFour" aria-expanded="false">
                                                What happens after the 12-month pilot discount?
                                                <span style="opacity:.75;">+</span>
                                            </button>
                                            <div id="faqFour" class="collapse">
                                                <div class="faq-body">
                                                    After 12 months, Pilot Partner pricing converts to Standard tier pricing ($499/mo). 
                                                    You keep all benefits, priority support, and early access to new modules. 
                                                    No forced upgrade or long-term lock-in.
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-5">
                                        <div class="glass-card h-100">
                                            <div class="glass-label">Next step</div>
                                            <div style="font-size:1.3rem;font-weight:750;margin-bottom:.6rem;">Ready to apply for the pilot?</div>
                                            <p class="sentinel-muted mb-3">
                                                Tell us about your site — size, lines, current EM challenges — and we'll schedule 
                                                a discovery call to see if you're a good fit. First-come, first-served for 5-10 spots.
                                            </p>

                                            <ul class="sentinel-list">
                                                <li>Quick discovery call with someone who knows plants</li>
                                                <li>Live walk-through of the EM Module roadmap</li>
                                                <li>Clear timeline and co-design expectations</li>
                                            </ul>

                                            <div class="mt-3 d-flex flex-wrap gap-2">
                                                <a asp-controller="Home" asp-action="Contact" asp-route-topic="pilot-application"
                                                   class="btn-sentinel-primary"
                                                   onclick="gtag('event', 'apply_pilot_program', {
                                                       'button_location': 'pricing_faq_cta',
                                                       'event_category': 'conversion',
                                                       'event_label': 'FAQ Section Apply'
                                                   });">
                                                    Apply for Pilot Program
                                                </a>
                                                <a asp-controller="Home" asp-action="Contact" asp-route-topic="pricing-conversation" class="btn-sentinel-ghost">
                                                    Talk about pricing
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

        </div>
    </div>
</main>

@section Scripts {
    <script>
        (function () {
            // =========================
            // Billing toggle
            // =========================
            const btnMonthly = document.getElementById('billingToggleMonthly');
            const btnAnnual = document.getElementById('billingToggleAnnual');
            const annualEls = document.querySelectorAll('.price-annual');
            const monthlyEls = document.querySelectorAll('.price-monthly');

            function setActive(btn, active) {
                if (!btn) return;
                btn.classList.toggle('is-active', !!active);
            }

            function showMonthly() {
                setActive(btnMonthly, true);
                setActive(btnAnnual, false);

                annualEls.forEach(el => el.classList.add('d-none'));
                monthlyEls.forEach(el => el.classList.remove('text-success'));
            }

            function showAnnual() {
                setActive(btnMonthly, false);
                setActive(btnAnnual, true);

                annualEls.forEach(el => el.classList.remove('d-none'));
                monthlyEls.forEach(el => el.classList.add('text-success'));
            }

            if (btnMonthly && btnAnnual) {
                btnMonthly.addEventListener('click', showMonthly);
                btnAnnual.addEventListener('click', showAnnual);
            }
            showMonthly();

            // =========================
            // ROI Calculator
            // =========================
            const hoursInput = document.getElementById('roiHours');
            const costInput = document.getElementById('roiCostPerHour');
            const reductionInput = document.getElementById('roiReduction');
            const reductionLabel = document.getElementById('roiReductionLabel');
            const tierSelect = document.getElementById('roiTier');

            const monthlyOut = document.getElementById('roiMonthlySavings');
            const annualOut = document.getElementById('roiAnnualSavings');
            const multiplierOut = document.getElementById('roiMultiplier');
            const summaryLine = document.getElementById('roiSummaryLine');

            const fmtCurrency = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
                maximumFractionDigits: 0
            });

            const fmtNumber = new Intl.NumberFormat('en-US', { maximumFractionDigits: 1 });

            function updateReductionLabel() {
                if (!reductionInput || !reductionLabel) return;
                reductionLabel.textContent = reductionInput.value + '%';
            }

            function updateRoi() {
                if (!hoursInput || !costInput || !reductionInput || !tierSelect) return;

                const hours = Math.max(0, Number(hoursInput.value) || 0);
                const costPerHour = Math.max(0, Number(costInput.value) || 0);
                const reductionPct = Math.max(0, Number(reductionInput.value) || 0);
                const tierPrice = Math.max(0, Number(tierSelect.value) || 0);

                const baselineMonthlyLoss = hours * costPerHour;
                const monthlySavings = baselineMonthlyLoss * (reductionPct / 100);
                const annualSavings = monthlySavings * 12;

                if (monthlyOut) monthlyOut.textContent = fmtCurrency.format(monthlySavings || 0);
                if (annualOut) annualOut.textContent = fmtCurrency.format(annualSavings || 0);

                let multiplierText = '–';
                if (tierPrice > 0 && annualSavings > 0) {
                    const roiMultiple = annualSavings / (tierPrice * 12);
                    multiplierText = roiMultiple < 0.1 ? '<1×' : fmtNumber.format(roiMultiple) + '×';
                }
                if (multiplierOut) multiplierOut.textContent = multiplierText;

                if (summaryLine) {
                    if (monthlySavings > 0 && tierPrice > 0) {
                        const netPerMonth = monthlySavings - tierPrice;
                        summaryLine.textContent =
                            `At these numbers, Sentinel would save about ${fmtCurrency.format(monthlySavings)} per month ` +
                            `against roughly ${fmtCurrency.format(tierPrice)} in subscription cost — ` +
                            `around ${fmtCurrency.format(netPerMonth)} net per month before any other benefits.`;
                    } else {
                        summaryLine.textContent = 'Enter your numbers to see a quick payback estimate.';
                    }
                }
            }

            if (reductionInput) {
                reductionInput.addEventListener('input', function () {
                    updateReductionLabel();
                    updateRoi();
                });
            }

            [hoursInput, costInput, tierSelect].forEach(el => {
                if (!el) return;
                el.addEventListener('input', updateRoi);
                el.addEventListener('change', updateRoi);
            });

            updateReductionLabel();
            updateRoi();
        })();
    </script>
}