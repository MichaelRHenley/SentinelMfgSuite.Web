@* Views/Home/Index.cshtml — NEW company homepage *@
@{
    ViewBag.Title = "Industrial AI & Manufacturing Data Integration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: radial-gradient(circle at top left, #131b3a 0, #050713 35%, #050b16 100%);
        color: #f4f7ff;
    }

        body::before {
            content: none !important;
            display: none !important;
        }

    .sis-page {
        min-height: 100vh;
        padding-bottom: 4rem;
    }

    /* =========================================
           HERO
        ========================================= */
    .sis-hero {
        padding: 5rem 0 3.5rem;
        position: relative;
        overflow: hidden;
    }

        .sis-hero::before {
            content: "";
            position: absolute;
            top: -40px;
            right: 780px;
            width: 520px;
            height: 520px;
            background-image: url("/img/branding/sentinel emblem trans.png");
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            opacity: .07;
            pointer-events: none;
            filter: drop-shadow(0 0 18px rgba(0,0,0,.45));
        }

    .sis-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
        gap: 3rem;
        align-items: start;
        position: relative;
        z-index: 1;
    }

    .sis-kicker {
        letter-spacing: .12em;
        text-transform: uppercase;
        font-size: .8rem;
        font-weight: 600;
        color: #7ea8ff;
        margin-bottom: .75rem;
    }

    .sis-title {
        font-size: clamp(2.2rem, 3vw + 1.2rem, 3.2rem);
        font-weight: 700;
        line-height: 1.08;
        margin-bottom: 1rem;
    }

        .sis-title span {
            background: linear-gradient(120deg, #4ef0ff, #2d8cff, #8f8dff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

    .sis-sub {
        font-size: 1.05rem;
        max-width: 44rem;
        color: #c6d1ff;
        margin-bottom: 1.5rem;
    }

    .sis-ctas {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-bottom: 1rem;
    }

    /* Buttons */
    .btn-sentinel-primary {
        border-radius: 999px;
        padding: .75rem 1.75rem;
        font-weight: 600;
        border: none;
        background: radial-gradient(circle at top left, #4ef0ff 0, #2d8cff 30%, #1742ff 100%);
        color: #050713;
        box-shadow: 0 0 18px rgba(77, 184, 255, .65);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-sentinel-primary:hover {
            filter: brightness(1.05);
            box-shadow: 0 0 24px rgba(77,184,255,.9);
            color: #020308;
        }

    .btn-sentinel-ghost {
        border-radius: 999px;
        padding: .75rem 1.6rem;
        font-weight: 500;
        border: 1px solid rgba(132,170,255,.6);
        background: rgba(4,10,32,.6);
        color: #d3deff;
        text-decoration: none;
        backdrop-filter: blur(14px);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-sentinel-ghost:hover {
            background: rgba(12,24,66,.9);
            color: #fff;
        }

    /* Glass card (console) */
    .glass-card {
        background: radial-gradient(circle at top left, rgba(77,184,255,.12), rgba(4,8,26,.9));
        border-radius: 1.5rem;
        padding: 1.5rem;
        border: 1px solid rgba(130,189,255,.4);
        box-shadow: 0 0 28px rgba(36,112,212,.55);
        backdrop-filter: blur(18px);
    }

    .glass-card-label {
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .18em;
        color: #8fb6ff;
        margin-bottom: .75rem;
    }

    /* Enterprise proof strip */
    .sis-proof {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .75rem;
        margin-top: 1.25rem;
        max-width: 46rem;
    }

    .sis-proof-item {
        border-radius: 1rem;
        padding: .75rem .85rem;
        background: rgba(4,10,32,.55);
        border: 1px solid rgba(132,170,255,.35);
        backdrop-filter: blur(14px);
    }

    .sis-proof-top {
        font-weight: 600;
        font-size: .9rem;
    }

    .sis-proof-sub {
        color: #a7b4e4;
        font-size: .8rem;
        margin-top: .15rem;
    }

    /* Console rows */
    .sis-console {
        display: flex;
        flex-direction: column;
        gap: .65rem;
        margin-bottom: .9rem;
    }

    .sis-console-row {
        display: flex;
        align-items: flex-start;
        gap: .65rem;
        padding: .75rem .8rem;
        border-radius: 1rem;
        background: radial-gradient(circle at top left, rgba(67,132,255,.16), rgba(6,12,40,.92));
        border: 1px solid rgba(133,172,255,.28);
    }

    .sis-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        margin-top: .3rem;
        box-shadow: 0 0 12px rgba(77,184,255,.55);
        flex: 0 0 auto;
    }

        .sis-dot.ok {
            background: rgba(111,255,210,.95);
            box-shadow: 0 0 16px rgba(111,255,210,.55);
        }

        .sis-dot.warn {
            background: rgba(255,214,102,.95);
            box-shadow: 0 0 16px rgba(255,214,102,.55);
        }

        .sis-dot.info {
            background: rgba(78,240,255,.95);
            box-shadow: 0 0 16px rgba(78,240,255,.55);
        }

    .sis-console-main {
        flex: 1;
    }

    .sis-console-title {
        font-weight: 600;
    }

    .sis-console-sub {
        font-size: .82rem;
        color: #a0aedc;
        margin-top: .15rem;
    }

    .sis-console-pill {
        font-size: .72rem;
        letter-spacing: .14em;
        text-transform: uppercase;
        padding: .18rem .55rem;
        border-radius: 999px;
        border: 1px solid rgba(181,255,231,.35);
        background: rgba(4,20,18,.6);
        color: #b5ffe7;
        white-space: nowrap;
    }

        .sis-console-pill.warn {
            border-color: rgba(255,219,137,.45);
            background: rgba(21,14,7,.65);
            color: #ffe2a3;
        }

        .sis-console-pill.info {
            border-color: rgba(158,214,255,.45);
            background: rgba(4,10,32,.6);
            color: #cfe3ff;
        }

    /* Mini cards */
    .sis-mini-cards {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: .65rem;
    }

    .sis-mini {
        border-radius: 1rem;
        padding: .75rem .8rem;
        background: rgba(4,10,32,.5);
        border: 1px solid rgba(132,170,255,.25);
    }

    .sis-mini-label {
        font-size: .75rem;
        color: #8fb6ff;
        text-transform: uppercase;
        letter-spacing: .16em;
    }

    .sis-mini-value {
        font-weight: 700;
        margin-top: .2rem;
    }

    /* Capability cards */
    .sis-cap-grid {
        margin-top: 1.5rem;
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 1rem;
    }

    .sis-cap-card {
        border-radius: 1.25rem;
        padding: 1.1rem 1.1rem 1.15rem;
        background: radial-gradient(circle at top left, rgba(77,184,255,.18), rgba(5,9,30,.92));
        border: 1px solid rgba(143,191,255,.5);
        backdrop-filter: blur(14px);
    }

    .sis-cap-kicker {
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .18em;
        color: #7ea8ff;
        margin-bottom: .35rem;
    }

    .sis-cap-title {
        font-weight: 600;
        font-size: 1.05rem;
    }

    .sis-cap-sub {
        margin-top: .25rem;
        color: #c5d2ff;
        font-size: .9rem;
    }

    /* Spotlight band */
    .sis-spotlight {
        margin-top: 1.25rem;
        border-radius: 1.5rem;
        padding: 1.25rem 1.2rem;
        background: linear-gradient(120deg, rgba(77,184,255,.22), rgba(111,255,210,.14));
        border: 1px solid rgba(158,214,255,.65);
        box-shadow: 0 0 26px rgba(77,184,255,.45);
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
    }

    .sis-spotlight-kicker {
        font-size: .72rem;
        text-transform: uppercase;
        letter-spacing: .18em;
        color: #061128;
        opacity: .9;
    }

    .sis-spotlight-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #061128;
        margin-top: .15rem;
    }

    .sis-spotlight-sub {
        color: #061128;
        opacity: .9;
        margin-top: .15rem;
        max-width: 44rem;
    }

    .sis-spotlight-ctas {
        display: flex;
        gap: .75rem;
        flex-wrap: wrap;
    }

    /* Sections */
    .sis-section {
        padding: 3.25rem 0;
    }

    .sis-header {
        max-width: 48rem;
        margin-bottom: 1.75rem;
    }

    .sis-hk {
        font-size: .8rem;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #7ea8ff;
        margin-bottom: .4rem;
    }

    .sis-ht {
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: .5rem;
    }

    .sis-hs {
        font-size: .95rem;
        color: #b5c3f0;
    }

    .sis-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px,1fr));
        gap: 1rem;
    }

    .sis-card {
        background: radial-gradient(circle at top left, rgba(77,184,255,.16), rgba(5,9,30,.92));
        border-radius: 1.2rem;
        padding: 1.2rem;
        border: 1px solid rgba(143,191,255,.55);
        backdrop-filter: blur(14px);
    }

        .sis-card h3 {
            font-size: 1rem;
            margin-bottom: .35rem;
            font-weight: 600;
        }

        .sis-card p {
            margin: 0;
            color: #c5d2ff;
            font-size: .9rem;
        }

    /* Responsive */
    @@media (max-width: 992px) {
        .sis-hero {
            padding-top: 3rem;
        }

        .sis-hero-grid {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }

        .sis-hero::before {
            top: -20px;
            right: 10px;
            width: 360px;
            height: 360px;
            opacity: .09;
        }

        .sis-proof {
            grid-template-columns: 1fr;
        }

        .sis-cap-grid {
            grid-template-columns: 1fr;
        }

        .sis-spotlight {
            flex-direction: column;
            align-items: flex-start;
        }
       }
        /* =========================
       Spotlight readability fix
    ========================= */
        .sis-spotlight {
            background: radial-gradient(circle at top left, rgba(77,184,255,.18), rgba(4,8,26,.92));
            border: 1px solid rgba(143,191,255,.5);
            box-shadow: 0 0 28px rgba(36,112,212,.35);
        }
            /* Force LIGHT text on spotlight */
            .sis-spotlight,
            .sis-spotlight * {
                color: #eaf2ff !important;
            }
        /* Restore hierarchy */
        .sis-spotlight-kicker {
            opacity: .85 !important;
            letter-spacing: .22em;
        }

        .sis-spotlight-title {
            color: #ffffff !important;
            text-shadow: 0 0 18px rgba(77, 184, 255, .25);
        }

        .sis-spotlight-sub {
            opacity: .92 !important;
            max-width: 52rem;
        }
        /* Optional: add a soft overlay behind left text for extra contrast */
        .sis-spotlight-left {
            padding: .35rem .5rem;
            border-radius: 1rem;
            background: rgba(0, 0, 0, .18);
            border: 1px solid rgba(255,255,255,.06);
        }
    
</style>

<div class="sis-page">
    <div class="container">

        <!-- HERO -->
        
        <section class="sis-hero">
            <div class="sis-hero-grid">
                <div>
                    <div class="sis-kicker">INDUSTRIAL INTELLIGENCE ENGINEERING</div>

                    <h1 class="sis-title">
                        Turn industrial data into <span>operational intelligence</span>.
                    </h1>

                    <p class="sis-sub">
                        Sentinel AI Systems helps manufacturers connect operational technology, business systems and industrial data so
                        people, applications, analytics and AI can work with meaningful manufacturing context.
                    </p>

                    <div class="sis-ctas">
                        <a asp-controller="Home" asp-action="Contact" asp-route-topic="industrial-ai-readiness"
                           class="btn-sentinel-primary">
                            Discuss your manufacturing challenge
                        </a>
                    </div>

                    <div style="margin-top:.65rem; color:#cfe3ff; font-weight:600;">
                        Your manufacturing data. Your architecture. Your choice of technology.
                    </div>

                    <!-- Enterprise proof strip -->
                    <div class="sis-proof">
                        <div class="sis-proof-item">
                            <div class="sis-proof-top">Designed for adoption</div>
                            <div class="sis-proof-sub">Role-based · audit-ready · mobile-first</div>
                        </div>
                        <div class="sis-proof-item">
                            <div class="sis-proof-top">Built to integrate</div>
                            <div class="sis-proof-sub">UNS thinking · clean interfaces · scalable models</div>
                        </div>
                        <div class="sis-proof-item">
                            <div class="sis-proof-top">Pilot → scale</div>
                            <div class="sis-proof-sub">Start small, prove value, expand fast</div>
                        </div>
                    </div>
                </div>

                <div>
                    <!-- Right-side "enterprise console" -->
                    <div class="glass-card">
                    <div class="glass-card-label">SENTINEL CONTEXT · EXAMPLE</div>

                        <div class="sis-console">
                            <div class="sis-console-row">
                                <span class="sis-dot ok"></span>
                                <div class="sis-console-main">
                                    <div class="sis-console-title">Operational systems — CONNECTED</div>
                                    <div class="sis-console-sub">OT + enterprise sources available</div>
                                </div>
                                <div class="sis-console-pill">CONNECTED</div>
                            </div>

                            <div class="sis-console-row">
                                <span class="sis-dot warn"></span>
                                <div class="sis-console-main">
                                    <div class="sis-console-title">Manufacturing context — RESOLVED</div>
                                    <div class="sis-console-sub">Equipment + signals + production relationships</div>
                                </div>
                                <div class="sis-console-pill warn">RESOLVED</div>
                            </div>

                            <div class="sis-console-row">
                                <span class="sis-dot info"></span>
                                <div class="sis-console-main">
                                    <div class="sis-console-title">Integration readiness — READY</div>
                                    <div class="sis-console-sub">Context available to applications, analytics &amp; AI</div>
                                </div>
                                <div class="sis-console-pill info">READY</div>
                            </div>
                        </div>

                        <div class="sis-mini-cards">
                            <div class="sis-mini">
                                <div class="sis-mini-label">OT DATA</div>
                                <div class="sis-mini-value">Connected</div>
                            </div>
                            <div class="sis-mini">
                                <div class="sis-mini-label">ERP / MES</div>
                                <div class="sis-mini-value">Context</div>
                            </div>
                            <div class="sis-mini">
                                <div class="sis-mini-label">INTEGRATION</div>
                                <div class="sis-mini-value">Open</div>
                            </div>
                            <div class="sis-mini">
                                <div class="sis-mini-label">AI READINESS</div>
                                <div class="sis-mini-value">Assessed</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Services / four-stage model -->
            <div class="sis-cap-grid">
                <div class="sis-cap-card">
                    <div class="sis-cap-kicker">Assess</div>
                    <div class="sis-cap-title">Industrial AI Readiness &amp; Opportunity Assessment</div>
                    <div class="sis-cap-sub">Evaluate manufacturing problems, existing systems, available data, missing context and practical opportunities. Produce an implementation-ready roadmap.</div>
                </div>
                <div class="sis-cap-card">
                    <div class="sis-cap-kicker">Connect</div>
                    <div class="sis-cap-title">Industrial Data &amp; Context Integration</div>
                    <div class="sis-cap-sub">Connect information from PLC/SCADA, OPC UA, MQTT, historians, MES, ERP, CMMS, databases and APIs. Establish meaningful relationships between equipment, signals, production, maintenance and business context.</div>
                </div>
                <div class="sis-cap-card">
                    <div class="sis-cap-kicker">Solve</div>
                    <div class="sis-cap-title">Applied Industrial Intelligence</div>
                    <div class="sis-cap-sub">Develop focused solutions for reliability, production, quality, scheduling and operational decision support. Apply analytics and AI where evidence and business value justify them.</div>
                </div>
                <div class="sis-cap-card">
                    <div class="sis-cap-kicker">Scale</div>
                    <div class="sis-cap-title">Architecture &amp; Integration Support</div>
                    <div class="sis-cap-sub">Extend successful solutions across equipment, lines and sites while maintaining interoperability and avoiding unnecessary vendor lock-in.</div>
                </div>
            </div>
        </section>
        

        <!-- WHAT WE BUILD -->
        <section class="sis-section">
            <div class="sis-header">
                <div class="sis-hk">What we do</div>
                <h2 class="sis-ht">Practical engineering for manufacturing outcomes.</h2>
                <p class="sis-hs">
                    We help manufacturers connect systems and data, clarify operational context, and apply analytics and AI where it creates measurable value.
                </p>
            </div>

            <div class="sis-cards">
                <div class="sis-card">
                    <h3>Connected industrial information</h3>
                    <p>Bring together information from OT and IT systems so teams and applications can work from consistent, reliable data sources.</p>
                </div>
                <div class="sis-card">
                    <h3>Meaningful manufacturing context</h3>
                    <p>Establish relationships between equipment, signals, production, maintenance and business data so raw information becomes operationally meaningful.</p>
                </div>
                <div class="sis-card">
                    <h3>Focused operational solutions</h3>
                    <p>Deliver targeted engineering and analytics that address specific operational problems — not broad, generic promises.</p>
                </div>
                <div class="sis-card">
                    <h3>Architecture that can scale</h3>
                    <p>Provide interoperable patterns and integration practices that extend successful work across lines and sites.</p>
                </div>
            </div>
        </section>

        <!-- HOW WE BUILD / AUTHORITY -->
        <section class="sis-section">
            <div class="sis-header">
                <div class="sis-hk">How we build</div>
                <h2 class="sis-ht">Standards-driven architecture for scale.</h2>
                <p class="sis-hs">
                    We apply industrial information modeling, Unified Namespace principles and ISA-95 concepts to keep data in context and integrations manageable as you scale.
                </p>
            </div>

            <div class="sis-cards">
                <div class="sis-card">
                    <h3>Standards-driven architecture</h3>
                    <p>We apply modeling and namespace principles to keep data in-context and integrations manageable as you scale.</p>
                </div>
                <div class="sis-card">
                    <h3>Shared operational truth</h3>
                    <p>Teams and systems align around the same context to reduce blind spots and improve decision making.</p>
                </div>
                <div class="sis-card">
                    <h3>Start small, prove value</h3>
                    <p>Deliver a focused proof of value, then expand scope and reach based on evidence and measurable outcomes.</p>
                </div>
                <div class="sis-card">
                    <h3>Engineering approach</h3>
                    <p><a asp-controller="Home" asp-action="Platform">Read about our approach →</a></p>
                </div>
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <script>
        // Track scroll depth
        let scrollTracked = { '25': false, '50': false, '75': false, '90': false };

        window.addEventListener('scroll', function () {
            let scrollPercent = (window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100;

            if (scrollPercent >= 25 && !scrollTracked['25']) { gtag('event', 'scroll_depth', { 'percent': '25', 'page': 'homepage' }); scrollTracked['25'] = true; }
            if (scrollPercent >= 50 && !scrollTracked['50']) { gtag('event', 'scroll_depth', { 'percent': '50', 'page': 'homepage' }); scrollTracked['50'] = true; }
            if (scrollPercent >= 75 && !scrollTracked['75']) { gtag('event', 'scroll_depth', { 'percent': '75', 'page': 'homepage' }); scrollTracked['75'] = true; }
            if (scrollPercent >= 90 && !scrollTracked['90']) { gtag('event', 'scroll_depth', { 'percent': '90', 'page': 'homepage' }); scrollTracked['90'] = true; }
        });
    </script>
}