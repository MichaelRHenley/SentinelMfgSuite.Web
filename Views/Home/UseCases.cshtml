@{
    ViewData["Title"] = "Use Cases · Sentinel AI Systems";
}

@section Styles {
    <style>
        body {
            background: radial-gradient(circle at top left, #131b3a 0, #050713 35%, #050b16 100%);
            color: #f4f7ff;
        }

            body::before {
                content: none !important;
                display: none !important;
            }

        .sentinel-section {
            padding: 3.5rem 0;
        }

        .sentinel-kicker {
            letter-spacing: .12em;
            text-transform: uppercase;
            font-size: .8rem;
            font-weight: 650;
            color: #7ea8ff;
            margin-bottom: .6rem;
        }

        .sentinel-hero-title {
            font-size: clamp(2.2rem, 2.6vw + 1.4rem, 3.2rem);
            font-weight: 750;
            line-height: 1.1;
        }

        .sentinel-hero-sub {
            color: rgba(219,229,255,.78);
            font-size: 1.05rem;
        }

        .sentinel-muted {
            color: rgba(219,229,255,.70);
        }

        .glass-card {
            background: radial-gradient(circle at top left, rgba(77,184,255,.14), rgba(4,8,26,.92));
            border-radius: 1.5rem;
            padding: 1.5rem;
            border: 1px solid rgba(130,189,255,.35);
            box-shadow: 0 0 26px rgba(36,112,212,.45);
            backdrop-filter: blur(18px);
        }

        .glass-card--soft {
            background: radial-gradient(circle at top left, rgba(14,20,54,.70), rgba(4,7,22,.96));
            border-radius: 1.25rem;
            border: 1px solid rgba(103,146,235,.26);
            box-shadow: 0 0 20px rgba(20,73,185,.32);
            backdrop-filter: blur(14px);
        }

        .glass-label {
            font-size: .75rem;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: #8fb6ff;
            margin-bottom: .75rem;
        }

        .sentinel-tag {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .18rem .65rem;
            border-radius: 999px;
            font-size: .72rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            background: rgba(118,164,255,.12);
            border: 1px solid rgba(132,170,255,.30);
            color: #a9c4ff;
        }

        .sentinel-pill-stat {
            display: inline-flex;
            align-items: baseline;
            gap: .25rem;
            padding: .28rem .75rem;
            border-radius: 999px;
            border: 1px solid rgba(123,186,255,.35);
            font-size: .82rem;
            color: #dbe7ff;
            background: rgba(12,24,68,.75);
        }

        .sentinel-list {
            margin: .6rem 0 0;
            padding-left: 1.05rem;
            color: rgba(219,229,255,.75);
        }

            .sentinel-list li {
                margin: .25rem 0;
            }

        .uc-grid {
            display: grid;
            grid-template-columns: repeat(12, minmax(0,1fr));
            gap: 1rem;
        }

        .uc-col-4 {
            grid-column: span 4;
        }
        @@media (max-width: 1200px) {
            .uc-col-4

        {
            grid-column: span 6;
        }

        }
        @@media (max-width: 768px) {
            .uc-col-4

        {
            grid-column: span 12;
        }

        }

        .btn-sentinel-primary {
            border-radius: 999px;
            padding: .75rem 1.6rem;
            font-weight: 650;
            border: none;
            background: radial-gradient(circle at top left, #4ef0ff 0, #2d8cff 30%, #1742ff 100%);
            color: #050713;
            text-decoration: none;
            box-shadow: 0 0 18px rgba(77,184,255,.55);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-sentinel-primary:hover {
                filter: brightness(1.05);
                box-shadow: 0 0 24px rgba(77,184,255,.85);
                color: #020308;
            }

        .btn-sentinel-ghost {
            border-radius: 999px;
            padding: .75rem 1.45rem;
            font-weight: 560;
            border: 1px solid rgba(132,170,255,.55);
            background: rgba(4,10,32,.55);
            color: #d3deff;
            text-decoration: none;
            backdrop-filter: blur(14px);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-sentinel-ghost:hover {
                background: rgba(12,24,66,.85);
                color: #fff;
            }
    </style>
}

<main class="sentinel-main">

    <!-- HERO -->
    <section class="sentinel-section" style="padding-top:4.5rem;">
        <div class="container-xl">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <div class="sentinel-kicker">Use cases</div>
                    <h1 class="sentinel-hero-title mb-3">Practical problems we help manufacturers solve</h1>
                    <p class="sentinel-hero-sub mb-3">
                        Sentinel helps manufacturers connect OT and IT, contextualize industrial data, and deliver focused engineering work
                        that creates measurable operational improvements. Below are common categories where we deliver value.
                    </p>
                    <p class="sentinel-muted mb-0">
                        Sentinel addresses these challenges through assessment, systems integration, contextualized industrial data, applied analytics and focused engineering.
                    </p>
                </div>

                <div class="col-lg-5">
                    <div class="glass-card h-100">
                        <div class="glass-label">HOW SENTINEL APPROACHES A USE CASE</div>

                        <p class="sentinel-muted mb-3">Start with the problem — not the technology. A useful industrial solution begins by understanding the operational problem, the systems already in place, the available data and the context needed to make that data meaningful.</p>

                        <div class="row g-3 mt-3">
                            <div class="col-12">
                                <div class="d-flex gap-3">
                                    <div style="flex:1;">
                                        <div style="font-weight:700;">Understand</div>
                                        <div class="sentinel-muted" style="font-size:.95rem;">Define the operational problem and measurable outcome.</div>
                                    </div>
                                    <div style="flex:1;">
                                        <div style="font-weight:700;">Contextualize</div>
                                        <div class="sentinel-muted" style="font-size:.95rem;">Connect the relevant equipment, signals, production and business information.</div>
                                    </div>
                                    <div style="flex:1;">
                                        <div style="font-weight:700;">Apply</div>
                                        <div class="sentinel-muted" style="font-size:.95rem;">Use engineering, analytics or AI according to what the evidence justifies.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- GRID -->
    <section class="sentinel-section" style="padding-top:0;">
        <div class="container-xl">
            <div class="uc-grid">

                <div class="uc-col-4">
                    <div class="glass-card--soft h-100 p-4">
                        <div class="sentinel-tag mb-2">Reliability &amp; Maintenance</div>
                        <div style="font-size:1.08rem;font-weight:750;margin-bottom:.35rem;">From reactive firefighting to predictable uptime</div>
                        <p class="sentinel-muted mb-2">
                            Reduce unplanned downtime by bringing together maintenance workflows, asset context, and signal data so teams can act faster and more consistently.
                        </p>
                        <div class="glass-label mb-1">How Sentinel helps</div>
                        <ul class="sentinel-list mb-2">
                            <li>Sentinel can help align asset hierarchies, work orders, and maintenance workflows</li>
                            <li>Potential applications include clearer ownership, status and response flows for incidents</li>
                            <li>Engineering may include using historical signals to prioritise reliability work</li>
                        </ul>
                        <div class="glass-label mb-1">What we deliver</div>
                        <p class="sentinel-muted mb-0">Assessment, integration, and targeted engineering to reduce mean time to repair and improve maintenance efficiency.</p>
                    </div>
                </div>

                <div class="uc-col-4">
                    <div class="glass-card--soft h-100 p-4">
                        <div class="sentinel-tag mb-2">Production &amp; Throughput</div>
                        <div style="font-size:1.08rem;font-weight:750;margin-bottom:.35rem;">Visibility into throughput and bottlenecks</div>
                        <p class="sentinel-muted mb-2">
                            Provide operations with live views of machine state, stoppages and production rates so teams can identify and remove constraints.
                        </p>
                        <div class="glass-label mb-1">How Sentinel helps</div>
                        <ul class="sentinel-list mb-2">
                            <li>Sentinel can help provide machine and line status aligned to production context</li>
                            <li>Potential applications include standardized downtime reasons and rollups for continuous improvement</li>
                            <li>Engineering may include targeted bottleneck identification and interventions</li>
                        </ul>
                        <div class="glass-label mb-1">What we deliver</div>
                        <p class="sentinel-muted mb-0">Integration and contextual dashboards that help operations focus on the right constraints.</p>
                    </div>
                </div>

                <div class="uc-col-4">
                    <div class="glass-card--soft h-100 p-4">
                        <div class="sentinel-tag mb-2">Quality</div>
                        <div style="font-size:1.08rem;font-weight:750;margin-bottom:.35rem;">Connect quality events to assets and processes</div>
                        <p class="sentinel-muted mb-2">
                            Tie quality holds and defect records to the same assets and lines used for maintenance and production to understand root causes.
                        </p>
                        <div class="glass-label mb-1">How Sentinel helps</div>
                        <ul class="sentinel-list mb-2">
                            <li>Sentinel can help capture quality events against assets and production context</li>
                            <li>Potential applications include overlaying quality, safety and downtime histories for root-cause analysis</li>
                            <li>Engineering may include identifying hotspots where defects cluster</li>
                        </ul>
                        <div class="glass-label mb-1">What we deliver</div>
                        <p class="sentinel-muted mb-0">A clearer connection between quality issues and the equipment and processes that influence them.</p>
                    </div>
                </div>

                <div class="uc-col-4">
                    <div class="glass-card--soft h-100 p-4">
                        <div class="sentinel-tag mb-2">Scheduling &amp; Workforce Context</div>
                        <div style="font-size:1.08rem;font-weight:750;margin-bottom:.35rem;">Align tasks, shifts and context for better execution</div>
                        <p class="sentinel-muted mb-2">
                            Connect work assignments, shift context and equipment status so teams have the right information at the right time.
                        </p>
                        <div class="glass-label mb-1">How Sentinel helps</div>
                        <ul class="sentinel-list mb-2">
                            <li>Sentinel can help provide shift-aware views of work and production state</li>
                            <li>Potential applications include assigning tasks with clear context and history</li>
                            <li>Engineering may include features to support handovers between shifts and roles</li>
                        </ul>
                        <div class="glass-label mb-1">What we deliver</div>
                        <p class="sentinel-muted mb-0">Improved handoffs, clearer ownership, and more consistent execution.</p>
                    </div>
                </div>

                <div class="uc-col-4">
                    <div class="glass-card--soft h-100 p-4">
                        <div class="sentinel-tag mb-2">Operational Visibility</div>
                        <div style="font-size:1.08rem;font-weight:750;margin-bottom:.35rem;">Live context for operations and leadership</div>
                        <p class="sentinel-muted mb-2">
                            Consolidate signals, events and work status into role-based views so teams and leaders can act on current conditions.
                        </p>
                        <div class="glass-label mb-1">How Sentinel helps</div>
                        <ul class="sentinel-list mb-2">
                            <li>Sentinel can help provide role-specific dashboards and alerts</li>
                            <li>Potential applications include rollups by area, line, and shift to support decision making</li>
                            <li>Engineering may include contextual summaries tailored to roles</li>
                        </ul>
                        <div class="glass-label mb-1">What we deliver</div>
                        <p class="sentinel-muted mb-0">Improved situational awareness and faster operational responses.</p>
                    </div>
                </div>

                <div class="uc-col-4">
                    <div class="glass-card--soft h-100 p-4">
                        <div class="sentinel-tag mb-2">AI-Assisted Decision Support</div>
                        <div style="font-size:1.08rem;font-weight:750;margin-bottom:.35rem;">Analytics and AI that help people make better decisions</div>
                        <p class="sentinel-muted mb-2">
                            Use analytics and AI where evidence supports value: highlight recurring issues, prioritize interventions, and surface likely causes for human review.
                        </p>
                        <div class="glass-label mb-1">How Sentinel helps</div>
                        <ul class="sentinel-list mb-2">
                            <li>Sentinel can help provide evidence-driven recommendations for maintenance and operations</li>
                            <li>Potential applications include summaries and trend detection to focus continuous improvement efforts</li>
                            <li>Engineering may include human-in-the-loop workflows to validate and act on insights</li>
                        </ul>
                        <div class="glass-label mb-1">What we deliver</div>
                        <p class="sentinel-muted mb-0">Practical analytics that augment operator and supervisor decision making — only where it creates demonstrable value.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="sentinel-section" style="padding-top:0;">
        <div class="container-xl">
                    <div class="glass-card">
                        <div class="row align-items-center g-3">
                            <div class="col-lg-8">
                                <div class="glass-label">Talk to us</div>
                                <div style="font-size:1.25rem;font-weight:750;margin-bottom:.35rem;">
                                    Wondering how Sentinel would fit your site?
                                </div>
                                <p class="sentinel-muted mb-0">
                                    Share your footprint, current tools, and what’s hurting the most. We’ll map practical next steps and the services that fit your needs.
                                </p>
                            </div>
                            <div class="col-lg-4 d-flex justify-content-lg-end">
                                <div class="d-flex flex-wrap gap-2">
                                    <a asp-controller="Home" asp-action="Contact" asp-route-topic="industrial-ai-readiness" class="btn-sentinel-primary">
                                        Discuss readiness &amp; opportunities
                                    </a>
                                    <a asp-controller="Home" asp-action="Contact" asp-route-topic="technology-partnership" class="btn-sentinel-ghost">
                                        Technology &amp; integration partners
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
        </div>
    </section>

</main>