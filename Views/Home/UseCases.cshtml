@{
    ViewData["Title"] = "Use Cases · Sentinel Manufacturing Core Suite";
}

@section Styles {
    <style>
        body {
            background: radial-gradient(circle at top left, #131b3a 0, #050713 35%, #050b16 100%);
            color: #f4f7ff;
        }

            body::before {
                content: none !important;
                display: none !important;
            }

        .sentinel-section {
            padding: 3.5rem 0;
        }

        .sentinel-kicker {
            letter-spacing: .12em;
            text-transform: uppercase;
            font-size: .8rem;
            font-weight: 650;
            color: #7ea8ff;
            margin-bottom: .6rem;
        }

        .sentinel-hero-title {
            font-size: clamp(2.2rem, 2.6vw + 1.4rem, 3.2rem);
            font-weight: 750;
            line-height: 1.1;
        }

        .sentinel-hero-sub {
            color: rgba(219,229,255,.78);
            font-size: 1.05rem;
        }

        .sentinel-muted {
            color: rgba(219,229,255,.70);
        }

        .glass-card {
            background: radial-gradient(circle at top left, rgba(77,184,255,.14), rgba(4,8,26,.92));
            border-radius: 1.5rem;
            padding: 1.5rem;
            border: 1px solid rgba(130,189,255,.35);
            box-shadow: 0 0 26px rgba(36,112,212,.45);
            backdrop-filter: blur(18px);
        }

        .glass-card--soft {
            background: radial-gradient(circle at top left, rgba(14,20,54,.70), rgba(4,7,22,.96));
            border-radius: 1.25rem;
            border: 1px solid rgba(103,146,235,.26);
            box-shadow: 0 0 20px rgba(20,73,185,.32);
            backdrop-filter: blur(14px);
        }

        .glass-label {
            font-size: .75rem;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: #8fb6ff;
            margin-bottom: .75rem;
        }

        .sentinel-tag {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .18rem .65rem;
            border-radius: 999px;
            font-size: .72rem;
            letter-spacing: .12em;
            text-transform: uppercase;
            background: rgba(118,164,255,.12);
            border: 1px solid rgba(132,170,255,.30);
            color: #a9c4ff;
        }

        .sentinel-pill-stat {
            display: inline-flex;
            align-items: baseline;
            gap: .25rem;
            padding: .28rem .75rem;
            border-radius: 999px;
            border: 1px solid rgba(123,186,255,.35);
            font-size: .82rem;
            color: #dbe7ff;
            background: rgba(12,24,68,.75);
        }

        .sentinel-list {
            margin: .6rem 0 0;
            padding-left: 1.05rem;
            color: rgba(219,229,255,.75);
        }

            .sentinel-list li {
                margin: .25rem 0;
            }

        .uc-grid {
            display: grid;
            grid-template-columns: repeat(12, minmax(0,1fr));
            gap: 1rem;
        }

        .uc-col-4 {
            grid-column: span 4;
        }
        @@media (max-width: 1200px) {
            .uc-col-4

        {
            grid-column: span 6;
        }

        }
        @@media (max-width: 768px) {
            .uc-col-4

        {
            grid-column: span 12;
        }

        }

        .btn-sentinel-primary {
            border-radius: 999px;
            padding: .75rem 1.6rem;
            font-weight: 650;
            border: none;
            background: radial-gradient(circle at top left, #4ef0ff 0, #2d8cff 30%, #1742ff 100%);
            color: #050713;
            text-decoration: none;
            box-shadow: 0 0 18px rgba(77,184,255,.55);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-sentinel-primary:hover {
                filter: brightness(1.05);
                box-shadow: 0 0 24px rgba(77,184,255,.85);
                color: #020308;
            }

        .btn-sentinel-ghost {
            border-radius: 999px;
            padding: .75rem 1.45rem;
            font-weight: 560;
            border: 1px solid rgba(132,170,255,.55);
            background: rgba(4,10,32,.55);
            color: #d3deff;
            text-decoration: none;
            backdrop-filter: blur(14px);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-sentinel-ghost:hover {
                background: rgba(12,24,66,.85);
                color: #fff;
            }
    </style>
}

<main class="sentinel-main">

    <!-- HERO -->
    <section class="sentinel-section" style="padding-top:4.5rem;">
        <div class="container-xl">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <div class="sentinel-kicker">Use cases</div>
                    <h1 class="sentinel-hero-title mb-3">Real-world use cases. Real factory impact.</h1>
                    <p class="sentinel-hero-sub mb-3">
                        Sentinel Manufacturing Core Suite™ is built around the day-to-day realities of running a plant —
                        EM calls, downtime coding, missing parts, and leadership asking, “What’s really going on out there?”
                    </p>
                    <p class="sentinel-muted mb-0">
                        Below are a few of the most common ways plants use Sentinel to reduce downtime, standardize operations,
                        and give everyone the same live source of truth.
                    </p>
                </div>

                <div class="col-lg-5">
                    <div class="glass-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="sentinel-tag">Live example</span>
                            <span class="sentinel-tag" style="border-color:rgba(79,225,255,.35); color:rgba(196,246,255,.95); background:rgba(7,40,58,.55);">
                                EM · production · leadership
                            </span>
                        </div>

                        <div style="font-size:1.15rem;font-weight:750;margin-bottom:.45rem;">
                            From radio chaos to one live EM board.
                        </div>

                        <p class="sentinel-muted mb-3">
                            Operators log EMs directly into Sentinel, dispatchers see a plant-wide queue, and responders
                            work from a mobile view with clear ownership, status, and comments.
                        </p>

                        <ul class="sentinel-list mb-3">
                            <li>Less time lost to missed calls and “who has it?” confusion</li>
                            <li>Clearer priorities for the maintenance team mid-shift</li>
                            <li>A timeline of every EM for follow-up and improvement work</li>
                        </ul>

                        <span class="sentinel-pill-stat">
                            <span style="font-weight:700;">Goal:</span>
                            cut EM response time and “mystery downtime” across the plant
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- GRID -->
    <section class="sentinel-section" style="padding-top:0;">
        <div class="container-xl">
            <div class="uc-grid">

                <div class="uc-col-4">
                    <div class="glass-card--soft h-100 p-4">
                        <div class="sentinel-tag mb-2">Emergency Maintenance</div>
                        <div style="font-size:1.08rem;font-weight:750;margin-bottom:.35rem;">EM chaos → live responder workflow</div>
                        <p class="sentinel-muted mb-2">
                            Operators call radios, send emails, or chase people down on the floor. Maintenance teams juggle sticky notes and guess what to do first.
                        </p>
                        <div class="glass-label mb-1">How Sentinel helps</div>
                        <ul class="sentinel-list mb-2">
                            <li>Plant-wide EM board with ownership, status, and SLAs</li>
                            <li>Mobile responder view with comments and photos</li>
                            <li>Live status for operations and leadership</li>
                        </ul>
                        <div class="glass-label mb-1">Result</div>
                        <p class="sentinel-muted mb-0">Fewer missed calls, faster responses, less back-and-forth during critical events.</p>
                    </div>
                </div>

                <div class="uc-col-4">
                    <div class="glass-card--soft h-100 p-4">
                        <div class="sentinel-tag mb-2">Downtime &amp; Production</div>
                        <div style="font-size:1.08rem;font-weight:750;margin-bottom:.35rem;">Messy downtime data → standard reasons and rollups</div>
                        <p class="sentinel-muted mb-2">
                            Downtime coding is inconsistent, lives in spreadsheets, or is painful enough that people skip it. Root-cause efforts stall.
                        </p>
                        <div class="glass-label mb-1">How Sentinel helps</div>
                        <ul class="sentinel-list mb-2">
                            <li>Guided downtime coding tied to line, asset, and shift</li>
                            <li>Live view of machines running, stopped, starved/blocked</li>
                            <li>Rollups by loss type, area, or product family</li>
                        </ul>
                        <div class="glass-label mb-1">Result</div>
                        <p class="sentinel-muted mb-0">One version of the truth for where time is lost — and a clean starting point for CI work.</p>
                    </div>
                </div>

                <div class="uc-col-4">
                    <div class="glass-card--soft h-100 p-4">
                        <div class="sentinel-tag mb-2">Parts &amp; BOM</div>
                        <div style="font-size:1.08rem;font-weight:750;margin-bottom:.35rem;">Hunting for parts → one place to see what’s needed</div>
                        <p class="sentinel-muted mb-2">
                            Techs bounce between ERP, spreadsheets, and tribal knowledge to find the right part. Repairs stall while everyone figures out “what goes where”.
                        </p>
                        <div class="glass-label mb-1">How Sentinel helps</div>
                        <ul class="sentinel-list mb-2">
                            <li>Smart search across SKUs, descriptions, and BOMs</li>
                            <li>Equipment BOM + on-hand inventory in one view</li>
                            <li>Usage history and likely-to-need suggestions</li>
                        </ul>
                        <div class="glass-label mb-1">Result</div>
                        <p class="sentinel-muted mb-0">Faster repairs, better first-time-fix, less frustration chasing part numbers.</p>
                    </div>
                </div>

                <div class="uc-col-4">
                    <div class="glass-card--soft h-100 p-4">
                        <div class="sentinel-tag mb-2">Quality &amp; Safety</div>
                        <div style="font-size:1.08rem;font-weight:750;margin-bottom:.35rem;">Isolated logs → events tied to assets</div>
                        <p class="sentinel-muted mb-2">
                            Quality holds and safety incidents live in separate systems. It’s hard to see how they connect to downtime or specific assets.
                        </p>
                        <div class="glass-label mb-1">How Sentinel helps</div>
                        <ul class="sentinel-list mb-2">
                            <li>Capture holds/defects against the same assets and lines</li>
                            <li>Overlay quality, safety, and EM history</li>
                            <li>Spot hot spots where issues cluster</li>
                        </ul>
                        <div class="glass-label mb-1">Result</div>
                        <p class="sentinel-muted mb-0">Clearer link between quality, safety, and performance for the same equipment.</p>
                    </div>
                </div>

                <div class="uc-col-4">
                    <div class="glass-card--soft h-100 p-4">
                        <div class="sentinel-tag mb-2">Leadership</div>
                        <div style="font-size:1.08rem;font-weight:750;margin-bottom:.35rem;">Weekly slide decks → live view for leaders</div>
                        <p class="sentinel-muted mb-2">
                            Leaders depend on manually built reports pulled from different systems. By the time they’re assembled, the data is stale.
                        </p>
                        <div class="glass-label mb-1">How Sentinel helps</div>
                        <ul class="sentinel-list mb-2">
                            <li>Role-based dashboards for maintenance, ops, leadership</li>
                            <li>Live EM/PM health, downtime, throughput</li>
                            <li>Trends over days/weeks/months without Excel</li>
                        </ul>
                        <div class="glass-label mb-1">Result</div>
                        <p class="sentinel-muted mb-0">Decisions based on live plant signals, not backward-looking decks.</p>
                    </div>
                </div>

                <div class="uc-col-4">
                    <div class="glass-card--soft h-100 p-4">
                        <div class="sentinel-tag mb-2">AI &amp; Insights</div>
                        <div style="font-size:1.08rem;font-weight:750;margin-bottom:.35rem;">Hidden patterns → practical recommendations</div>
                        <p class="sentinel-muted mb-2">
                            Repeat offenders, weak PM coverage, and emerging issues aren’t obvious until they become major downtime events.
                        </p>
                        <div class="glass-label mb-1">How Sentinel helps</div>
                        <ul class="sentinel-list mb-2">
                            <li>Highlight recurring EMs and high-risk assets</li>
                            <li>Recommend PM adjustments based on history</li>
                            <li>Answer “Where are we losing the most time this week?”</li>
                        </ul>
                        <div class="glass-label mb-1">Result</div>
                        <p class="sentinel-muted mb-0">Shift from reactive firefighting to proactive, data-backed improvement.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="sentinel-section" style="padding-top:0;">
        <div class="container-xl">
            <div class="glass-card">
                <div class="row align-items-center g-3">
                    <div class="col-lg-8">
                        <div class="glass-label">Talk to us</div>
                        <div style="font-size:1.25rem;font-weight:750;margin-bottom:.35rem;">
                            Wondering how Sentinel would fit your site?
                        </div>
                        <p class="sentinel-muted mb-0">
                            Share your footprint, current tools, and what’s hurting the most. We’ll map Sentinel use cases to your reality — not a generic slide deck.
                        </p>
                    </div>
                    <div class="col-lg-4 d-flex justify-content-lg-end">
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Home" asp-action="Contact" asp-route-topic="site-conversation" class="btn-sentinel-primary">
                                Talk to us about your site
                            </a>
                            <a asp-controller="Home" asp-action="Pricing" class="btn-sentinel-ghost">
                                Explore tiers &amp; pricing
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>