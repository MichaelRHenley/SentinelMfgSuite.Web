@{
    ViewData["Title"] = "Industrial Data & AI Readiness Assessment";
    ViewData["Description"] = "Industrial Data & AI Readiness Assessment — a practical remote assessment for one manufacturing site. Fixed price $2,500 CAD plus taxes. Includes discovery, data-quality analysis, AI readiness review, roadmap and a findings meeting.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="sentinel-main">
    <section class="sentinel-hero py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8 order-2 order-lg-1">
                    <h1 class="display-6 fw-bold mb-2">Industrial Data &amp; AI Readiness Assessment</h1>
                    <p class="lead text-secondary mb-3">A practical, outcomes-focused remote assessment for one manufacturing site that identifies the data, integration and roadmap you need to move toward applied industrial AI.</p>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="fs-4 fw-semibold">Price</div>
                        <div class="badge bg-info text-dark fs-5 py-2 px-3">$2,500 CAD</div>
                        <div class="text-secondary small">plus applicable taxes • remote • up to 5 data sources</div>
                    </div>

                    <p class="mb-4 text-secondary">This assessment is scoped to diagnostics and recommendations. It does not include implementation, on-site visits, or configuration work.</p>

                    <a href="/Home/Contact?topic=industrial-ai-readiness" class="btn-sentinel-primary btn-lg">Request an assessment</a>
                </div>

                <div class="col-lg-4 order-1 order-lg-2 mb-4 mb-lg-0">
                    <div class="card bg-dark bg-opacity-75 border-0 text-light rounded-4">
                        <div class="card-body">
                            <h6 class="text-uppercase text-secondary">Engagement at a glance</h6>
                            <p class="mb-1"><strong>Price:</strong> $2,500 CAD + taxes</p>
                            <p class="mb-1"><strong>Scope:</strong> Remote, 1 site, up to 5 data sources</p>
                            <p class="mb-0 text-secondary small">Includes written findings and a one-hour review meeting.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="container py-4">
        <h2 class="h5 fw-semibold mb-3">Deliverables</h2>
        <div class="row g-3">
            <div class="col-sm-6 col-lg-4">
                <div class="card sentinel-card h-100">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold">Discovery &amp; inventory</h3>
                        <p class="small text-secondary mb-0">We document systems, data sources, integrations and stakeholders relevant to the scoped problem.</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="card sentinel-card h-100">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold">Integration &amp; data-quality gap analysis</h3>
                        <p class="small text-secondary mb-0">Assess ingestion paths, data completeness, consistency and immediate gaps to address.</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="card sentinel-card h-100">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold">AI readiness review</h3>
                        <p class="small text-secondary mb-0">Evaluate data suitability, labelling, sampling and modelling considerations for practical AI use cases.</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="card sentinel-card h-100">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold">Prioritized roadmap</h3>
                        <p class="small text-secondary mb-0">Implementation-ready, prioritized steps that balance risk, value and effort.</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="card sentinel-card h-100">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold">Written findings report</h3>
                        <p class="small text-secondary mb-0">Concise deliverable summarizing observations, evidence and recommended next steps.</p>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="card sentinel-card h-100">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold">Findings meeting</h3>
                        <p class="small text-secondary mb-0">A one-hour remote session to review findings and confirm priorities.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="container py-4">
        <div class="row">
            <div class="col-lg-8">
                <h2 class="h5 fw-semibold">Timeline</h2>
                <p class="text-secondary">Target delivery: 5–10 business days after we receive required information (data extracts, system inventories and stakeholder inputs).</p>

                <h2 class="h5 fw-semibold mt-4">What's excluded</h2>
                <ul class="text-secondary">
                    <li>On-site visits and travel</li>
                    <li>Implementation, system configuration, or engineering delivery</li>
                    <li>Live production-system access — we request exported data or readonly extracts</li>
                </ul>

                <p class="text-secondary mt-3">This engagement is an assessment only. It identifies opportunities and practical recommendations; it does not guarantee AI readiness or include implementation work. Any additional work will be scoped and priced separately.</p>
            </div>
        </div>
    </section>
</main>

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
}
