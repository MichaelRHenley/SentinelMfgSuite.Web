@{
    ViewData["Title"] = "Resources · Sentinel AI Systems";
}

@section Styles {
    <style>
        body {
            background: radial-gradient(circle at top left, #131b3a 0, #050713 35%, #050b16 100%);
            color: #f4f7ff;
        }

            body::before {
                content: none !important;
                display: none !important;
            }

        .sentinel-section {
            padding: 3.5rem 0;
        }

        .sentinel-kicker {
            letter-spacing: .12em;
            text-transform: uppercase;
            font-size: .8rem;
            font-weight: 650;
            color: #7ea8ff;
            margin-bottom: .6rem;
        }

        .sentinel-title {
            font-size: clamp(2rem, 2.2vw + 1.2rem, 2.8rem);
            font-weight: 750;
            line-height: 1.12;
        }

        .sentinel-lead {
            color: rgba(219,229,255,.78);
            font-size: 1.05rem;
        }

        .sentinel-muted {
            color: rgba(219,229,255,.70);
        }

        .glass-card {
            background: radial-gradient(circle at top left, rgba(77,184,255,.14), rgba(4,8,26,.92));
            border-radius: 1.5rem;
            padding: 1.5rem;
            border: 1px solid rgba(130,189,255,.35);
            box-shadow: 0 0 26px rgba(36,112,212,.45);
            backdrop-filter: blur(18px);
        }

        .glass-card--soft {
            background: radial-gradient(circle at top left, rgba(14,20,54,.70), rgba(4,7,22,.96));
            border: 1px solid rgba(103,146,235,.28);
            box-shadow: 0 0 20px rgba(20,73,185,.35);
        }

        .glass-label {
            font-size: .75rem;
            letter-spacing: .18em;
            text-transform: uppercase;
            color: #8fb6ff;
            margin-bottom: .75rem;
        }

        .sentinel-list {
            margin: .6rem 0 0;
            padding-left: 1.05rem;
            color: rgba(219,229,255,.75);
        }

            .sentinel-list li {
                margin: .25rem 0;
            }

        .btn-sentinel-primary {
            border-radius: 999px;
            padding: .75rem 1.6rem;
            font-weight: 650;
            border: none;
            color: #050713;
            text-decoration: none;
            background: radial-gradient(circle at top left, #4ef0ff 0, #2d8cff 30%, #1742ff 100%);
            box-shadow: 0 0 18px rgba(77,184,255,.55);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-sentinel-primary:hover {
                filter: brightness(1.05);
                box-shadow: 0 0 24px rgba(77,184,255,.85);
                color: #020308;
            }

        .btn-sentinel-ghost {
            border-radius: 999px;
            padding: .75rem 1.45rem;
            font-weight: 560;
            border: 1px solid rgba(132,170,255,.55);
            background: rgba(4,10,32,.55);
            color: #d3deff;
            text-decoration: none;
            backdrop-filter: blur(14px);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn-sentinel-ghost:hover {
                background: rgba(12,24,66,.85);
                color: #fff;
            }

        .resource-grid {
            display: grid;
            grid-template-columns: repeat(12, minmax(0,1fr));
            gap: 1rem;
        }

        .rcol-3 {
            grid-column: span 3;
        }
        @@media (max-width: 1200px) {
            .rcol-3

        {
            grid-column: span 6;
        }

        }
        @@media (max-width: 768px) {
            .rcol-3

        {
            grid-column: span 12;
        }

        }
    </style>
}

<main class="sentinel-main">
    <section class="sentinel-section" style="padding-top:4.5rem;">
        <div class="container-xl">
            <div class="row g-4 align-items-center">
                <div class="col-lg-7">
                    <div class="sentinel-kicker">Resources</div>
                    <h1 class="sentinel-title mb-3">Resources & engineering guidance</h1>
                    <p class="sentinel-lead mb-3">
                        Practical guidance, short playbooks, and technical notes to support industrial data integration and rollout planning.
                        Use these materials to help teams get started and to support engineering decisions about integration and architecture.
                    </p>
                    <p class="sentinel-muted mb-0">
                        If you’d like tailored technical documentation or integration notes for your environment, contact us and we’ll arrange a discussion with our engineering team.
                    </p>
                </div>

                <div class="col-lg-5">
                    <div class="glass-card h-100">
                        <div class="glass-label">Example questions to ask Sentinel</div>
                        <ul class="sentinel-list">
                            <li>“How do I add a part to an asset?”</li>
                            <li>“Show me how to log a new EM from the line.”</li>
                            <li>“How do I add a new downtime reason for Line 3?”</li>
                            <li>“Where can I see a summary of this week’s EMs by area?”</li>
                            <li>“How do I invite a new maintenance tech and set their access?”</li>
                        </ul>
                        <p class="sentinel-muted mb-0 mt-3">
                            As you roll out to more sites, you can extend these Q&amp;A patterns with your own
                            playbooks, checklists, and best practices.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="sentinel-section" style="padding-top:0;">
        <div class="container-xl">
            <div class="resource-grid">

                <div class="rcol-3">
                    <div class="glass-card glass-card--soft h-100">
                        <div class="glass-label">In-product help</div>
                        <div style="font-size:1.15rem;font-weight:750;margin-bottom:.45rem;">Guidance and Q&amp;A</div>
                        <p class="sentinel-muted mb-2">
                            Practical in-product guidance can help operators and technicians follow standard workflows. For site-specific guidance, we work with your team to capture playbooks and procedures.
                        </p>
                        <ul class="sentinel-list">
                            <li>Plain-language guidance for common tasks</li>
                            <li>Context-aware pointers to the right workflows</li>
                            <li>Operator checklists and quick-start steps</li>
                        </ul>
                    </div>
                </div>

                <div class="rcol-3">
                    <div class="glass-card glass-card--soft h-100">
                        <div class="glass-label">Rollout</div>
                        <div style="font-size:1.15rem;font-weight:750;margin-bottom:.45rem;">Quick-start guides</div>
                        <p class="sentinel-muted mb-2">
                            Short, role-based guides and templates to help get a site started without large up-front projects.
                        </p>
                        <ul class="sentinel-list">
                            <li>Operator: common logging and incident workflows</li>
                            <li>Technician: triage and close-out steps</li>
                            <li>Supervisor: boards and monitoring practices</li>
                            <li>Admin: mapping sites, areas, and permissions</li>
                        </ul>
                        <p class="sentinel-muted mb-0 mt-3">
                            We keep public resources minimal and focus on tailored guidance during engagements.
                        </p>
                    </div>
                </div>

                <div class="rcol-3">
                    <div class="glass-card glass-card--soft h-100">
                        <div class="glass-label">Templates</div>
                        <div style="font-size:1.15rem;font-weight:750;margin-bottom:.45rem;">Planning templates</div>
                        <p class="sentinel-muted mb-2">
                            Templates and starter structures to help you map site hierarchy, downtime reasons, and rollout tasks.
                        </p>
                        <ul class="sentinel-list">
                            <li>Site / area / line / asset mapping starter</li>
                            <li>Downtime reason tree examples</li>
                            <li>Roles and responsibilities templates for rollout</li>
                        </ul>
                        <p class="sentinel-muted mb-0 mt-3">
                            Contact us if you need these templates adapted for your systems.
                        </p>
                    </div>
                </div>

                <div class="rcol-3">
                    <div class="glass-card glass-card--soft h-100">
                        <div class="glass-label">Technical</div>
                        <div style="font-size:1.15rem;font-weight:750;margin-bottom:.45rem;">Integration &amp; IT notes</div>
                        <p class="sentinel-muted mb-2">
                            High-level guidance for engineering and IT teams about integrating operational signals and systems.
                        </p>
                        <ul class="sentinel-list">
                            <li>Integration patterns for CMMS, ERP, and MES</li>
                            <li>Options for signal collection from historians and PLCs</li>
                            <li>High-level data-in / data-out considerations</li>
                            <li>Security and environment separation principles</li>
                        </ul>
                        <p class="sentinel-muted mb-0 mt-3">
                            For detailed technical documentation, contact us and we will arrange secure transfer of relevant materials.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <section class="sentinel-section" style="padding-top:0;">
        <div class="container-xl">
            <div class="glass-card">
                <div class="row align-items-center g-3">
                    <div class="col-lg-8">
                        <div class="glass-label">Next step</div>
                        <div style="font-size:1.25rem;font-weight:750;margin-bottom:.35rem;">
                            Get practical guidance for your site.
                        </div>
                        <p class="sentinel-muted mb-0">
                            If you need tailored technical notes or help mapping integrations, contact our engineering team to arrange a discussion.
                        </p>
                    </div>
                    <div class="col-lg-4 d-flex justify-content-lg-end">
                            <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Home" asp-action="Contact" asp-route-topic="industrial-data-integration" class="btn-sentinel-primary">
                                Discuss data &amp; integration
                            </a>
                            <a asp-controller="Home" asp-action="Contact" asp-route-topic="technology-partnership" class="btn-sentinel-ghost">
                                Technology &amp; integration partners
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>