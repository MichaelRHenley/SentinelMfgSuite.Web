@{
    ViewData["Title"] = "App";
}

<div class="container py-5">
    <h1 class="display-6">Sentinel Emergency Maintenance Module launching Q2 2026</h1>
    <p class="text-muted">
        The Emergency Maintenance Module is not yet publicly available. We're recruiting 5-10 pilot partners for early access. 
        Join the pilot program or launch list to be notified when access opens.
    </p>

    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Contact" asp-route-topic="pilot-application">
            Apply for Pilot Program
        </a>
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="LaunchList">
            Join the launch list
        </a>
    </div>
</div>
