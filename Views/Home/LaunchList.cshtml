@model SentinelMfgSuite.Web.Models.LaunchListForm
@{
    ViewData["Title"] = "Launch List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="sentinel-page">
    <div class="container py-5">
        <div class="row gy-4">
            <div class="col-lg-7">
                <h1 class="h3 fw-semibold mb-3">
                    Join the Sentinel launch list
                </h1>

                <p class="text-secondary mb-3">
                    Get notified when the <strong>Emergency Maintenance Module launches Q2 2026</strong>. 
                    Early access details, pilot partner opportunities, and founding-customer pricing.
                </p>

                @if (ViewBag.SuccessMessage != null)
                {
                    <div class="alert alert-success rounded-3 py-2 mb-3">
                        @ViewBag.SuccessMessage
                    </div>
                }

                <form asp-action="LaunchList" method="post" id="launchListForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" id="LaunchName" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" id="LaunchEmail" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Company" class="form-label"></label>
                        <input asp-for="Company" class="form-control" id="LaunchCompany" />
                        <span asp-validation-for="Company" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes"
                                  class="form-control"
                                  id="LaunchNotes"
                                  rows="3"
                                  placeholder="Tell us about your plant size, lines, and EM challenges..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <button type="submit"
                            id="joinLaunchListBtn"
                            class="btn-sentinel-primary mt-3"
                            disabled>
                        Join the launch list
                    </button>
                </form>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 rounded-4 bg-dark bg-opacity-75 text-light h-100">
                    <div class="card-body p-4">
                        <h2 class="h6 text-uppercase text-secondary mb-3">
                            What you'll get
                        </h2>
                        <ul class="small text-secondary mb-4">
                            <li>Early notification when EM Module launches Q2 2026</li>
                            <li>Pilot partner program invites (limited to 5-10 spots)</li>
                            <li>50% founding-customer discount for 12 months</li>
                            <li>Behind-the-scenes build updates</li>
                            <li>Opportunity to shape the roadmap</li>
                        </ul>
                        
                        <div class="small text-secondary mt-3 pt-3 border-top border-secondary border-opacity-25">
                            <strong>EM Module first.</strong> Other modules (Planned Maintenance, Production Tracking, Parts Intelligence) launch later in 2026 after EM stabilizes.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
