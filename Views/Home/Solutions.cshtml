@{
    ViewData["Title"] = "Services · Sentinel AI Systems";
}

<main class="sentinel-main solutions-page">
    <section class="pb-5">
        <div class="container-xl">
            <div class="text-center mb-4">
                <p class="sol-kicker mb-2">Services</p>
                <h1 class="display-5 fw-semibold mb-3 sol-title">Assess · Connect · Solve · Scale</h1>
                <p class="lead sol-sub mb-0">Focused engineering services to integrate industrial data, create operational context, and deliver measurable outcomes.</p>
            </div>

            <div class="row g-4 mt-4">
                <div class="col-md-6 col-lg-3">
                    <div class="sol-card h-100">
                        <div class="card-body p-4">
                            <h3 class="h5 fw-semibold mb-2">Assess</h3>
                            <p class="small text-secondary mb-0">Industrial AI Readiness &amp; Opportunity Assessment: a focused entry engagement that evaluates the defined manufacturing problem, inventories existing systems and data, identifies context gaps and practical opportunities, and delivers an implementation-ready roadmap with prioritized next steps.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="sol-card h-100">
                        <div class="card-body p-4">
                            <h3 class="h5 fw-semibold mb-2">Connect</h3>
                            <p class="small text-secondary mb-0">Integration &amp; contextualization deliverables: we connect relevant OT and IT sources, ingest signals and events, and create the operational mappings that relate equipment, production and business data — producing a contextual data model and integration artifacts your teams can use.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="sol-card h-100">
                        <div class="card-body p-4">
                            <h3 class="h5 fw-semibold mb-2">Solve</h3>
                            <p class="small text-secondary mb-0">Focused engineering around a defined operational problem: we design and deliver targeted solutions — analytics, visualizations, integrations or supervised AI — scoped to measurable outcomes and validated with stakeholders before wider rollout.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="sol-card h-100">
                        <div class="card-body p-4">
                            <h3 class="h5 fw-semibold mb-2">Scale</h3>
                            <p class="small text-secondary mb-0">Extend proven solutions across equipment, lines or sites with interoperable architecture patterns, deployment guidance and integration best practices that avoid unnecessary vendor lock-in.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="pb-5">
        <div class="container-xl">
            <div class="glass-card">
                <div class="row align-items-center g-3">
                    <div class="col-lg-8">
                        <div class="glass-label">Not sure where to start?</div>
                        <div style="font-size:1.25rem;font-weight:750;margin-bottom:.35rem;">Most engagements begin with a defined manufacturing problem.</div>
                        <p class="sentinel-muted mb-0">We assess the systems, data and operational context around the problem, identify practical opportunities and recommend an implementation path before committing to a larger solution.</p>
                    </div>
                    <div class="col-lg-4 d-flex justify-content-lg-end">
                        <a asp-controller="Home" asp-action="Contact" asp-route-topic="industrial-ai-readiness" class="btn-sentinel-primary">Discuss your manufacturing challenge</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
