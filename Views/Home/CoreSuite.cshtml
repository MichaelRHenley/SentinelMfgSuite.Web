@* Views/Home/CoreSuite.cshtml *@
@{
    ViewBag.Title = "Core Suite";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ==========================================
           CoreSuite page-scoped Sentinel styling
           (Move into site.css later if desired)
           ========================================== */

    /* Page + background */
    body {
        background: radial-gradient(circle at top left, #131b3a 0, #050713 35%, #050b16 100%);
        color: #f4f7ff;
    }

        /* Kill the global watermark on this page only */
        body::before {
            content: none !important;
            background-image: none !important;
            display: none !important;
        }

    .sentinel-page {
        min-height: 100vh;
        padding-bottom: 4rem;
    }

    /* =======================
           HERO + WATERMARK
           ======================= */

    .sentinel-hero {
        padding: 5rem 0 4rem;
        position: relative;
        overflow: hidden;
    }

        .sentinel-hero::before {
            content: "";
            position: absolute;
            top: -40px;
            right: 780px;
            width: 520px;
            height: 520px;
            background-image: url("/img/branding/sentinel emblem trans.png");
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            opacity: 0.08;
            pointer-events: none;
            filter: drop-shadow(0 0 18px rgba(0, 0, 0, 0.45));
            z-index: 0;
        }

    .sentinel-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
        gap: 3rem;
        align-items: center;
        position: relative;
        z-index: 1;
    }

    .sentinel-kicker {
        letter-spacing: .12em;
        text-transform: uppercase;
        font-size: .8rem;
        font-weight: 600;
        color: #7ea8ff;
        margin-bottom: .75rem;
    }

    .sentinel-hero-title {
        font-size: clamp(2.4rem, 3vw + 1.5rem, 3.4rem);
        font-weight: 700;
        line-height: 1.1;
        margin-bottom: 1rem;
    }

        .sentinel-hero-title span {
            background: linear-gradient(120deg, #4ef0ff, #2d8cff, #8f8dff);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

    .sentinel-hero-subtitle {
        font-size: 1.05rem;
        max-width: 34rem;
        color: #c6d1ff;
        margin-bottom: 1.75rem;
    }

    .sentinel-hero-ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .sentinel-hero-note {
        font-size: .8rem;
        color: #8e9bd4;
    }

    /* =======================
           BUTTONS
           ======================= */

    .btn-sentinel-primary {
        border-radius: 999px;
        padding: 0.75rem 1.75rem;
        font-weight: 600;
        border: none;
        background: radial-gradient(circle at top left, #4ef0ff 0, #2d8cff 30%, #1742ff 100%);
        color: #050713;
        box-shadow: 0 0 18px rgba(77, 184, 255, 0.65);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-sentinel-primary:hover {
            filter: brightness(1.05);
            box-shadow: 0 0 24px rgba(77, 184, 255, 0.9);
            color: #020308;
        }

    .btn-sentinel-ghost {
        border-radius: 999px;
        padding: 0.75rem 1.6rem;
        font-weight: 500;
        border: 1px solid rgba(132, 170, 255, 0.6);
        background: rgba(4, 10, 32, 0.6);
        color: #d3deff;
        text-decoration: none;
        backdrop-filter: blur(14px);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-sentinel-ghost:hover {
            background: rgba(12, 24, 66, 0.9);
            color: #ffffff;
        }

    /* =======================
           GLASS CARDS
           ======================= */

    .glass-card {
        background: radial-gradient(circle at top left, rgba(77, 184, 255, 0.12), rgba(4, 8, 26, 0.9));
        border-radius: 1.5rem;
        padding: 1.5rem;
        border: 1px solid rgba(130, 189, 255, 0.4);
        box-shadow: 0 0 28px rgba(36, 112, 212, 0.55);
        backdrop-filter: blur(18px);
    }

    .glass-card-label {
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .18em;
        color: #8fb6ff;
        margin-bottom: .75rem;
    }

    /* Dashboard tiles */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .75rem;
        margin-bottom: 1rem;
    }

    .dashboard-tile {
        border-radius: 1rem;
        padding: .9rem;
        background: radial-gradient(circle at top left, rgba(111, 255, 210, 0.25), rgba(5, 9, 31, 0.9));
        border: 1px solid rgba(134, 255, 209, 0.6);
        box-shadow: 0 0 16px rgba(120, 255, 210, 0.5);
        cursor: pointer;
    }

        .dashboard-tile.danger {
            background: radial-gradient(circle at top left, rgba(255, 107, 107, 0.25), rgba(18, 6, 23, 0.95));
            border-color: rgba(255, 140, 140, 0.7);
            box-shadow: 0 0 20px rgba(255, 108, 108, 0.7);
        }

        .dashboard-tile.pending {
            background: radial-gradient(circle at top left, rgba(255, 214, 102, 0.20), rgba(21, 14, 7, 0.95));
            border-color: rgba(255, 219, 137, 0.75);
            box-shadow: 0 0 18px rgba(255, 214, 102, 0.65);
        }

    .dashboard-tile-label {
        font-size: .75rem;
        color: #e2ebff;
        opacity: .8;
    }

    .dashboard-tile-value {
        font-size: 1.4rem;
        font-weight: 700;
        color: #f4f7ff;
    }

    .dashboard-tile-sub {
        font-size: .75rem;
        color: #a0aedc;
    }

    .sentinel-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
        font-size: .75rem;
    }

    .sentinel-chip {
        padding: .25rem .7rem;
        border-radius: 999px;
        background: rgba(11, 23, 66, 0.9);
        border: 1px solid rgba(132, 170, 255, 0.6);
        color: #cdd8ff;
    }

    /* =======================
           SECTIONS
           ======================= */

    .sentinel-section {
        padding: 3.5rem 0;
    }

    .sentinel-section-header {
        max-width: 48rem;
        margin: 0 auto 2rem;
        text-align: center;
    }

    .sentinel-section-kicker {
        font-size: .8rem;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: #7ea8ff;
        margin-bottom: .4rem;
    }

    .sentinel-section-title {
        font-size: 1.9rem;
        font-weight: 650;
        margin-bottom: .5rem;
    }

    .sentinel-section-sub {
        font-size: .95rem;
        color: rgba(219, 229, 255, 0.72);
        margin: 0;
    }

    /* Problem band */
    .sentinel-problem {
        background: linear-gradient(135deg, rgba(255, 86, 122, 0.12), rgba(0, 0, 0, 0));
        border-radius: 1.4rem;
        border: 1px solid rgba(255, 130, 164, 0.4);
        padding: 1.75rem;
        margin-bottom: 1.5rem;
    }

    .sentinel-problem-title {
        font-size: 1.45rem;
        font-weight: 650;
        margin-bottom: .75rem;
    }

    .sentinel-problem-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: .75rem;
    }

    .sentinel-problem-item {
        font-size: .92rem;
        color: #f6d2dc;
    }

    /* Generic feature grid card (used for steps, modules, roles, proof) */
    .sentinel-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 1rem;
    }

    .sentinel-col-4 {
        grid-column: span 4;
    }

    .sentinel-col-3 {
        grid-column: span 3;
    }

    .sentinel-col-6 {
        grid-column: span 6;
    }

    @@media (max-width: 992px) {
        .sentinel-col-6 {
            grid-column: span 12;
        }

        .sentinel-col-4 {
            grid-column: span 12;
        }

        .sentinel-col-3 {
            grid-column: span 12;
        }

        .sentinel-hero {
            padding-top: 3rem;
        }

        .sentinel-hero-grid {
            grid-template-columns: 1fr;
        }

        .sentinel-hero::before {
            top: -20px;
            right: 10px;
            width: 360px;
            height: 360px;
            opacity: 0.10;
        }
    }

    /* Pillars */
    .sentinel-pillars {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 1rem;
    }

    .pillar-card {
        background: radial-gradient(circle at top left, rgba(77, 184, 255, 0.18), rgba(5, 9, 30, 0.9));
        border-radius: 1.2rem;
        padding: 1.25rem 1.25rem 1.2rem;
        border: 1px solid rgba(143, 191, 255, 0.55);
        backdrop-filter: blur(14px);
    }

    .pillar-title {
        font-size: 1.03rem;
        font-weight: 650;
        margin-bottom: .35rem;
        color: #f4f7ff;
    }

    .pillar-text {
        font-size: .92rem;
        color: rgba(219, 229, 255, 0.75);
        margin: 0;
    }

    /* Tiers */
    .tiers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 1rem;
    }

    .tier-card {
        background: radial-gradient(circle at top left, rgba(111, 255, 210, 0.10), rgba(4, 9, 26, 0.92));
        border-radius: 1.2rem;
        padding: 1.2rem;
        border: 1px solid rgba(130, 255, 209, 0.6);
        backdrop-filter: blur(14px);
        position: relative;
    }

    .tier-label {
        font-size: .8rem;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: #7ae9ca;
        margin-bottom: .2rem;
    }

    .tier-name {
        font-weight: 650;
        margin-bottom: .4rem;
        color: #f4f7ff;
    }

    .tier-line {
        font-size: .87rem;
        color: rgba(198, 249, 234, 0.85);
        margin-bottom: .35rem;
    }

    .tier-tag {
        position: absolute;
        top: .9rem;
        right: 1rem;
        font-size: .7rem;
        padding: .2rem .5rem;
        border-radius: 999px;
        border: 1px solid rgba(181, 255, 231, 0.7);
        color: #b5ffe7;
        background: rgba(4, 20, 18, 0.9);
    }

    /* Personas */
    .persona-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 1rem;
    }

    .persona-card {
        background: radial-gradient(circle at top left, rgba(122, 167, 255, 0.16), rgba(6, 9, 28, 0.96));
        border-radius: 1.2rem;
        padding: 1.1rem;
        border: 1px solid rgba(153, 191, 255, 0.45);
        backdrop-filter: blur(14px);
    }

    .persona-title {
        font-size: .98rem;
        font-weight: 650;
        margin-bottom: .25rem;
        color: #f4f7ff;
    }

    .persona-line-label {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .16em;
        color: #8ca7ff;
        margin-top: .55rem;
        margin-bottom: .15rem;
    }

    .persona-text {
        font-size: .87rem;
        color: rgba(219, 229, 255, 0.78);
        margin: 0;
    }

    /* Launch teaser */
    .sentinel-launch-teaser {
        padding-top: 1.5rem;
    }

    .launch-card {
        border-radius: 1.5rem;
        padding: 1.75rem 1.6rem 1.9rem;
        background: radial-gradient(circle at top left, rgba(77, 184, 255, 0.25), rgba(5, 9, 30, 0.95));
        border: 1px solid rgba(143, 191, 255, 0.55);
        box-shadow: 0 0 32px rgba(33, 95, 197, 0.55);
    }

    .launch-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .25rem .8rem;
        border-radius: 999px;
        border: 1px solid rgba(158, 214, 255, 0.9);
        font-size: .75rem;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: #cfe3ff;
        margin-bottom: .75rem;
    }

    .launch-title {
        font-size: 1.65rem;
        font-weight: 650;
        margin-bottom: .4rem;
        color: #f4f7ff;
    }

    .launch-subtitle {
        font-size: .95rem;
        color: rgba(219, 229, 255, 0.78);
        margin-bottom: .85rem;
        max-width: 46rem;
    }

    .launch-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .launch-point-label {
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .16em;
        color: #9fc0ff;
        margin-bottom: .25rem;
    }

    .launch-point-text {
        font-size: .9rem;
        color: rgba(221, 231, 255, 0.85);
        margin: 0;
    }

    .launch-cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        margin-top: .5rem;
    }

    /* Countdown tile */
    .launch-tile--countdown {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        border-radius: 1.25rem;
        background: radial-gradient(circle at top left, rgba(67, 132, 255, 0.22), rgba(6, 12, 40, 0.9));
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
        border: 1px solid rgba(133, 172, 255, 0.35);
        backdrop-filter: blur(22px);
        margin-top: 1.25rem;
        padding: 1rem 1.5rem 1.1rem;
        align-items: center;
    }

    .launch-tile-subtitle {
        margin-bottom: 0.4rem;
        text-align: center;
        max-width: 40rem;
        color: rgba(219, 229, 255, 0.85);
    }

    .launch-countdown {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.85rem;
        max-width: 720px;
        width: 100%;
    }

    .countdown-segment {
        text-align: center;
        padding: 0.45rem 0.4rem;
        border-radius: 0.85rem;
        background: radial-gradient(circle at top, rgba(16, 26, 72, 0.9), rgba(3, 7, 26, 0.9));
        border: 1px solid rgba(140, 190, 255, 0.4);
        box-shadow: 0 0 18px rgba(40, 120, 255, 0.25);
    }

    .countdown-value {
        display: block;
        font-size: 1.6rem;
        font-weight: 750;
        letter-spacing: 0.03em;
        line-height: 1.1;
        color: #f4f7ff;
    }

    .countdown-label {
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        opacity: 0.8;
        color: rgba(219, 229, 255, 0.85);
    }

    .launch-countdown-message {
        font-size: 0.9rem;
        opacity: 0.9;
        color: rgba(219, 229, 255, 0.9);
    }

        .launch-countdown-message.d-none {
            display: none;
        }

    /* CTA band */
    .sentinel-cta-band {
        margin-top: 2.5rem;
        margin-bottom: 0.5rem;
        border-radius: 1.5rem;
        padding: 1.8rem 1.5rem;
        background: radial-gradient(circle at top left, rgba(77, 184, 255, 0.18), rgba(5, 9, 30, 0.92));
        border: 1px solid rgba(158, 214, 255, 0.45);
        box-shadow: 0 0 34px rgba(77, 184, 255, 0.45);
        backdrop-filter: blur(18px);
    }

    .sentinel-cta-title {
        font-size: 1.45rem;
        font-weight: 650;
        margin-bottom: .4rem;
        color: #f4f7ff;
    }

    .sentinel-cta-sub {
        font-size: .95rem;
        color: rgba(219, 229, 255, 0.80);
        margin: 0;
    }

    .sentinel-cta-band .sentinel-hero-ctas {
        justify-content: flex-start;
    }

    @@media (max-width: 576px) {
        .sentinel-cta-band .sentinel-hero-ctas {
            justify-content: center;
        }
    }

    /* Bullet list inside Sentinel cards */
    .sentinel-list {
        margin: .65rem 0 0;
        padding-left: 1.05rem;
        color: rgba(219, 229, 255, 0.78);
        font-size: .9rem;
    }

        .sentinel-list li {
            margin: .25rem 0;
        }

    /* Small eyebrow badge */
    .sentinel-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .25rem .75rem;
        border-radius: 999px;
        border: 1px solid rgba(158, 214, 255, 0.55);
        background: rgba(4, 10, 32, 0.55);
        color: #cfe3ff;
        font-size: .75rem;
        letter-spacing: .16em;
        text-transform: uppercase;
        margin-bottom: .85rem;
        backdrop-filter: blur(14px);
    }
</style>

<main class="sentinel-main">
    <div class="sentinel-page sentinel-page--no-watermark">
        <div class="container">

            <!-- HERO -->
            <section class="sentinel-hero">
                <div class="sentinel-hero-grid">

                    <div>
                        <div class="sentinel-kicker">
                            Manufacturing Core Suite™ · Emergency Maintenance Module
                        </div>

                        <h1 class="sentinel-hero-title">
                            <span>EM Module</span> launching first. The rest follows.
                        </h1>

                        <p class="sentinel-hero-subtitle">
                            We're launching the <strong>Emergency Maintenance Module</strong> first — a complete, mobile-first workflow 
                            for managing unplanned equipment failures. <strong>Pilot partners get early access</strong> and help shape the roadmap.
                            <br /><br />
                            <strong>This system costs less than one hour of downtime per month.</strong>
                        </p>

                        <div class="sentinel-hero-ctas">
                            <a asp-controller="Home" asp-action="Contact" asp-route-topic="pilot-application"
                               class="btn-sentinel-primary"
                               onclick="gtag('event','apply_pilot_program',{ 'button_location':'core_suite_hero_primary','event_category':'conversion' });">
                                Apply for Pilot Program
                            </a>
                            <a asp-controller="Home" asp-action="Pricing"
                               class="btn-sentinel-ghost"
                               onclick="gtag('event','view_pricing',{ 'button_location':'core_suite_hero_secondary','event_category':'navigation' });">
                                See Pricing
                            </a>
                        </div>

                        <p class="sentinel-hero-note">
                            <strong>Pilot benefits:</strong> Early access when EM launches · 50% discount for 12 months · 
                            Direct engineering access · Co-design your deployment · Priority for future modules
                        </p>
                    </div>

                    <div class="sentinel-hero-dashboard">
                        <div class="glass-card">
                            <div class="glass-card-label">
                                EM Module · Launch Status
                            </div>

                            <div class="dashboard-grid">
                                <div class="dashboard-tile pending">
                                    <div class="dashboard-tile-label">EM Module</div>
                                    <div class="dashboard-tile-value">Coming Soon</div>
                                    <div class="dashboard-tile-sub">Launching Q2 2026</div>
                                </div>

                                <div class="dashboard-tile">
                                    <div class="dashboard-tile-label">Pilot Program</div>
                                    <div class="dashboard-tile-value">Open</div>
                                    <div class="dashboard-tile-sub">Apply for early access</div>
                                </div>

                                <div class="dashboard-tile">
                                    <div class="dashboard-tile-label">Deployment</div>
                                    <div class="dashboard-tile-value">Weeks</div>
                                    <div class="dashboard-tile-sub">
                                        Co-designed with your team
                                    </div>
                                </div>

                                <div class="dashboard-tile pending" style="opacity: 0.6;">
                                    <div class="dashboard-tile-label">Other Modules</div>
                                    <div class="dashboard-tile-value">Later 2026</div>
                                    <div class="dashboard-tile-sub">
                                        After EM stabilizes
                                    </div>
                                </div>
                            </div>

                            <div class="sentinel-chip-row">
                                <span class="sentinel-chip">EM First</span>
                                <span class="sentinel-chip">Pilot early access</span>
                                <span class="sentinel-chip">50% discount</span>
                            </div>
                        </div>
                    </div>

                </div>
            </section>

            <!-- EM MODULE PILOT PROGRAM -->
            <section class="sentinel-section sentinel-launch-teaser">
                <div class="launch-card">
                    <div class="launch-pill">Emergency Maintenance Module · Launching Q2 2026</div>

                    <h2 class="launch-title">Be first to deploy the EM Module</h2>

                    <p class="launch-subtitle">
                        We're recruiting 5-10 pilot partners to get early access when the EM Module launches. 
                        Get 50% off for 12 months, co-design your deployment, and work directly with engineering as we build the rest of the platform.
                    </p>

                    <div class="launch-grid">
                        <div class="launch-point">
                            <div class="launch-point-label">Early Access to EM</div>
                            <p class="launch-point-text">
                                Be the first to deploy the Emergency Maintenance Module when it launches in Q2 2026. 
                                No waiting in line — you're in from day one.
                            </p>
                        </div>

                        <div class="launch-point">
                            <div class="launch-point-label">Shape the Roadmap</div>
                            <p class="launch-point-text">
                                Your feedback directly influences EM v2.0 and the development of the other modules 
                                (Planned Maintenance, Production Tracking, Parts Intelligence).
                            </p>
                        </div>

                        <div class="launch-point">
                            <div class="launch-point-label">50% Off + Priority Access</div>
                            <p class="launch-point-text">
                                50% discount for 12 months, direct engineering support, and first access to new modules 
                                as they roll out later in 2026.
                            </p>
                        </div>
                    </div>

                    <div class="launch-cta-row">
                        <a asp-controller="Home" asp-action="Contact" asp-route-topic="pilot-application"
                           class="btn-sentinel-primary"
                           onclick="gtag('event', 'apply_pilot_program', {
                               'button_location': 'pilot_teaser',
                               'event_category': 'conversion',
                               'event_label': 'Pilot Teaser Apply CTA'
                           });">
                            Apply for Pilot Program
                        </a>

                        <a asp-controller="Home" asp-action="Pricing"
                           class="btn-sentinel-ghost"
                           onclick="gtag('event', 'view_pricing', {
                               'button_location': 'pilot_teaser',
                               'event_category': 'navigation',
                               'event_label': 'Pilot Teaser Pricing'
                           });">
                            See Pilot Pricing
                        </a>
                    </div>

                    <div class="launch-tile launch-tile--countdown">
                        <div class="launch-tile-subtitle">
                            EM Module launch countdown:
                        </div>

                        <div id="launchCountdown" class="launch-countdown">
                            <div class="countdown-segment">
                                <span id="cdDays" class="countdown-value">--</span>
                                <span class="countdown-label">Days</span>
                            </div>
                            <div class="countdown-segment">
                                <span id="cdHours" class="countdown-value">--</span>
                                <span class="countdown-label">Hours</span>
                            </div>
                            <div class="countdown-segment">
                                <span id="cdMinutes" class="countdown-value">--</span>
                                <span class="countdown-label">Minutes</span>
                            </div>
                            <div class="countdown-segment">
