@model SentinelMfgSuite.Web.Models.Assessments.AssessmentQuestionnaireWelcomeViewModel
@{
    ViewData["Title"] = "Industrial Data & AI Readiness Assessment";
    ViewData["Description"] = "Sentinel Industrial Data & AI Readiness Assessment invitation entry page.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="sentinel-main">
    @if (!Model.IsInvitationAvailable)
    {
        <section class="sentinel-hero py-5">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card sentinel-card border-0 rounded-4">
                            <div class="card-body p-4 p-md-5">
                                <h1 class="h3 fw-semibold mb-3">Invitation unavailable</h1>
                                <p class="text-secondary mb-0">This assessment invitation is not currently available. Please contact your Sentinel coordinator if you need a new invitation.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="sentinel-hero py-5">
            <div class="container">
                <div class="row align-items-center g-4">
                    <div class="col-lg-8">
                        <h1 class="display-6 fw-bold mb-3">Welcome to your Sentinel Industrial Data &amp; AI Readiness Assessment</h1>
                        <p class="lead text-secondary mb-3">This guided assessment includes @Model.SectionCount sections and @Model.QuestionCount questions focused on manufacturing systems, data readiness and practical AI adoption planning.</p>
                        <p class="text-secondary mb-0">You may save progress and return later while this invitation remains valid. Where provided, <strong>Unknown / Not sure</strong> is an acceptable answer.</p>
                    </div>
                    <div class="col-lg-4">
                        <div class="card sentinel-card border-0 rounded-4 h-100">
                            <div class="card-body p-4">
                                <div class="text-uppercase small text-secondary mb-1">Current response state</div>
                                <div class="h4 fw-semibold mb-2">@Model.StatusLabel</div>
                                <p class="text-secondary mb-0">@Model.StatusDescription</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="container pb-5">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="card sentinel-card border-0 rounded-4">
                        <div class="card-body p-4 p-md-5">
                            <h2 class="h5 fw-semibold mb-3">Assessment entry</h2>
                            <ul class="text-secondary mb-4">
                                <li>Not Started: begin your first response session.</li>
                                <li>In Progress: continue from your most recent saved draft.</li>
                                <li>Submitted: answers are locked and available for read-only review.</li>
                            </ul>

                            @if (Model.IsReadOnly)
                            {
                                <div class="alert alert-info" role="status">
                                    This invitation is currently in read-only mode. Your submitted answers are locked.
                                </div>
                            }

                            @if (Model.PrimaryActionEnabled && !string.IsNullOrWhiteSpace(Model.PrimaryActionUrl))
                            {
                                <a class="btn-sentinel-primary btn-lg" href="@Model.PrimaryActionUrl">@Model.PrimaryActionLabel</a>
                            }
                            else
                            {
                                <button type="button" class="btn-sentinel-primary btn-lg" disabled>@Model.PrimaryActionLabel</button>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.PrimaryActionNote))
                            {
                                <p class="small text-secondary mt-3 mb-0">@Model.PrimaryActionNote</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
</main>
