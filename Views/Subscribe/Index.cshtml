@{
    ViewData["Title"] = "Subscribe";
}

@section Styles {
    <style>
        .glass-card {
            background: linear-gradient(120deg, rgba(10, 22, 58, 0.78), rgba(6, 10, 28, 0.74));
            border: 1px solid rgba(124, 173, 255, 0.28);
            box-shadow: 0 0 28px rgba(33, 95, 197, 0.35);
            border-radius: 22px;
            backdrop-filter: blur(18px);
        }

        .glass-badge {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: .35rem .75rem;
            border-radius: 999px;
            border: 1px solid rgba(124, 173, 255, 0.35);
            background: rgba(4, 10, 32, 0.65);
            color: #cfe0ff;
            font-size: .8rem;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .glass-input {
            background: rgba(4, 10, 32, 0.7) !important;
            border: 1px solid rgba(124, 173, 255, 0.35) !important;
            color: #f4f7ff !important;
            border-radius: 14px !important;
            padding: .75rem 1rem !important;
        }

            .glass-input::placeholder {
                color: rgba(210, 225, 255, 0.6);
            }

        .btn-sentinel-primary-xl {
            border-radius: 999px;
            padding: 0.7rem 1.4rem;
            font-weight: 700;
            border: none;
            background: radial-gradient(circle at top left, #4ef0ff 0, #2d8cff 36%, #1742ff 100%);
            color: #050713;
            box-shadow: 0 0 18px rgba(77, 184, 255, 0.75);
            text-decoration: none;
            white-space: nowrap;
        }

            .btn-sentinel-primary-xl:hover {
                filter: brightness(1.05);
                box-shadow: 0 0 22px rgba(77, 184, 255, 0.95);
                color: #020308;
            }

        .btn-sentinel-ghost-xl {
            border-radius: 999px;
            padding: 0.65rem 1.25rem;
            font-weight: 600;
            border: 1px solid rgba(133, 176, 255, 0.7);
            background: rgba(4, 10, 32, 0.8);
            color: #d3deff;
            text-decoration: none;
            white-space: nowrap;
        }

            .btn-sentinel-ghost-xl:hover {
                background: rgba(11, 25, 69, 0.95);
                color: #ffffff;
            }

        .subtle {
            color: rgba(219, 229, 255, 0.75);
        }

        .feature-list li {
            margin-bottom: .45rem;
            color: rgba(219, 229, 255, 0.9);
        }

        .divider {
            height: 1px;
            background: rgba(124, 173, 255, 0.25);
            margin: 1.1rem 0;
        }
    </style>
}

<div class="container" style="max-width: 980px;">
    <div class="glass-card p-4 p-lg-5">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <div class="glass-badge">Tier 1 · Monthly</div>
                <h1 class="mt-3 mb-2" style="font-weight: 800; letter-spacing: .02em;">Activate your Sentinel tenant</h1>
                <p class="subtle mb-0">
                    You’re signed in. Create your company tenant to start onboarding sites, areas, work centers, and equipment.
                </p>
            </div>

            <div class="text-end">
                <div class="subtle small">Next: Onboarding wizard</div>
                <div class="subtle small">Estimated time: ~5 minutes</div>
            </div>
        </div>

        <div class="divider"></div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" style="border-radius: 16px;">
                Please fix the errors below and try again.
            </div>
        }

        <form asp-controller="Subscribe" asp-action="CreateTenant" method="post" class="mt-2">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-12 col-lg-8">
                    <label class="form-label">Company / Tenant name</label>
                    <input name="tenantName"
                           class="form-control glass-input"
                           placeholder="e.g., Acme Packaging – Perth Plant"
                           autocomplete="organization"
                           required />
                    <div class="form-text subtle">
                        This name appears in your admin settings and email receipts.
                    </div>
                </div>

                <div class="col-12 col-lg-4">
                    <label class="form-label">Plan</label>
                    <input class="form-control glass-input" value="Tier 1 — Monthly" disabled />
                    <div class="form-text subtle">
                        Tier upgrades available after activation.
                    </div>
                </div>
            </div>

            <div class="divider"></div>

            <div class="row g-4">
                <div class="col-12 col-lg-7">
                    <h5 class="mb-2" style="font-weight: 700;">What you get immediately</h5>
                    <ul class="feature-list ps-3 mb-0">
                        <li>Tenant-isolated database and role-based access</li>
                        <li>Onboarding wizard for site → area → work center → equipment</li>
                        <li>Structured CSV imports for maintenance history, parts, and BOMs</li>
                        <li>Dashboards and standardized workflows (Tier 1 scope)</li>
                    </ul>
                </div>

                <div class="col-12 col-lg-5">
                    <div class="p-3" style="border: 1px solid rgba(124, 173, 255, 0.25); border-radius: 18px; background: rgba(4,10,32,0.55);">
                        <div class="subtle small text-uppercase" style="letter-spacing: .14em;">Important</div>
                        <div class="mt-2" style="color: rgba(219,229,255,0.9);">
                            This screen is your temporary “payment success” flow while we wire Stripe.
                            It provisions your tenant and assigns you Tenant Owner/Admin.
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-end mt-4">
                <a asp-controller="Home" asp-action="Pricing" class="btn-sentinel-ghost-xl">
                    Back to pricing
                </a>

                <button type="submit" class="btn-sentinel-primary-xl">
                    Create tenant &amp; continue
                </button>
            </div>
        </form>
    </div>
</div>

