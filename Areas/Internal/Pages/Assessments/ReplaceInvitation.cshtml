@page "/Internal/Assessments/{assessmentId:guid}/ReplaceInvitation/{invitationId:guid}"
@model SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReplaceInvitationModel
@{
    ViewData["Title"] = "Replace Invitation";
    ViewData["Description"] = "Replace an eligible, unused assessment invitation.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="sentinel-main">
    <section class="container py-4 py-lg-5">
        <div class="card sentinel-card border-0 rounded-4">
            <div class="card-body p-3 p-md-4 p-lg-5">
                <h1 class="h3 fw-semibold mb-3">Replace Invitation</h1>

                @if (!ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        @foreach (var error in ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p class="mb-0">@error.ErrorMessage</p>
                        }
                    </div>
                }

                @if (Model.DevelopmentInvitationUrl is not null)
                {
                    <div class="alert alert-info" role="status">
                        <a href="@Model.DevelopmentInvitationUrl" rel="noreferrer">Open Test Questionnaire</a>
                    </div>
                }

                <dl class="row mb-4">
                    <dt class="col-sm-3">Assessment title</dt>
                    <dd class="col-sm-9">@Model.AssessmentTitle</dd>

                    <dt class="col-sm-3">Manufacturing site</dt>
                    <dd class="col-sm-9">@Model.SiteName</dd>

                    <dt class="col-sm-3">Recipient email</dt>
                    <dd class="col-sm-9">@Model.ContactEmail</dd>

                    <dt class="col-sm-3">Invitation expiration policy</dt>
                    <dd class="col-sm-9">The replacement invitation link will expire @Model.InvitationExpiration.Days days after it is sent.</dd>
                </dl>

                @if (Model.IsEligible)
                {
                    <form method="post">
                        <p class="text-secondary">
                            This will revoke the existing invitation and issue a new invitation for this assessment, then attempt to
                            send it to the recipient email above. The original invitation record is preserved for audit purposes.
                            Please confirm before continuing.
                        </p>
                        <button type="submit" class="btn-sentinel-primary">Confirm and replace invitation</button>
                    </form>
                }
                else
                {
                    <div class="alert alert-info mb-0" role="status">
                        @(Model.IneligibleReason ?? "This invitation is not currently eligible for replacement.")
                    </div>
                }
            </div>
        </div>
    </section>
</main>
