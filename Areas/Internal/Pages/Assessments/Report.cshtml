                                }
                                <form method="post" asp-page-handler="SaveRoadmap" asp-fragment="roadmap">
                                    <input type="hidden" asp-for="AssessmentId" />
                                    <input type="hidden" asp-for="SubmittedResponseId" />
                                    <input type="hidden" asp-for="RevisionId" />
                                    <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                    @if (Model.ValidationIssues.Count > 0)
                                    {
                                        <div class="mb-3" role="status">
                                            @foreach (var issue in Model.ValidationIssues)
                                            {
                                                <div class="alert @(issue.Severity == SentinelMfgSuite.Web.Services.Assessments.Reports.ReportContentValidationSeverity.Error ? "alert-danger" : "alert-warning") py-2 mb-2"><strong>@issue.Severity:</strong> @issue.Message</div>
                                            }
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <label asp-for="RoadmapInput.State" class="form-label">Section assessment state</label>
                                        <select asp-for="RoadmapInput.State" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState>()" class="form-select bg-dark text-light border-secondary"></select>
                                    </div>
                                    @{
                                        var storedRoadmap = Model.ReportContent?.ImplementationRoadmap.Items ?? Array.Empty<SentinelMfgSuite.Web.Models.Assessments.Reports.RoadmapItem>();
                                        var nextPriority = 1;
                                        var usedPriorities = Model.RoadmapInput.Items.Select(r => r.Priority ?? 0).Concat(storedRoadmap.Select(r => r.Priority)).ToHashSet();
                                        while (usedPriorities.Contains(nextPriority)) { nextPriority++; }
                                    }
                                    <div id="roadmapList" data-next-priority="@nextPriority">
                                        @for (var i = 0; i < Model.RoadmapInput.Items.Count; i++)
                                        {
                                            var storedItem = storedRoadmap.FirstOrDefault(r => r.Id == Model.RoadmapInput.Items[i].Id);
                                            <partial name="_RoadmapItemEditor" model="new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.RoadmapItemEditorModel(Model.RoadmapInput.Items[i], i.ToString(), Model.EvidenceOptions, storedItem, storedRoadmap)" />
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline-light btn-sm mb-3" id="addRoadmapItem">Add roadmap item</button>
                                    @{
                                        var newRoadmapModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.RoadmapItemEditorModel(new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.RoadmapItemInput { StartDay = 1, EndDay = 1, Priority = null }, "__index__", Model.EvidenceOptions, null, storedRoadmap);
                                    }
                                    <template id="roadmapItemTemplate">
                                        <partial name="_RoadmapItemEditor" model="newRoadmapModel" />
                                    </template>
                                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                                    <button type="submit" class="btn-sentinel-primary" disabled="@(Model.RevisionStatus != SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft)">Save Draft</button>
                                </form>
                            </section>
                            <section id="executivePresentation" class="report-tab-panel border border-info rounded-3 p-3 mb-4" role="tabpanel" aria-labelledby="tab-executivePresentation" tabindex="0" hidden>
                                <h3 id="executivePresentationHeading" class="h5 fw-semibold">Executive Presentation</h3>
                                Implementation Roadmap tabs for context.
                                @if (Model.SaveStatus == "Executive Presentation Draft saved.")
                                {
                                    <div class="alert alert-success" role="status">@Model.SaveStatus</div>
                                }
                                <form method="post" asp-page-handler="SaveExecutivePresentation" asp-fragment="executivePresentation">
                                    <input type="hidden" asp-for="AssessmentId" />
                                    <input type="hidden" asp-for="SubmittedResponseId" />
                                    <input type="hidden" asp-for="RevisionId" />
                                    <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                    @if (Model.ValidationIssues.Count > 0)
                                    {
                                        <div class="mb-3" role="status">
                                            @foreach (var issue in Model.ValidationIssues)
                                            {
                                                <div class="alert @(issue.Severity == SentinelMfgSuite.Web.Services.Assessments.Reports.ReportContentValidationSeverity.Error ? "alert-danger" : "alert-warning") py-2 mb-2"><strong>@issue.Severity:</strong> @issue.Message</div>
                                            }
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <label asp-for="PresentationInput.State" class="form-label">Section assessment state</label>
                                        <select asp-for="PresentationInput.State" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState>()" class="form-select bg-dark text-light border-secondary"></select>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="PresentationInput.Title" class="form-label">Title</label>
                                        <input asp-for="PresentationInput.Title" class="form-control bg-dark text-light border-secondary" autocomplete="off" />
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="PresentationInput.Narrative" class="form-label">Narrative</label>
                                        <textarea asp-for="PresentationInput.Narrative" rows="4" class="form-control bg-dark text-light border-secondary"></textarea>
                                    </div>
                                    @{
                                        var storedPresentation = Model.ReportContent?.ExecutivePresentation;
                                        var storedKeyMessages = storedPresentation?.KeyMessages ?? Array.Empty<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportTextEntry>();
                                        var storedDecisions = storedPresentation?.DecisionsRequested ?? Array.Empty<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportTextEntry>();
                                        var newKeyMessageModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.TextEntryEditorModel(new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.PresentationEntryInput(), "KeyMessages", "__index__", "Key message", Model.EvidenceOptions, null);
                                        var newDecisionModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.TextEntryEditorModel(new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.PresentationEntryInput(), "DecisionsRequested", "__index__", "Decision requested", Model.EvidenceOptions, null);
                                    }
                                    <h4 class="h6">Key messages</h4>
                                    <div id="presKeyMessagesList">
                                        @for (var i = 0; i < Model.PresentationInput.KeyMessages.Count; i++)
                                        {
                                            var entry = Model.PresentationInput.KeyMessages[i];
                                            var entryModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.TextEntryEditorModel(entry, "KeyMessages", i.ToString(), "Key message", Model.EvidenceOptions, storedKeyMessages.FirstOrDefault(s => s.Id == entry.Id));
                                            <partial name="_ReportTextEntryEditor" model="entryModel" />
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline-light btn-sm mb-3" id="addPresKeyMessage">Add key message</button>
                                    <template id="presKeyMessageTemplate"><partial name="_ReportTextEntryEditor" model="newKeyMessageModel" /></template>
                                    <h4 class="h6">Decisions requested</h4>
                                    <div id="presDecisionsList">
                                        @for (var i = 0; i < Model.PresentationInput.DecisionsRequested.Count; i++)
                                        {
                                            var entry = Model.PresentationInput.DecisionsRequested[i];
                                            var entryModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.TextEntryEditorModel(entry, "DecisionsRequested", i.ToString(), "Decision requested", Model.EvidenceOptions, storedDecisions.FirstOrDefault(s => s.Id == entry.Id));
                                            <partial name="_ReportTextEntryEditor" model="entryModel" />
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline-light btn-sm mb-3" id="addPresDecision">Add decision requested</button>
                                    <template id="presDecisionTemplate"><partial name="_ReportTextEntryEditor" model="newDecisionModel" /></template>
                                    <div class="mb-3">
                                        <input type="hidden" name="PresentationInput.TopRisksSubmitted" value="true" />
                                        <label asp-for="PresentationInput.TopRisksText" class="form-label">Top risks (one per line)</label>
                                        <textarea asp-for="PresentationInput.TopRisksText" rows="4" class="form-control bg-dark text-light border-secondary"></textarea>
                                    </div>
                                    @{
                                        var presSectionOther = storedPresentation?.EvidenceReferences?.Where(r => r.Kind != SentinelMfgSuite.Web.Models.Assessments.Reports.ReportEvidenceKind.QuestionnaireAnswer).ToArray();
                                        var presSectionEvidence = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.EvidenceCheckboxModel(Model.EvidenceOptions, "PresentationInput.EvidenceQuestionIds", "pres-section-evidence", Model.PresentationInput.EvidenceQuestionIds);
                                    }
                                    <details class="mb-3">
                                        <summary class="small">Section questionnaire evidence references</summary>
                                        <input type="hidden" name="PresentationInput.EvidenceSubmitted" value="true" />
                                        <partial name="_EvidenceCheckboxes" model="presSectionEvidence" />
                                        @if (presSectionOther is { Length: > 0 })
                                        {
                                            <p class="small text-secondary mt-2 mb-0">Other preserved evidence references (read-only): @string.Join(", ", presSectionOther.Select(r => $"{r.Kind}: {r.ReferenceId}"))</p>
                                        }
                                    </details>
                                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                                    <button type="submit" class="btn-sentinel-primary" disabled="@(Model.RevisionStatus != SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft)">Save Draft</button>
                                </form>
                            </section>
                        </div>
                    </section>
                </div>
            </div>
        }
    </section>
</main>

<script>
    (() => {
        const addButton = document.getElementById('addIndustrialSystem');
        const list = document.getElementById('industrialSystemsList');
        const template = document.getElementById('industrialSystemTemplate');
        const labelExistingSystemEditors = () => {
            list?.querySelectorAll('fieldset legend').forEach((legend, index) => {
                legend.textContent = `Edit system ${index + 1}`;
            });
        };
        labelExistingSystemEditors();
        if (!addButton || !list || !template) return;
        addButton.addEventListener('click', () => {
            const index = list.querySelectorAll('.industrial-system-entry').length;
            const fragment = template.content.cloneNode(true);
            fragment.querySelectorAll('[name]').forEach(element => {
                element.name = element.name.replaceAll('__index__', index);
            });
            list.appendChild(fragment);
            labelExistingSystemEditors();
        });

        const wireAiAdd = (buttonId, listId, templateId, selector) => {
            const button = document.getElementById(buttonId);
            const aiList = document.getElementById(listId);
            const aiTemplate = document.getElementById(templateId);
            if (!button || !aiList || !aiTemplate) return;
            button.addEventListener('click', () => {
                const index = aiList.querySelectorAll(selector).length;
                const fragment = aiTemplate.content.cloneNode(true);
                fragment.querySelectorAll('[name]').forEach(e => { e.name = e.name.replaceAll('__index__', index); });
                fragment.querySelectorAll('[id]').forEach(e => { e.id = e.id.replaceAll('__index__', index); });
                fragment.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replaceAll('__index__', index); });
                aiList.appendChild(fragment);
            });
        };
        wireAiAdd('addAiOpportunity', 'aiOpportunitiesList', 'aiOpportunityTemplate', '.ai-opportunity-entry');
        wireAiAdd('addAiFinding', 'aiFindingsList', 'aiFindingTemplate', '.ai-finding-entry');
        wireAiAdd('addExecFinding', 'execFindingsList', 'execFindingTemplate', '.exec-finding-entry');
        document.getElementById('execFindingsList')?.addEventListener('click', e => {
            const target = e.target;
            if (!(target instanceof HTMLElement) || !target.classList.contains('remove-exec-finding')) return;
            target.previousElementSibling?.remove();
            target.remove();
            document.getElementById('execFindingsList').querySelectorAll('.exec-finding-entry').forEach((entry, index) => {
                entry.querySelectorAll('[name]').forEach(el => { el.name = el.name.replace(/\[\d+\]/, `[${index}]`); });
            });
        });

        const wireTechnical = (buttonId, listId, templateId, selector, root) => {
            const button = document.getElementById(buttonId);
            const techList = document.getElementById(listId);
            const techTemplate = document.getElementById(templateId);
            if (!button || !techList || !techTemplate) return;
            const reindex = () => {
                techList.querySelectorAll(selector).forEach((entry, index) => {
                    entry.querySelectorAll('[name]').forEach(e => { e.name = e.name.replace(/\[\d+\]/, `[${index}]`); });
                    entry.querySelectorAll('[id]').forEach(e => { e.id = e.id.replace(new RegExp(`^${root}-\\d+-`), `${root}-${index}-`); });
                    entry.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replace(new RegExp(`^${root}-\\d+-`), `${root}-${index}-`); });
                });
            };
            button.addEventListener('click', () => {
                const index = techList.querySelectorAll(selector).length;
                const fragment = techTemplate.content.cloneNode(true);
                fragment.querySelectorAll('[name]').forEach(e => { e.name = e.name.replaceAll('__index__', index); });
                fragment.querySelectorAll('[id]').forEach(e => { e.id = e.id.replaceAll('__index__', index); });
                fragment.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replaceAll('__index__', index); });
                techList.appendChild(fragment);
            });
            techList.addEventListener('click', event => {
                const target = event.target.closest('.remove-new-row');
                if (!target) return;
                target.closest(selector)?.remove();
                reindex();
                button.focus();
            });
        };
        wireTechnical('addTechnicalGap', 'technicalGapsList', 'technicalGapTemplate', '.technical-gap-entry', 'tech-gap');
        wireTechnical('addTechnicalRecommendation', 'technicalRecommendationsList', 'technicalRecommendationTemplate', '.architecture-recommendation-entry', 'tech-rec');

        (() => {
            const button = document.getElementById('addRoadmapItem');
            const list = document.getElementById('roadmapList');
            const tpl = document.getElementById('roadmapItemTemplate');
            if (!button || !list || !tpl) return;
            const selector = '.roadmap-item-entry';
            let nextPriority = parseInt(list.dataset.nextPriority || '1', 10);
            const reindex = () => {
                list.querySelectorAll(selector).forEach((entry, index) => {
                    entry.querySelectorAll('[name]').forEach(e => { e.name = e.name.replace(/\[\d+\]/, `[${index}]`); });
                    entry.querySelectorAll('[id]').forEach(e => { e.id = e.id.replace(/^roadmap-\d+-/, `roadmap-${index}-`); });
                    entry.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replace(/^roadmap-\d+-/, `roadmap-${index}-`); });
                });
            };
            button.addEventListener('click', () => {
                const index = list.querySelectorAll(selector).length;
                const fragment = tpl.content.cloneNode(true);
                fragment.querySelectorAll('[name]').forEach(e => { e.name = e.name.replaceAll('__index__', index); });
                fragment.querySelectorAll('[id]').forEach(e => { e.id = e.id.replaceAll('__index__', index); });
                fragment.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replaceAll('__index__', index); });
                const priority = fragment.querySelector('input[name$=".Priority"]');
                if (priority) { priority.value = nextPriority++; }
                list.appendChild(fragment);
            });
            list.addEventListener('click', event => {
                const target = event.target.closest('.remove-new-row');
                if (!target) return;
                target.closest(selector)?.remove();
                reindex();
                button.focus();
            });
        })();

        const wirePresentation = (addId, listId, tplId, listName) => {
            const button = document.getElementById(addId);
            const list = document.getElementById(listId);
            const tpl = document.getElementById(tplId);
            if (!button || !list || !tpl) return;
            const selector = '.presentation-entry';
            const idRe = new RegExp('^pres' + listName + '-\\d+-');
            const reindex = () => {
                list.querySelectorAll(selector).forEach((entry, index) => {
                    entry.querySelectorAll('[name]').forEach(e => { e.name = e.name.replace(/\[\d+\]/, `[${index}]`); });
                    entry.querySelectorAll('[id]').forEach(e => { e.id = e.id.replace(idRe, `pres${listName}-${index}-`); });
                    entry.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replace(idRe, `pres${listName}-${index}-`); });
                });
            };
            button.addEventListener('click', () => {
                const index = list.querySelectorAll(selector).length;
                const fragment = tpl.content.cloneNode(true);
                fragment.querySelectorAll('[name]').forEach(e => { e.name = e.name.replaceAll('__index__', index); });
                fragment.querySelectorAll('[id]').forEach(e => { e.id = e.id.replaceAll('__index__', index); });
                fragment.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replaceAll('__index__', index); });
                list.appendChild(fragment);
            });
            list.addEventListener('click', event => {
                const target = event.target.closest('.remove-new-row');
                if (!target) return;
                target.closest(selector)?.remove();
                reindex();
                button.focus();
            });
        };
        wirePresentation('addPresKeyMessage', 'presKeyMessagesList', 'presKeyMessageTemplate', 'KeyMessages');
        wirePresentation('addPresDecision', 'presDecisionsList', 'presDecisionTemplate', 'DecisionsRequested');

        const addFindingButton = document.getElementById('addIndustrialFinding');
        const findingList = document.getElementById('industrialFindingsList');
        const findingTemplate = document.getElementById('industrialFindingTemplate');
        const labelFindingEditors = () => {
            findingList?.querySelectorAll('.industrial-finding-entry > legend').forEach((legend, index) => {
                legend.textContent = `Edit finding ${index + 1}`;
            });
        };
        labelFindingEditors();
        if (!addFindingButton || !findingList || !findingTemplate) return;
        addFindingButton.addEventListener('click', () => {
            const index = findingList.querySelectorAll('.industrial-finding-entry').length;
            const fragment = findingTemplate.content.cloneNode(true);
            fragment.querySelectorAll('[name]').forEach(element => {
                element.name = element.name.replaceAll('__index__', index);
            });
            fragment.querySelectorAll('[id]').forEach(element => {
                element.id = element.id.replaceAll('__index__', index);
            });
            fragment.querySelectorAll('[for]').forEach(element => {
                element.htmlFor = element.htmlFor.replaceAll('__index__', index);
            });
            findingList.appendChild(fragment);
            labelFindingEditors();
        });
    })();
</script>

<style>
    .report-tabs-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .report-tabs .nav-link { white-space: nowrap; }
    .report-tabs .nav-link:focus-visible, .report-tab-panel:focus-visible { outline: 3px solid #ffc107; outline-offset: 2px; }
    .report-tab-panel[hidden] { display: none !important; }
</style>
<script>
    (() => {
        const tabs = Array.from(document.querySelectorAll('[data-report-tab]'));
        if (tabs.length === 0) return;
        const ids = tabs.map(t => t.dataset.reportTab);
        const panel = id => document.getElementById(id);
        const snapshot = id => {
            const p = panel(id);
            if (!p) return '';
            const parts = [];
            p.querySelectorAll('form:not([data-report-action])').forEach(f => {
                new FormData(f).forEach((v, k) => { if (typeof v === 'string' && k !== '__RequestVerificationToken') parts.push(k + '=' + v); });
            });
            return parts.join('&');
        };
        const baseline = {};
        ids.forEach(id => { baseline[id] = snapshot(id); });
        const isDirty = id => snapshot(id) !== baseline[id];
        const refreshMarkers = () => tabs.forEach(t => {
            const m = t.querySelector('.report-tab-dirty');
            if (m) m.hidden = !isDirty(t.dataset.reportTab);
        });
        const anyDirty = except => ids.some(id => id !== except && isDirty(id));
        const select = (id, focus, updateUrl) => {
            tabs.forEach(t => {
                const on = t.dataset.reportTab === id;
                t.classList.toggle('active', on);
                t.setAttribute('aria-selected', on ? 'true' : 'false');
                t.tabIndex = on ? 0 : -1;
                if (on && focus) t.focus();
            });
            ids.forEach(pid => { const p = panel(pid); if (p) p.hidden = pid !== id; });
            if (updateUrl && location.hash !== '#' + id) history.replaceState(null, '', '#' + id);
        };
        const fromHash = () => { const h = location.hash.replace('#', ''); return ids.includes(h) ? h : ids[0]; };
        select(fromHash(), false, false);
        window.addEventListener('hashchange', () => select(fromHash(), false, false));
        tabs.forEach((t, i) => {
            t.addEventListener('click', () => select(t.dataset.reportTab, false, true));
            t.addEventListener('keydown', e => {
                let n = -1;
                if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
                else if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
                else if (e.key === 'Home') n = 0;
                else if (e.key === 'End') n = tabs.length - 1;
                if (n < 0) return;
                e.preventDefault();
                select(tabs[n].dataset.reportTab, true, true);
            });
        });

        let submitting = false;
        ids.forEach(id => {
            const p = panel(id);
            if (!p) return;
            p.addEventListener('input', refreshMarkers);
            p.addEventListener('change', refreshMarkers);
            p.addEventListener('click', () => setTimeout(refreshMarkers, 0));
            new MutationObserver(refreshMarkers).observe(p, { childList: true, subtree: true });
            p.querySelectorAll('form').forEach(f => f.addEventListener('submit', e => {
                if (e.defaultPrevented) return;
                if (anyDirty(id) && !confirm('Another report section has unsaved changes that will be lost if you continue. Submit anyway?')) {
                    e.preventDefault();
                    return;
                }
                submitting = true;
            }));
        });
        window.addEventListener('beforeunload', e => {
            if (submitting || !anyDirty(null)) return;
            e.preventDefault();
            e.returnValue = '';
        });
    })();
</script>
