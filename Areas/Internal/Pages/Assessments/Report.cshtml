                                            <input type="hidden" name="IndustrialInput.Findings[__index__].Id" value="" />
                                            <div class="mb-2"><label class="form-label">Title <span class="text-danger">*</span></label><input name="IndustrialInput.Findings[__index__].Title" class="form-control bg-dark text-light border-secondary" autocomplete="off" /></div>
