@page "{assessmentId:guid}/{submittedResponseId:guid}"
@model SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel
@{
    ViewData["Title"] = "Draft Consultant Report";
    ViewData["Description"] = "Internal Draft report workspace for a submitted Sentinel assessment.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="sentinel-main">
    <section class="sentinel-hero py-4 py-lg-5">
        <div class="container">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
                <div>
                    <div class="small text-uppercase text-secondary">Internal consultant workspace</div>
                    <h1 class="h2 fw-semibold mb-2">@Model.AssessmentTitle</h1>
                    <p class="text-secondary mb-0">@Model.SiteName · Submitted @Model.SubmittedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                </div>
                <div class="text-lg-end">
                    <span class="badge rounded-pill @(Model.RevisionStatus == SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft || !Model.RevisionStatus.HasValue ? "bg-warning text-dark" : "bg-secondary")">
                        @(Model.RevisionStatus?.ToString() ?? "Draft not created") — internal only
                    </span>
                    @if (Model.RevisionStatus.HasValue)
                    {
                        <div class="small text-secondary mt-2">Revision @Model.RevisionNumber · @Model.RevisionStatus</div>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="container pb-5">
        <div class="alert alert-warning" role="status">
            Internal report workspace. This is not an approved customer report. Draft editing is available for the Executive Summary, Industrial Data &amp; Systems, AI Opportunities &amp; ROI, Technical Gaps &amp; Architecture, Implementation Roadmap, and Executive Presentation sections. Approval, issuance, PDF generation, and customer delivery are not yet available.
        </div>

        @if (!Model.RevisionId.HasValue)
        {
            <div class="card sentinel-card border-0 rounded-4">
                <div class="card-body p-4">
                    <h2 class="h4">No Draft report exists</h2>
                    <p class="text-secondary">Create a Draft linked to this submitted questionnaire response. No report is created until you confirm this action.</p>
                    <form method="post" asp-page-handler="CreateDraft">
                        <input type="hidden" asp-for="AssessmentId" />
                        <input type="hidden" asp-for="SubmittedResponseId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        <button type="submit" class="btn-sentinel-primary">Create Draft Report</button>
                        <a asp-page="/Assessments/Index" asp-area="Internal" class="btn btn-outline-light ms-2">Back to assessments</a>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-12 col-xl-6">
                    <section class="card sentinel-card border-0 rounded-4 h-100" aria-labelledby="evidenceHeading">
                        <div class="card-body p-3 p-md-4">
                            <h2 id="evidenceHeading" class="h4 fw-semibold">Evidence and scoring context</h2>
                            <p class="small text-secondary">Submitted answers are read-only and sanitized. Scoring shown here is the frozen report snapshot.</p>
                            @if (Model.Scoring is { } score)
                            {
                                <div class="border rounded-3 p-3 mb-3">
                                    <div class="small text-uppercase text-secondary">Overall readiness</div>
                                    <div class="h5 mb-1">@score.OverallStatus</div>
                                    @if (score.OverallScore.HasValue)
                                    {
                                        <div>@score.OverallScore/100 · @score.Classification</div>
                                    }
                                    else
                                    {
                                        <div class="text-secondary">No numeric score or classification is assigned.</div>
                                    }
                                    @if (score.WithholdingReasons.Count > 0)
                                    {
                                        <ul class="small mt-2 mb-0">
                                            @foreach (var reason in score.WithholdingReasons)
                                            {
                                                <li>@reason</li>
                                            }
                                        </ul>
                                    }
                                </div>
                                <div class="table-responsive mb-4">
                                    <table class="table table-dark table-sm align-middle">
                                        <thead><tr><th>Dimension</th><th>Status</th><th>Score</th><th>Evidence</th></tr></thead>
                                        <tbody>
                                            @foreach (var dimension in score.Dimensions)
                                            {
                                                <tr>
                                                    <th>@dimension.Name</th>
                                                    <td>@dimension.Status</td>
                                                    <td>@(dimension.Score.HasValue ? $"{dimension.Score}/100 · {dimension.Classification}" : "Not scored")</td>
                                                    <td>@dimension.ScoreableItems / @dimension.TotalItems</td>
                                                </tr>
                                                @if (dimension.WithholdingReasons.Count > 0)
                                                {
                                                    <tr><td colspan="4" class="small text-secondary">@string.Join("; ", dimension.WithholdingReasons)</td></tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-secondary">Frozen scoring snapshot is unavailable or unsupported.</div>
                            }

                            <h3 class="h5">Submitted questionnaire answers</h3>
                            @if (Model.QuestionnaireSections.Count == 0)
                            {
                                <p class="text-secondary">No readable submitted answers are available.</p>
                            }
                            else
                            {
                                @foreach (var answerSection in Model.QuestionnaireSections)
                                {
                                    <div class="border-top pt-3 mt-3">
                                        <h4 class="h6">@answerSection.Title</h4>
                                        <dl class="mb-0">
                                            @foreach (var answer in answerSection.Answers)
                                            {
                                                <dt class="small text-secondary">@answer.Number — @answer.Question</dt>
                                                <dd class="mb-2">@answer.Answer</dd>
                                            }
                                        </dl>
                                    </div>
                                }
                            }
                        </div>
                    </section>
                </div>
                <div class="col-12 col-xl-6">
                    <section class="card sentinel-card border-0 rounded-4 h-100" aria-labelledby="workspaceHeading">
                        <div class="card-body p-3 p-md-4">
                            <h2 id="workspaceHeading" class="h4 fw-semibold">Consultant report workspace</h2>
                            <p class="small text-secondary">Edit the Executive Summary, Industrial Data &amp; Systems, AI Opportunities &amp; ROI, Technical Gaps &amp; Architecture, Implementation Roadmap, and Executive Presentation Drafts. Evidence and frozen scoring remain read-only in the adjacent panel.</p>
                            @if (Model.SaveStatus is string saveStatus && saveStatus != "AI Opportunities & ROI Draft saved." && saveStatus != "Technical Gaps & Architecture Draft saved." && saveStatus != "Implementation Roadmap Draft saved." && saveStatus != "Executive Presentation Draft saved.")
                            {
                                <div class="alert alert-success" role="status">@saveStatus</div>
                            }
                            <form method="post" asp-page-handler="SaveExecutiveSummary" class="border border-info rounded-3 p-3 mb-4" aria-labelledby="executiveSummaryHeading">
                                <input type="hidden" asp-for="AssessmentId" />
                                <input type="hidden" asp-for="SubmittedResponseId" />
                                <input type="hidden" asp-for="RevisionId" />
                                <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                <h3 id="executiveSummaryHeading" class="h5 fw-semibold">Executive Summary editor</h3>
                                <p class="small text-secondary">This area edits Draft consultant content only. Submitted answers and the scoring snapshot cannot be changed here.</p>
                                @if (Model.LastSavedUtc.HasValue)
                                {
                                    <p class="small text-secondary">Last saved: <time datetime="@Model.LastSavedUtc.Value.ToUniversalTime().ToString("O")">@Model.LastSavedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</time></p>
                                }
                                <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                                @if (Model.ValidationIssues.Count > 0)
                                {
                                    <div class="mb-3" role="status">
                                        @foreach (var issue in Model.ValidationIssues)
                                        {
                                            <div class="alert @(issue.Severity == SentinelMfgSuite.Web.Services.Assessments.Reports.ReportContentValidationSeverity.Error ? "alert-danger" : "alert-warning") py-2 mb-2">
                                                <strong>@issue.Severity:</strong> @issue.Message
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="mb-3">
                                    <label asp-for="Input.State" class="form-label">Assessment state</label>
                                    <select asp-for="Input.State" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState>()" class="form-select bg-dark text-light border-secondary"></select>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Input.Narrative" class="form-label">Executive Summary narrative</label>
                                    <textarea asp-for="Input.Narrative" rows="8" class="form-control bg-dark text-light border-secondary" autocomplete="off"></textarea>
                                    <span asp-validation-for="Input.Narrative" class="text-danger"></span>
                                </div>
                                <fieldset class="mb-3">
                                    <legend class="form-label">Questionnaire evidence references</legend>
                                    @if (Model.EvidenceOptions.Count == 0)
                                    {
                                        <p class="small text-secondary">No questionnaire answers are available to reference.</p>
                                    }
                                    else
                                    {
                                        @foreach (var answer in Model.EvidenceOptions)
                                        {
                                            var selected = Model.Input.EvidenceQuestionIds?.Contains(answer.QuestionId, StringComparer.Ordinal) == true;
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="Input.EvidenceQuestionIds" value="@answer.QuestionId" id="evidence-@answer.QuestionId" checked="@selected" />
                                                <label class="form-check-label small" for="evidence-@answer.QuestionId">@answer.Number — @answer.Question</label>
                                            </div>
                                        }
                                    }
                                </fieldset>
                                <button type="submit" class="btn-sentinel-primary" disabled="@(Model.RevisionStatus != SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft)">Save Draft</button>
                            </form>
                            <p class="small text-secondary">@(Model.SaveConflict ? "Resolve the conflict by reloading and reviewing the newer Draft before reapplying your text." : "Only Executive Summary state, narrative, and questionnaire evidence references are editable here.")</p>
                            <section class="border border-info rounded-3 p-3 mb-4" aria-labelledby="industrialSystemsHeading">
                                <h3 id="industrialSystemsHeading" class="h5 fw-semibold">Industrial Data &amp; Systems</h3>
                                <p class="small text-secondary">System IDs, provenance, verification status, and evidence are preserved. New systems are consultant-entered and unverified, with no evidence added automatically.</p>
                                @if (Model.SaveStatus == "Industrial Data & Systems Draft saved.")
                                {
                                    <div class="alert alert-success" role="status">@Model.SaveStatus</div>
                                }
                                @if (Model.LastSavedUtc.HasValue)
                                {
                                    <p class="small text-secondary">Last saved: <time datetime="@Model.LastSavedUtc.Value.ToUniversalTime().ToString("O")">@Model.LastSavedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</time></p>
                                }
                                <form method="post" asp-page-handler="SaveIndustrialData">
                                    <input type="hidden" asp-for="AssessmentId" />
                                    <input type="hidden" asp-for="SubmittedResponseId" />
                                    <input type="hidden" asp-for="RevisionId" />
                                    <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                                    @if (Model.ValidationIssues.Count > 0)
                                    {
                                        <div class="mb-3" role="status">
                                            @foreach (var issue in Model.ValidationIssues)
                                            {
                                                <div class="alert @(issue.Severity == SentinelMfgSuite.Web.Services.Assessments.Reports.ReportContentValidationSeverity.Error ? "alert-danger" : "alert-warning") py-2 mb-2">
                                                    <strong>@issue.Severity:</strong> @issue.Message
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <label asp-for="IndustrialInput.State" class="form-label">Section assessment state</label>
                                        <select asp-for="IndustrialInput.State" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState>()" class="form-select bg-dark text-light border-secondary"></select>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h4 class="h6 mb-0">System inventory</h4>
                                        <button type="button" class="btn btn-outline-info btn-sm" id="addIndustrialSystem">Add System</button>
                                    </div>
                                    <div id="industrialSystemsList">
                                        @for (var index = 0; index < Model.IndustrialInput.Systems.Count; index++)
                                        {
                                            <fieldset class="border border-secondary rounded-3 p-3 mb-3 industrial-system-entry">
                                                <legend class="float-none w-auto px-2 small">Edit system @(index + 1)</legend>
                                                <input type="hidden" asp-for="IndustrialInput.Systems[index].Id" />
                                                <div class="mb-2">
                                                    <label asp-for="IndustrialInput.Systems[index].Name" class="form-label">Name <span class="text-danger">*</span></label>
                                                    <input asp-for="IndustrialInput.Systems[index].Name" class="form-control bg-dark text-light border-secondary" autocomplete="off" />
                                                    <span asp-validation-for="IndustrialInput.Systems[index].Name" class="text-danger"></span>
                                                </div>
                                                <div class="mb-2"><label asp-for="IndustrialInput.Systems[index].AssessmentState" class="form-label">System assessment state</label><select asp-for="IndustrialInput.Systems[index].AssessmentState" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState>()" class="form-select bg-dark text-light border-secondary"></select></div>
                                                <div class="row g-2">
                                                    <div class="col-md-6 mb-2"><label asp-for="IndustrialInput.Systems[index].SystemType" class="form-label">System type</label><input asp-for="IndustrialInput.Systems[index].SystemType" class="form-control bg-dark text-light border-secondary" /></div>
                                                    <div class="col-md-6 mb-2"><label asp-for="IndustrialInput.Systems[index].Owner" class="form-label">Owner</label><input asp-for="IndustrialInput.Systems[index].Owner" class="form-control bg-dark text-light border-secondary" /></div>
                                                    <div class="col-md-6 mb-2"><label asp-for="IndustrialInput.Systems[index].OperationalArea" class="form-label">Operational area</label><input asp-for="IndustrialInput.Systems[index].OperationalArea" class="form-control bg-dark text-light border-secondary" /></div>
                                                    <div class="col-md-6 mb-2"><label asp-for="IndustrialInput.Systems[index].DataExchanged" class="form-label">Data exchanged</label><input asp-for="IndustrialInput.Systems[index].DataExchanged" class="form-control bg-dark text-light border-secondary" /></div>
                                                    <div class="col-md-6 mb-2"><label asp-for="IndustrialInput.Systems[index].IntegrationPattern" class="form-label">Integration pattern</label><input asp-for="IndustrialInput.Systems[index].IntegrationPattern" class="form-control bg-dark text-light border-secondary" /></div>
                                                    <div class="col-md-6 mb-2"><label asp-for="IndustrialInput.Systems[index].Criticality" class="form-label">Criticality</label><input asp-for="IndustrialInput.Systems[index].Criticality" class="form-control bg-dark text-light border-secondary" /></div>
                                                </div>
                                                <div class="mb-2"><label asp-for="IndustrialInput.Systems[index].ConsultantNotes" class="form-label">Consultant notes</label><textarea asp-for="IndustrialInput.Systems[index].ConsultantNotes" rows="3" class="form-control bg-dark text-light border-secondary"></textarea></div>
                                            </fieldset>
                                        }
                                    </div>
                                    <template id="industrialSystemTemplate">
                                        <fieldset class="border border-secondary rounded-3 p-3 mb-3 industrial-system-entry">
                                            <legend class="float-none w-auto px-2 small">New system</legend>
                                            <input type="hidden" name="IndustrialInput.Systems[__index__].Id" value="" />
                                            <div class="mb-2"><label class="form-label">Name <span class="text-danger">*</span></label><input name="IndustrialInput.Systems[__index__].Name" class="form-control bg-dark text-light border-secondary" autocomplete="off" /></div>
                                            <div class="mb-2"><label class="form-label">System assessment state</label><select name="IndustrialInput.Systems[__index__].AssessmentState" class="form-select bg-dark text-light border-secondary">@foreach (var state in Enum.GetValues<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState>()) { <option value="@state" selected="@(state == SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState.NotAssessed)">@state</option> }</select></div>
                                            <div class="row g-2">
                                                <div class="col-md-6 mb-2"><label class="form-label">System type</label><input name="IndustrialInput.Systems[__index__].SystemType" class="form-control bg-dark text-light border-secondary" /></div>
                                                <div class="col-md-6 mb-2"><label class="form-label">Owner</label><input name="IndustrialInput.Systems[__index__].Owner" class="form-control bg-dark text-light border-secondary" /></div>
                                                <div class="col-md-6 mb-2"><label class="form-label">Operational area</label><input name="IndustrialInput.Systems[__index__].OperationalArea" class="form-control bg-dark text-light border-secondary" /></div>
                                                <div class="col-md-6 mb-2"><label class="form-label">Data exchanged</label><input name="IndustrialInput.Systems[__index__].DataExchanged" class="form-control bg-dark text-light border-secondary" /></div>
                                                <div class="col-md-6 mb-2"><label class="form-label">Integration pattern</label><input name="IndustrialInput.Systems[__index__].IntegrationPattern" class="form-control bg-dark text-light border-secondary" /></div>
                                                <div class="col-md-6 mb-2"><label class="form-label">Criticality</label><input name="IndustrialInput.Systems[__index__].Criticality" class="form-control bg-dark text-light border-secondary" /></div>
                                            </div>
                                            <div class="mb-2"><label class="form-label">Consultant notes</label><textarea name="IndustrialInput.Systems[__index__].ConsultantNotes" rows="3" class="form-control bg-dark text-light border-secondary"></textarea></div>
                                        </fieldset>
                                    </template>
                                    <fieldset class="mb-3 mt-4" id="industrialSectionEvidence">
                                        <legend class="form-label">Section questionnaire evidence references</legend>
                                        <p class="small text-secondary">Select submitted answers that support this section as a whole. Selections are validated against the submitted questionnaire when saved.</p>
                                        @if (Model.EvidenceOptions.Count == 0)
                                        {
                                            <p class="small text-secondary">No questionnaire answers are available to reference.</p>
                                        }
                                        else
                                        {
                                            @foreach (var answer in Model.EvidenceOptions)
                                            {
                                                var selected = Model.IndustrialInput.EvidenceQuestionIds?.Contains(answer.QuestionId, StringComparer.Ordinal) == true;
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="IndustrialInput.EvidenceQuestionIds" value="@answer.QuestionId" id="industrial-evidence-@answer.QuestionId" checked="@selected" />
                                                    <label class="form-check-label small" for="industrial-evidence-@answer.QuestionId">@answer.Number — @answer.Question</label>
                                                </div>
                                            }
                                        }
                                        @{
                                            var otherSectionEvidence = Model.ReportContent?.IndustrialDataAndSystems.EvidenceReferences?
                                                .Where(reference => reference.Kind != SentinelMfgSuite.Web.Models.Assessments.Reports.ReportEvidenceKind.QuestionnaireAnswer).ToArray();
                                        }
                                        @if (otherSectionEvidence is { Length: > 0 })
                                        {
                                            <p class="small text-secondary mt-2 mb-0">Other preserved evidence references (read-only): @string.Join(", ", otherSectionEvidence.Select(reference => $"{reference.Kind}: {reference.ReferenceId}"))</p>
                                        }
                                    </fieldset>
                                    <div class="d-flex justify-content-between align-items-center mb-2 mt-4">
                                        <h4 class="h6 mb-0">Findings</h4>
                                        <button type="button" class="btn btn-outline-info btn-sm" id="addIndustrialFinding">Add Finding</button>
                                    </div>
                                    <p class="small text-secondary">New findings default to a consultant-entered, unverified, preliminary finding with no evidence unless you select it. Nothing is verified automatically.</p>
                                    <div id="industrialFindingsList">
                                        @for (var findingIndex = 0; findingIndex < Model.IndustrialInput.Findings.Count; findingIndex++)
                                        {
                                            var storedFinding = Model.ReportContent?.IndustrialDataAndSystems.Findings?
                                                .FirstOrDefault(item => string.Equals(item.Id, Model.IndustrialInput.Findings[findingIndex].Id, StringComparison.Ordinal));
                                            var otherFindingEvidence = storedFinding?.EvidenceReferences
                                                .Where(reference => reference.Kind != SentinelMfgSuite.Web.Models.Assessments.Reports.ReportEvidenceKind.QuestionnaireAnswer).ToArray();
                                            <fieldset class="border border-secondary rounded-3 p-3 mb-3 industrial-finding-entry">
                                                <legend class="float-none w-auto px-2 small">Edit finding @(findingIndex + 1)</legend>
                                                <input type="hidden" asp-for="IndustrialInput.Findings[findingIndex].Id" />
                                                <span asp-validation-for="IndustrialInput.Findings[findingIndex].Id" class="text-danger"></span>
                                                <div class="mb-2">
                                                    <label asp-for="IndustrialInput.Findings[findingIndex].Title" class="form-label">Title <span class="text-danger">*</span></label>
                                                    <input asp-for="IndustrialInput.Findings[findingIndex].Title" class="form-control bg-dark text-light border-secondary" autocomplete="off" />
                                                    <span asp-validation-for="IndustrialInput.Findings[findingIndex].Title" class="text-danger"></span>
                                                </div>
                                                <div class="mb-2">
                                                    <label asp-for="IndustrialInput.Findings[findingIndex].Narrative" class="form-label">Narrative <span class="text-danger">*</span></label>
                                                    <textarea asp-for="IndustrialInput.Findings[findingIndex].Narrative" rows="4" class="form-control bg-dark text-light border-secondary"></textarea>
                                                    <span asp-validation-for="IndustrialInput.Findings[findingIndex].Narrative" class="text-danger"></span>
                                                </div>
                                                <div class="row g-2">
                                                    <div class="col-md-4 mb-2"><label asp-for="IndustrialInput.Findings[findingIndex].Classification" class="form-label">Classification</label><select asp-for="IndustrialInput.Findings[findingIndex].Classification" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportFindingClassification>()" class="form-select bg-dark text-light border-secondary"></select></div>
                                                    <div class="col-md-4 mb-2"><label asp-for="IndustrialInput.Findings[findingIndex].Provenance" class="form-label">Provenance</label><select asp-for="IndustrialInput.Findings[findingIndex].Provenance" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportContentProvenance>()" class="form-select bg-dark text-light border-secondary"></select></div>
                                                    <div class="col-md-4 mb-2"><label asp-for="IndustrialInput.Findings[findingIndex].VerificationStatus" class="form-label">Verification status</label><select asp-for="IndustrialInput.Findings[findingIndex].VerificationStatus" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportVerificationStatus>()" class="form-select bg-dark text-light border-secondary"></select></div>
                                                </div>
                                                <div class="mb-2"><label asp-for="IndustrialInput.Findings[findingIndex].ConsultantNotes" class="form-label">Consultant notes</label><textarea asp-for="IndustrialInput.Findings[findingIndex].ConsultantNotes" rows="3" class="form-control bg-dark text-light border-secondary"></textarea></div>
                                                <details class="mb-1">
                                                    <summary class="small">Questionnaire evidence references</summary>
                                                    @if (Model.EvidenceOptions.Count == 0)
                                                    {
                                                        <p class="small text-secondary mt-2">No questionnaire answers are available to reference.</p>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var answer in Model.EvidenceOptions)
                                                        {
                                                            var findingSelected = Model.IndustrialInput.Findings[findingIndex].EvidenceQuestionIds?.Contains(answer.QuestionId, StringComparer.Ordinal) == true;
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" name="IndustrialInput.Findings[@findingIndex].EvidenceQuestionIds" value="@answer.QuestionId" id="finding-@findingIndex-evidence-@answer.QuestionId" checked="@findingSelected" />
                                                                <label class="form-check-label small" for="finding-@findingIndex-evidence-@answer.QuestionId">@answer.Number — @answer.Question</label>
                                                            </div>
                                                        }
                                                    }
                                                    @if (otherFindingEvidence is { Length: > 0 })
                                                    {
                                                        <p class="small text-secondary mt-2 mb-0">Other preserved evidence references (read-only): @string.Join(", ", otherFindingEvidence.Select(reference => $"{reference.Kind}: {reference.ReferenceId}"))</p>
                                                    }
                                                </details>
                                            </fieldset>
                                        }
                                    </div>
                                    <template id="industrialFindingTemplate">
                                        <fieldset class="border border-secondary rounded-3 p-3 mb-3 industrial-finding-entry">
                                            <legend class="float-none w-auto px-2 small">New finding</legend>
                                            <input type="hidden" name="IndustrialInput.Findings[__index__].Id" value="" />
                                            <div class="mb-2"><label class="form-label">Title <span class="text-danger">*</span></label><input name="IndustrialInput.Findings[__index__].Title" class="form-control bg-dark text-light border-secondary" autocomplete="off" /></div>
                                            <div class="mb-2"><label class="form-label">Narrative <span class="text-danger">*</span></label><textarea name="IndustrialInput.Findings[__index__].Narrative" rows="4" class="form-control bg-dark text-light border-secondary"></textarea></div>
                                            <div class="row g-2">
                                                <div class="col-md-4 mb-2"><label class="form-label">Classification</label><select name="IndustrialInput.Findings[__index__].Classification" class="form-select bg-dark text-light border-secondary">@foreach (var value in Enum.GetValues<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportFindingClassification>()) { <option value="@value" selected="@(value == SentinelMfgSuite.Web.Models.Assessments.Reports.ReportFindingClassification.PreliminaryFinding)">@value</option> }</select></div>
                                                <div class="col-md-4 mb-2"><label class="form-label">Provenance</label><select name="IndustrialInput.Findings[__index__].Provenance" class="form-select bg-dark text-light border-secondary">@foreach (var value in Enum.GetValues<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportContentProvenance>()) { <option value="@value" selected="@(value == SentinelMfgSuite.Web.Models.Assessments.Reports.ReportContentProvenance.ConsultantEntered)">@value</option> }</select></div>
                                                <div class="col-md-4 mb-2"><label class="form-label">Verification status</label><select name="IndustrialInput.Findings[__index__].VerificationStatus" class="form-select bg-dark text-light border-secondary">@foreach (var value in Enum.GetValues<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportVerificationStatus>()) { <option value="@value" selected="@(value == SentinelMfgSuite.Web.Models.Assessments.Reports.ReportVerificationStatus.Unverified)">@value</option> }</select></div>
                                            </div>
                                            <div class="mb-2"><label class="form-label">Consultant notes</label><textarea name="IndustrialInput.Findings[__index__].ConsultantNotes" rows="3" class="form-control bg-dark text-light border-secondary"></textarea></div>
                                            <details class="mb-1">
                                                <summary class="small">Questionnaire evidence references</summary>
                                                @if (Model.EvidenceOptions.Count == 0)
                                                {
                                                    <p class="small text-secondary mt-2">No questionnaire answers are available to reference.</p>
                                                }
                                                else
                                                {
                                                    @foreach (var answer in Model.EvidenceOptions)
                                                    {
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="checkbox" name="IndustrialInput.Findings[__index__].EvidenceQuestionIds" value="@answer.QuestionId" id="finding-__index__-evidence-@answer.QuestionId" />
                                                            <label class="form-check-label small" for="finding-__index__-evidence-@answer.QuestionId">@answer.Number — @answer.Question</label>
                                                        </div>
                                                    }
                                                }
                                            </details>
                                        </fieldset>
                                    </template>
                                    <button type="submit" class="btn-sentinel-primary" disabled="@(Model.RevisionStatus != SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft)">Save Draft</button>
                                </form>
                            </section>
                            <section id="aiOpportunities" class="border border-info rounded-3 p-3 mb-4" aria-labelledby="aiOpportunitiesHeading">
                                <h3 id="aiOpportunitiesHeading" class="h5 fw-semibold">AI Opportunities &amp; ROI</h3>
                                <p class="small text-secondary">Implementation effort and cost estimates only; no benefits, ROI or payback are calculated. New opportunities are consultant-entered and unverified. Existing IDs, provenance and non-questionnaire evidence are preserved.</p>
                                @if (Model.SaveStatus == "AI Opportunities & ROI Draft saved.")
                                {
                                    <div class="alert alert-success" role="status">@Model.SaveStatus</div>
                                }
                                <form method="post" asp-page-handler="SaveAiOpportunities" asp-fragment="aiOpportunities">
                                    <input type="hidden" asp-for="AssessmentId" />
                                    <input type="hidden" asp-for="SubmittedResponseId" />
                                    <input type="hidden" asp-for="RevisionId" />
                                    <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                    @if (Model.ValidationIssues.Count > 0)
                                    {
                                        <div class="mb-3" role="status">
                                            @foreach (var issue in Model.ValidationIssues)
                                            {
                                                <div class="alert @(issue.Severity == SentinelMfgSuite.Web.Services.Assessments.Reports.ReportContentValidationSeverity.Error ? "alert-danger" : "alert-warning") py-2 mb-2"><strong>@issue.Severity:</strong> @issue.Message</div>
                                            }
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <label asp-for="AiInput.State" class="form-label">Section assessment state</label>
                                        <select asp-for="AiInput.State" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState>()" class="form-select bg-dark text-light border-secondary"></select>
                                    </div>
                                    <h4 class="h6">Opportunities</h4>
                                    <div id="aiOpportunitiesList">
                                        @for (var i = 0; i < Model.AiInput.Opportunities.Count; i++)
                                        {
                                            var stored = Model.ReportContent?.AiOpportunitiesAndRoi.Opportunities?.FirstOrDefault(o => o.Id == Model.AiInput.Opportunities[i].Id);
                                            <partial name="_AiOpportunityEditor" model="new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.AiOpportunityEditorModel(Model.AiInput.Opportunities[i], i.ToString(), Model.EvidenceOptions, stored)" />
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline-light btn-sm mb-3" id="addAiOpportunity">Add opportunity</button>
                                    <h4 class="h6">Findings</h4>
                                    <div id="aiFindingsList">
                                        @for (var i = 0; i < Model.AiInput.Findings.Count; i++)
                                        {
                                            var storedFinding = Model.ReportContent?.AiOpportunitiesAndRoi.Findings?.FirstOrDefault(f => f.Id == Model.AiInput.Findings[i].Id);
                                            <partial name="_AiFindingEditor" model="new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.AiFindingEditorModel(Model.AiInput.Findings[i], i.ToString(), Model.EvidenceOptions, storedFinding)" />
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline-light btn-sm mb-3" id="addAiFinding">Add finding</button>
                                    @{
                                        var newOppInput = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.OpportunityInput
                                        {
                                            Provenance = SentinelMfgSuite.Web.Models.Assessments.Reports.ReportContentProvenance.ConsultantEntered,
                                            VerificationStatus = SentinelMfgSuite.Web.Models.Assessments.Reports.ReportVerificationStatus.Unverified,
                                            ScopeState = SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState.NotAssessed,
                                            EstimateStatus = SentinelMfgSuite.Web.Models.Assessments.Reports.ReportEstimateStatus.NotEstimated
                                        };
                                        var newOppModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.AiOpportunityEditorModel(newOppInput, "__index__", Model.EvidenceOptions, null);
                                        var newFindingModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.AiFindingEditorModel(new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.FindingInput(), "__index__", Model.EvidenceOptions, null);
                                    }
                                    <template id="aiOpportunityTemplate">
                                        <partial name="_AiOpportunityEditor" model="newOppModel" />
                                    </template>
                                    <template id="aiFindingTemplate">
                                        <partial name="_AiFindingEditor" model="newFindingModel" />
                                    </template>
                                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                                    <button type="submit" class="btn-sentinel-primary" disabled="@(Model.RevisionStatus != SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft)">Save Draft</button>
                                </form>
                            </section>
                            <section id="technicalGaps" class="border border-info rounded-3 p-3 mb-4" aria-labelledby="technicalGapsHeading">
                                <h3 id="technicalGapsHeading" class="h5 fw-semibold">Technical Gaps &amp; Architecture</h3>
                                <p class="small text-secondary">New records are consultant-entered, unverified and do not require validation unless you select it. Records are never verified automatically. Existing IDs, provenance and non-questionnaire evidence are preserved; saved records cannot be deleted here.</p>
                                @if (Model.SaveStatus == "Technical Gaps & Architecture Draft saved.")
                                {
                                    <div class="alert alert-success" role="status">@Model.SaveStatus</div>
                                }
                                <form method="post" asp-page-handler="SaveTechnicalGaps" asp-fragment="technicalGaps">
                                    <input type="hidden" asp-for="AssessmentId" />
                                    <input type="hidden" asp-for="SubmittedResponseId" />
                                    <input type="hidden" asp-for="RevisionId" />
                                    <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                    @if (Model.ValidationIssues.Count > 0)
                                    {
                                        <div class="mb-3" role="status">
                                            @foreach (var issue in Model.ValidationIssues)
                                            {
                                                <div class="alert @(issue.Severity == SentinelMfgSuite.Web.Services.Assessments.Reports.ReportContentValidationSeverity.Error ? "alert-danger" : "alert-warning") py-2 mb-2"><strong>@issue.Severity:</strong> @issue.Message</div>
                                            }
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <label asp-for="TechnicalInput.State" class="form-label">Section assessment state</label>
                                        <select asp-for="TechnicalInput.State" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState>()" class="form-select bg-dark text-light border-secondary"></select>
                                    </div>
                                    <h4 class="h6">Gaps</h4>
                                    <div id="technicalGapsList">
                                        @for (var i = 0; i < Model.TechnicalInput.Gaps.Count; i++)
                                        {
                                            var storedGap = Model.ReportContent?.TechnicalGapsAndArchitecture.Gaps?.FirstOrDefault(g => g.Id == Model.TechnicalInput.Gaps[i].Id);
                                            <partial name="_TechnicalGapEditor" model="new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.TechnicalGapEditorModel(Model.TechnicalInput.Gaps[i], i.ToString(), Model.EvidenceOptions, storedGap)" />
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline-light btn-sm mb-3" id="addTechnicalGap">Add gap</button>
                                    <h4 class="h6">Recommendations</h4>
                                    <div id="technicalRecommendationsList">
                                        @for (var i = 0; i < Model.TechnicalInput.Recommendations.Count; i++)
                                        {
                                            var storedRec = Model.ReportContent?.TechnicalGapsAndArchitecture.Recommendations?.FirstOrDefault(r => r.Id == Model.TechnicalInput.Recommendations[i].Id);
                                            <partial name="_ArchitectureRecommendationEditor" model="new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.ArchitectureRecommendationEditorModel(Model.TechnicalInput.Recommendations[i], i.ToString(), Model.EvidenceOptions, storedRec)" />
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline-light btn-sm mb-3" id="addTechnicalRecommendation">Add recommendation</button>
                                    @{
                                        var newGapModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.TechnicalGapEditorModel(new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.TechnicalGapInput(), "__index__", Model.EvidenceOptions, null);
                                        var newRecModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.ArchitectureRecommendationEditorModel(new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.ArchitectureRecommendationInput(), "__index__", Model.EvidenceOptions, null);
                                    }
                                    <template id="technicalGapTemplate">
                                        <partial name="_TechnicalGapEditor" model="newGapModel" />
                                    </template>
                                    <template id="technicalRecommendationTemplate">
                                        <partial name="_ArchitectureRecommendationEditor" model="newRecModel" />
                                    </template>
                                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                                    <button type="submit" class="btn-sentinel-primary" disabled="@(Model.RevisionStatus != SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft)">Save Draft</button>
                                </form>
                            </section>
                            <section id="roadmap" class="border border-info rounded-3 p-3 mb-4" aria-labelledby="roadmapHeading">
                                <h3 id="roadmapHeading" class="h5 fw-semibold">Implementation Roadmap</h3>
                                <p class="small text-secondary">Days are inclusive, between 1 and 90; no scheduling is inferred. Priorities must be unique positive numbers and are never renumbered. New items are consultant-entered and unverified. Saved items cannot be deleted here.</p>
                                @if (Model.SaveStatus == "Implementation Roadmap Draft saved.")
                                {
                                    <div class="alert alert-success" role="status">@Model.SaveStatus</div>
                                }
                                <form method="post" asp-page-handler="SaveRoadmap" asp-fragment="roadmap">
                                    <input type="hidden" asp-for="AssessmentId" />
                                    <input type="hidden" asp-for="SubmittedResponseId" />
                                    <input type="hidden" asp-for="RevisionId" />
                                    <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                    @if (Model.ValidationIssues.Count > 0)
                                    {
                                        <div class="mb-3" role="status">
                                            @foreach (var issue in Model.ValidationIssues)
                                            {
                                                <div class="alert @(issue.Severity == SentinelMfgSuite.Web.Services.Assessments.Reports.ReportContentValidationSeverity.Error ? "alert-danger" : "alert-warning") py-2 mb-2"><strong>@issue.Severity:</strong> @issue.Message</div>
                                            }
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <label asp-for="RoadmapInput.State" class="form-label">Section assessment state</label>
                                        <select asp-for="RoadmapInput.State" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState>()" class="form-select bg-dark text-light border-secondary"></select>
                                    </div>
                                    @{
                                        var storedRoadmap = Model.ReportContent?.ImplementationRoadmap.Items ?? Array.Empty<SentinelMfgSuite.Web.Models.Assessments.Reports.RoadmapItem>();
                                        var nextPriority = 1;
                                        var usedPriorities = Model.RoadmapInput.Items.Select(r => r.Priority ?? 0).Concat(storedRoadmap.Select(r => r.Priority)).ToHashSet();
                                        while (usedPriorities.Contains(nextPriority)) { nextPriority++; }
                                    }
                                    <div id="roadmapList" data-next-priority="@nextPriority">
                                        @for (var i = 0; i < Model.RoadmapInput.Items.Count; i++)
                                        {
                                            var storedItem = storedRoadmap.FirstOrDefault(r => r.Id == Model.RoadmapInput.Items[i].Id);
                                            <partial name="_RoadmapItemEditor" model="new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.RoadmapItemEditorModel(Model.RoadmapInput.Items[i], i.ToString(), Model.EvidenceOptions, storedItem, storedRoadmap)" />
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline-light btn-sm mb-3" id="addRoadmapItem">Add roadmap item</button>
                                    @{
                                        var newRoadmapModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.RoadmapItemEditorModel(new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.RoadmapItemInput { StartDay = 1, EndDay = 1, Priority = null }, "__index__", Model.EvidenceOptions, null, storedRoadmap);
                                    }
                                    <template id="roadmapItemTemplate">
                                        <partial name="_RoadmapItemEditor" model="newRoadmapModel" />
                                    </template>
                                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                                    <button type="submit" class="btn-sentinel-primary" disabled="@(Model.RevisionStatus != SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft)">Save Draft</button>
                                </form>
                            </section>
                            <section id="executivePresentation" class="border border-info rounded-3 p-3 mb-4" aria-labelledby="executivePresentationHeading">
                                <h3 id="executivePresentationHeading" class="h5 fw-semibold">Executive Presentation</h3>
                                <p class="small text-secondary">Refer to the Executive Summary and Implementation Roadmap above for context. Nothing is copied automatically. New entries are consultant-entered and unverified; verification is never set automatically. Saved entries cannot be deleted here. InReview requires evidence on both the section and each entry.</p>
                                @if (Model.SaveStatus == "Executive Presentation Draft saved.")
                                {
                                    <div class="alert alert-success" role="status">@Model.SaveStatus</div>
                                }
                                <form method="post" asp-page-handler="SaveExecutivePresentation" asp-fragment="executivePresentation">
                                    <input type="hidden" asp-for="AssessmentId" />
                                    <input type="hidden" asp-for="SubmittedResponseId" />
                                    <input type="hidden" asp-for="RevisionId" />
                                    <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                    @if (Model.ValidationIssues.Count > 0)
                                    {
                                        <div class="mb-3" role="status">
                                            @foreach (var issue in Model.ValidationIssues)
                                            {
                                                <div class="alert @(issue.Severity == SentinelMfgSuite.Web.Services.Assessments.Reports.ReportContentValidationSeverity.Error ? "alert-danger" : "alert-warning") py-2 mb-2"><strong>@issue.Severity:</strong> @issue.Message</div>
                                            }
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <label asp-for="PresentationInput.State" class="form-label">Section assessment state</label>
                                        <select asp-for="PresentationInput.State" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState>()" class="form-select bg-dark text-light border-secondary"></select>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="PresentationInput.Title" class="form-label">Title</label>
                                        <input asp-for="PresentationInput.Title" class="form-control bg-dark text-light border-secondary" autocomplete="off" />
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="PresentationInput.Narrative" class="form-label">Narrative</label>
                                        <textarea asp-for="PresentationInput.Narrative" rows="4" class="form-control bg-dark text-light border-secondary"></textarea>
                                    </div>
                                    @{
                                        var storedPresentation = Model.ReportContent?.ExecutivePresentation;
                                        var storedKeyMessages = storedPresentation?.KeyMessages ?? Array.Empty<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportTextEntry>();
                                        var storedDecisions = storedPresentation?.DecisionsRequested ?? Array.Empty<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportTextEntry>();
                                        var newKeyMessageModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.TextEntryEditorModel(new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.PresentationEntryInput(), "KeyMessages", "__index__", "Key message", Model.EvidenceOptions, null);
                                        var newDecisionModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.TextEntryEditorModel(new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.PresentationEntryInput(), "DecisionsRequested", "__index__", "Decision requested", Model.EvidenceOptions, null);
                                    }
                                    <h4 class="h6">Key messages</h4>
                                    <div id="presKeyMessagesList">
                                        @for (var i = 0; i < Model.PresentationInput.KeyMessages.Count; i++)
                                        {
                                            var entry = Model.PresentationInput.KeyMessages[i];
                                            var entryModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.TextEntryEditorModel(entry, "KeyMessages", i.ToString(), "Key message", Model.EvidenceOptions, storedKeyMessages.FirstOrDefault(s => s.Id == entry.Id));
                                            <partial name="_ReportTextEntryEditor" model="entryModel" />
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline-light btn-sm mb-3" id="addPresKeyMessage">Add key message</button>
                                    <template id="presKeyMessageTemplate"><partial name="_ReportTextEntryEditor" model="newKeyMessageModel" /></template>
                                    <h4 class="h6">Decisions requested</h4>
                                    <div id="presDecisionsList">
                                        @for (var i = 0; i < Model.PresentationInput.DecisionsRequested.Count; i++)
                                        {
                                            var entry = Model.PresentationInput.DecisionsRequested[i];
                                            var entryModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.TextEntryEditorModel(entry, "DecisionsRequested", i.ToString(), "Decision requested", Model.EvidenceOptions, storedDecisions.FirstOrDefault(s => s.Id == entry.Id));
                                            <partial name="_ReportTextEntryEditor" model="entryModel" />
                                        }
                                    </div>
                                    <button type="button" class="btn btn-outline-light btn-sm mb-3" id="addPresDecision">Add decision requested</button>
                                    <template id="presDecisionTemplate"><partial name="_ReportTextEntryEditor" model="newDecisionModel" /></template>
                                    <div class="mb-3">
                                        <input type="hidden" name="PresentationInput.TopRisksSubmitted" value="true" />
                                        <label asp-for="PresentationInput.TopRisksText" class="form-label">Top risks (one per line)</label>
                                        <textarea asp-for="PresentationInput.TopRisksText" rows="4" class="form-control bg-dark text-light border-secondary"></textarea>
                                    </div>
                                    @{
                                        var presSectionOther = storedPresentation?.EvidenceReferences?.Where(r => r.Kind != SentinelMfgSuite.Web.Models.Assessments.Reports.ReportEvidenceKind.QuestionnaireAnswer).ToArray();
                                        var presSectionEvidence = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.EvidenceCheckboxModel(Model.EvidenceOptions, "PresentationInput.EvidenceQuestionIds", "pres-section-evidence", Model.PresentationInput.EvidenceQuestionIds);
                                    }
                                    <details class="mb-3">
                                        <summary class="small">Section questionnaire evidence references</summary>
                                        <input type="hidden" name="PresentationInput.EvidenceSubmitted" value="true" />
                                        <partial name="_EvidenceCheckboxes" model="presSectionEvidence" />
                                        @if (presSectionOther is { Length: > 0 })
                                        {
                                            <p class="small text-secondary mt-2 mb-0">Other preserved evidence references (read-only): @string.Join(", ", presSectionOther.Select(r => $"{r.Kind}: {r.ReferenceId}"))</p>
                                        }
                                    </details>
                                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                                    <button type="submit" class="btn-sentinel-primary" disabled="@(Model.RevisionStatus != SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft)">Save Draft</button>
                                </form>
                            </section>
                        </div>
                    </section>
                </div>
            </div>
        }
    </section>
</main>

<script>
    (() => {
        const addButton = document.getElementById('addIndustrialSystem');
        const list = document.getElementById('industrialSystemsList');
        const template = document.getElementById('industrialSystemTemplate');
        const labelExistingSystemEditors = () => {
            list?.querySelectorAll('fieldset legend').forEach((legend, index) => {
                legend.textContent = `Edit system ${index + 1}`;
            });
        };
        labelExistingSystemEditors();
        if (!addButton || !list || !template) return;
        addButton.addEventListener('click', () => {
            const index = list.querySelectorAll('.industrial-system-entry').length;
            const fragment = template.content.cloneNode(true);
            fragment.querySelectorAll('[name]').forEach(element => {
                element.name = element.name.replaceAll('__index__', index);
            });
            list.appendChild(fragment);
            labelExistingSystemEditors();
        });

        const wireAiAdd = (buttonId, listId, templateId, selector) => {
            const button = document.getElementById(buttonId);
            const aiList = document.getElementById(listId);
            const aiTemplate = document.getElementById(templateId);
            if (!button || !aiList || !aiTemplate) return;
            button.addEventListener('click', () => {
                const index = aiList.querySelectorAll(selector).length;
                const fragment = aiTemplate.content.cloneNode(true);
                fragment.querySelectorAll('[name]').forEach(e => { e.name = e.name.replaceAll('__index__', index); });
                fragment.querySelectorAll('[id]').forEach(e => { e.id = e.id.replaceAll('__index__', index); });
                fragment.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replaceAll('__index__', index); });
                aiList.appendChild(fragment);
            });
        };
        wireAiAdd('addAiOpportunity', 'aiOpportunitiesList', 'aiOpportunityTemplate', '.ai-opportunity-entry');
        wireAiAdd('addAiFinding', 'aiFindingsList', 'aiFindingTemplate', '.ai-finding-entry');

        const wireTechnical = (buttonId, listId, templateId, selector, root) => {
            const button = document.getElementById(buttonId);
            const techList = document.getElementById(listId);
            const techTemplate = document.getElementById(templateId);
            if (!button || !techList || !techTemplate) return;
            const reindex = () => {
                techList.querySelectorAll(selector).forEach((entry, index) => {
                    entry.querySelectorAll('[name]').forEach(e => { e.name = e.name.replace(/\[\d+\]/, `[${index}]`); });
                    entry.querySelectorAll('[id]').forEach(e => { e.id = e.id.replace(new RegExp(`^${root}-\\d+-`), `${root}-${index}-`); });
                    entry.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replace(new RegExp(`^${root}-\\d+-`), `${root}-${index}-`); });
                });
            };
            button.addEventListener('click', () => {
                const index = techList.querySelectorAll(selector).length;
                const fragment = techTemplate.content.cloneNode(true);
                fragment.querySelectorAll('[name]').forEach(e => { e.name = e.name.replaceAll('__index__', index); });
                fragment.querySelectorAll('[id]').forEach(e => { e.id = e.id.replaceAll('__index__', index); });
                fragment.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replaceAll('__index__', index); });
                techList.appendChild(fragment);
            });
            techList.addEventListener('click', event => {
                const target = event.target.closest('.remove-new-row');
                if (!target) return;
                target.closest(selector)?.remove();
                reindex();
                button.focus();
            });
        };
        wireTechnical('addTechnicalGap', 'technicalGapsList', 'technicalGapTemplate', '.technical-gap-entry', 'tech-gap');
        wireTechnical('addTechnicalRecommendation', 'technicalRecommendationsList', 'technicalRecommendationTemplate', '.architecture-recommendation-entry', 'tech-rec');

        (() => {
            const button = document.getElementById('addRoadmapItem');
            const list = document.getElementById('roadmapList');
            const tpl = document.getElementById('roadmapItemTemplate');
            if (!button || !list || !tpl) return;
            const selector = '.roadmap-item-entry';
            let nextPriority = parseInt(list.dataset.nextPriority || '1', 10);
            const reindex = () => {
                list.querySelectorAll(selector).forEach((entry, index) => {
                    entry.querySelectorAll('[name]').forEach(e => { e.name = e.name.replace(/\[\d+\]/, `[${index}]`); });
                    entry.querySelectorAll('[id]').forEach(e => { e.id = e.id.replace(/^roadmap-\d+-/, `roadmap-${index}-`); });
                    entry.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replace(/^roadmap-\d+-/, `roadmap-${index}-`); });
                });
            };
            button.addEventListener('click', () => {
                const index = list.querySelectorAll(selector).length;
                const fragment = tpl.content.cloneNode(true);
                fragment.querySelectorAll('[name]').forEach(e => { e.name = e.name.replaceAll('__index__', index); });
                fragment.querySelectorAll('[id]').forEach(e => { e.id = e.id.replaceAll('__index__', index); });
                fragment.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replaceAll('__index__', index); });
                const priority = fragment.querySelector('input[name$=".Priority"]');
                if (priority) { priority.value = nextPriority++; }
                list.appendChild(fragment);
            });
            list.addEventListener('click', event => {
                const target = event.target.closest('.remove-new-row');
                if (!target) return;
                target.closest(selector)?.remove();
                reindex();
                button.focus();
            });
        })();

        const wirePresentation = (addId, listId, tplId, listName) => {
            const button = document.getElementById(addId);
            const list = document.getElementById(listId);
            const tpl = document.getElementById(tplId);
            if (!button || !list || !tpl) return;
            const selector = '.presentation-entry';
            const idRe = new RegExp('^pres' + listName + '-\\d+-');
            const reindex = () => {
                list.querySelectorAll(selector).forEach((entry, index) => {
                    entry.querySelectorAll('[name]').forEach(e => { e.name = e.name.replace(/\[\d+\]/, `[${index}]`); });
                    entry.querySelectorAll('[id]').forEach(e => { e.id = e.id.replace(idRe, `pres${listName}-${index}-`); });
                    entry.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replace(idRe, `pres${listName}-${index}-`); });
                });
            };
            button.addEventListener('click', () => {
                const index = list.querySelectorAll(selector).length;
                const fragment = tpl.content.cloneNode(true);
                fragment.querySelectorAll('[name]').forEach(e => { e.name = e.name.replaceAll('__index__', index); });
                fragment.querySelectorAll('[id]').forEach(e => { e.id = e.id.replaceAll('__index__', index); });
                fragment.querySelectorAll('[for]').forEach(e => { e.htmlFor = e.htmlFor.replaceAll('__index__', index); });
                list.appendChild(fragment);
            });
            list.addEventListener('click', event => {
                const target = event.target.closest('.remove-new-row');
                if (!target) return;
                target.closest(selector)?.remove();
                reindex();
                button.focus();
            });
        };
        wirePresentation('addPresKeyMessage', 'presKeyMessagesList', 'presKeyMessageTemplate', 'KeyMessages');
        wirePresentation('addPresDecision', 'presDecisionsList', 'presDecisionTemplate', 'DecisionsRequested');

        const addFindingButton = document.getElementById('addIndustrialFinding');
        const findingList = document.getElementById('industrialFindingsList');
        const findingTemplate = document.getElementById('industrialFindingTemplate');
        const labelFindingEditors = () => {
            findingList?.querySelectorAll('.industrial-finding-entry > legend').forEach((legend, index) => {
                legend.textContent = `Edit finding ${index + 1}`;
            });
        };
        labelFindingEditors();
        if (!addFindingButton || !findingList || !findingTemplate) return;
        addFindingButton.addEventListener('click', () => {
            const index = findingList.querySelectorAll('.industrial-finding-entry').length;
            const fragment = findingTemplate.content.cloneNode(true);
            fragment.querySelectorAll('[name]').forEach(element => {
                element.name = element.name.replaceAll('__index__', index);
            });
            fragment.querySelectorAll('[id]').forEach(element => {
                element.id = element.id.replaceAll('__index__', index);
            });
            fragment.querySelectorAll('[for]').forEach(element => {
                element.htmlFor = element.htmlFor.replaceAll('__index__', index);
            });
            findingList.appendChild(fragment);
            labelFindingEditors();
        });
    })();
</script>
