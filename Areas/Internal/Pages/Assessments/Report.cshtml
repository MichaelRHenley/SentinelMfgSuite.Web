                                            </div>
                                            <div class="mb-2"><label class="form-label">Consultant notes</label><textarea name="IndustrialInput.Findings[__index__].ConsultantNotes" rows="3" class="form-control bg-dark text-light border-secondary"></textarea></div>
                                            <details class="mb-1">
