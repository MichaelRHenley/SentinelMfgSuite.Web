@page "{assessmentId:guid}/{submittedResponseId:guid}"
@model SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel
@{
    ViewData["Title"] = "Draft Consultant Report";
    ViewData["Description"] = "Internal Draft report workspace for a submitted Sentinel assessment.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="sentinel-main">
    <section class="sentinel-hero py-4 py-lg-5">
        <div class="container">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
                <div>
                    <div class="small text-uppercase text-secondary">Internal consultant workspace</div>
                    <h1 class="h2 fw-semibold mb-2">@Model.AssessmentTitle</h1>
                    <p class="text-secondary mb-0">@Model.SiteName · Submitted @Model.SubmittedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                </div>
                <div class="text-lg-end">
                    <span class="badge rounded-pill @(Model.RevisionStatus == SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft || !Model.RevisionStatus.HasValue ? "bg-warning text-dark" : "bg-secondary")">
                        @(Model.RevisionStatus?.ToString() ?? "Draft not created") — internal only
                    </span>
                    @if (Model.RevisionStatus.HasValue)
                    {
                        <div class="small text-secondary mt-2">Revision @Model.RevisionNumber · @Model.RevisionStatus</div>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="container pb-5">
        <div class="alert alert-warning" role="status">
            Internal report workspace. This is not an approved customer report. Draft editing is available for the Executive Summary, Industrial Data &amp; Systems, AI Opportunities &amp; ROI, Technical Gaps &amp; Architecture, Implementation Roadmap, and Executive Presentation sections. Approval, issuance, PDF generation, and customer delivery are not yet available.
        </div>

        @if (!Model.RevisionId.HasValue)
        {
            <div class="card sentinel-card border-0 rounded-4">
                <div class="card-body p-4">
                    <h2 class="h4">No Draft report exists</h2>
                    <p class="text-secondary">Create a Draft linked to this submitted questionnaire response. No report is created until you confirm this action.</p>
                    <form method="post" asp-page-handler="CreateDraft">
                        <input type="hidden" asp-for="AssessmentId" />
                        <input type="hidden" asp-for="SubmittedResponseId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        <button type="submit" class="btn-sentinel-primary">Create Draft Report</button>
                        <a asp-page="/Assessments/Index" asp-area="Internal" class="btn btn-outline-light ms-2">Back to assessments</a>
                    </form>
                </div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Model.LifecycleMessage))
            {
                <div class="alert alert-success" role="status">@Model.LifecycleMessage</div>
            }
            @if (!string.IsNullOrEmpty(Model.LifecycleError))
            {
                <div class="alert alert-danger" role="alert">
                    @Model.LifecycleError
                    <a class="alert-link ms-2" asp-page="/Assessments/Report" asp-area="Internal" asp-route-assessmentId="@Model.AssessmentId" asp-route-submittedResponseId="@Model.SubmittedResponseId" asp-route-selectedRevisionId="@Model.RevisionId">Refresh</a>
                </div>
            }
            <section class="card sentinel-card border-0 rounded-4 mb-4" aria-labelledby="lifecycleHeading">
                <div class="card-body p-3 p-md-4">
                    <h2 id="lifecycleHeading" class="h4 fw-semibold">Report lifecycle</h2>
                    <p class="small text-secondary mb-2">
                        Revision @Model.RevisionNumber · @Model.RevisionStatus
                        @if (Model.CurrentIssuedRevisionNumber is { } issuedNumber) { <text> · Current Issued revision: @issuedNumber</text> }
                        else { <text> · No Issued revision</text> }
                    </p>
                    <p class="small mb-2">
                        <span class="badge text-bg-secondary">@(Model.IsActiveCorrectionRevision ? "Active revision" : Model.IsCurrentIssuedRevision ? "Current Issued revision" : "Historical revision")</span>
                        @if (Model.IsLatestRevision) { <span class="badge text-bg-light">Latest</span> }
                    </p>
                    @if (Model.IsHistoricalRevision || (Model.RevisionStatus == SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Issued && !Model.IsCurrentIssuedRevision))
                    {
                        <div class="alert alert-info small">You are viewing a historical revision. It is read-only.
                            <a class="alert-link" asp-page="/Assessments/Report" asp-area="Internal" asp-route-assessmentId="@Model.AssessmentId" asp-route-submittedResponseId="@Model.SubmittedResponseId">View the working revision</a>
                        </div>
                    }
                    <div class="d-flex flex-wrap gap-3 align-items-start">
                        @if (Model.CanSubmitForReview)
                        {
                            <form method="post" asp-page-handler="SubmitForReview">
                                <input type="hidden" asp-for="AssessmentId" />
                                <input type="hidden" asp-for="SubmittedResponseId" />
                                <input type="hidden" asp-for="RevisionId" />
                                <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                <button type="submit" class="btn-sentinel-primary">Submit for review</button>
                            </form>
                        }
                        @if (Model.CanApprove)
                        {
                            <form method="post" asp-page-handler="Approve">
                                <input type="hidden" asp-for="AssessmentId" />
                                <input type="hidden" asp-for="SubmittedResponseId" />
                                <input type="hidden" asp-for="RevisionId" />
                                <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                <button type="submit" class="btn-sentinel-primary">Approve</button>
                            </form>
                        }
                        @if (Model.CanIssue)
                        {
                            <form method="post" asp-page-handler="Issue">
                                <input type="hidden" asp-for="AssessmentId" />
                                <input type="hidden" asp-for="SubmittedResponseId" />
                                <input type="hidden" asp-for="RevisionId" />
                                <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                <button type="submit" class="btn-sentinel-primary">Issue</button>
                            </form>
                        }
                        @if (Model.CanReject)
                        {
                            <form method="post" asp-page-handler="Reject">
                                <input type="hidden" asp-for="AssessmentId" />
                                <input type="hidden" asp-for="SubmittedResponseId" />
                                <input type="hidden" asp-for="RevisionId" />
                                <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                <label class="form-label small" for="rejectReason">Rejection reason (required)</label>
                                <textarea id="rejectReason" name="LifecycleReason" class="form-control form-control-sm mb-2" maxlength="2000" required></textarea>
                                <button type="submit" class="btn btn-outline-warning btn-sm">Reject</button>
                            </form>
                        }
                        @if (Model.CanCreateCorrection)
                        {
                            <form method="post" asp-page-handler="CreateCorrection">
                                <input type="hidden" asp-for="AssessmentId" />
                                <input type="hidden" asp-for="SubmittedResponseId" />
                                <input type="hidden" asp-for="RevisionId" />
                                <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                <label class="form-label small" for="correctionReason">Correction reason (optional)</label>
                                <textarea id="correctionReason" name="LifecycleReason" class="form-control form-control-sm mb-2" maxlength="2000"></textarea>
                                <button type="submit" class="btn-sentinel-primary">Create correction</button>
                            </form>
                        }
                    </div>
                    @if (Model.RevisionStatus == SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Issued && Model.ActiveCorrectionExists)
                    {
                        <p class="small text-secondary mt-2 mb-0">A correction is already in progress, so a new one cannot be created.</p>
                    }
                    @if (Model.RevisionStatus is SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Rejected or SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Superseded)
                    {
                        <p class="small text-secondary mt-2 mb-0">This revision is @Model.RevisionStatus and read-only.</p>
                    }
                    <h3 class="h6 mt-4">Revision history</h3>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Revision</th><th>Status</th><th>Created</th><th>Submitted</th><th>Approved</th><th>Issued</th><th>Based on</th><th>Superseded by</th></tr></thead>
                            <tbody>
                            @foreach (var item in Model.RevisionHistory)
                            {
                                <tr>
                                    <td>
                                        @if (item.IsSelected) { <strong>@item.RevisionNumber (viewing)</strong> }
                                        else { <a asp-page="/Assessments/Report" asp-area="Internal" asp-route-assessmentId="@Model.AssessmentId" asp-route-submittedResponseId="@Model.SubmittedResponseId" asp-route-selectedRevisionId="@item.Id">@item.RevisionNumber</a> }
                                    </td>
                                    <td>@item.Status</td>
                                    <td>@item.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
                                    <td>@(item.SubmittedForReviewUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")@(item.SubmittedForReviewByUserId is null ? "" : " · " + item.SubmittedForReviewByUserId)</td>
                                    <td>@(item.ApprovedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")@(item.ApprovedByUserId is null ? "" : " · " + item.ApprovedByUserId)</td>
                                    <td>@(item.IssuedUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")@(item.IssuedByUserId is null ? "" : " · " + item.IssuedByUserId)</td>
                                    <td>@(item.BasedOnRevisionNumber?.ToString() ?? "—")@(string.IsNullOrEmpty(item.CorrectionReason) ? "" : " · " + item.CorrectionReason)</td>
                                    <td>@(item.SupersededByRevisionNumber?.ToString() ?? "—")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
            <div class="row g-4">
                <div class="col-12 col-xl-6">
                    <section class="card sentinel-card border-0 rounded-4 h-100" aria-labelledby="evidenceHeading">
                        <div class="card-body p-3 p-md-4">
                            <h2 id="evidenceHeading" class="h4 fw-semibold">Evidence and scoring context</h2>
                            <p class="small text-secondary">Submitted answers are read-only and sanitized. Scoring shown here is the frozen report snapshot.</p>
                            @if (Model.Scoring is { } score)
                            {
                                <div class="border rounded-3 p-3 mb-3">
                                    <div class="small text-uppercase text-secondary">Overall readiness</div>
                                    <div class="h5 mb-1">@score.OverallStatus</div>
                                    @if (score.OverallScore.HasValue)
                                    {
                                        <div>@score.OverallScore/100 · @score.Classification</div>
                                    }
                                    else
                                    {
                                        <div class="text-secondary">No numeric score or classification is assigned.</div>
                                    }
                                    @if (score.WithholdingReasons.Count > 0)
                                    {
                                        <ul class="small mt-2 mb-0">
                                            @foreach (var reason in score.WithholdingReasons)
                                            {
                                                <li>@reason</li>
                                            }
                                        </ul>
                                    }
                                </div>
                                <div class="table-responsive mb-4">
                                    <table class="table table-dark table-sm align-middle">
                                        <thead><tr><th>Dimension</th><th>Status</th><th>Score</th><th>Evidence</th></tr></thead>
                                        <tbody>
                                            @foreach (var dimension in score.Dimensions)
                                            {
                                                <tr>
                                                    <th>@dimension.Name</th>
                                                    <td>@dimension.Status</td>
                                                    <td>@(dimension.Score.HasValue ? $"{dimension.Score}/100 · {dimension.Classification}" : "Not scored")</td>
                                                    <td>@dimension.ScoreableItems / @dimension.TotalItems</td>
                                                </tr>
                                                @if (dimension.WithholdingReasons.Count > 0)
                                                {
                                                    <tr><td colspan="4" class="small text-secondary">@string.Join("; ", dimension.WithholdingReasons)</td></tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-secondary">Frozen scoring snapshot is unavailable or unsupported.</div>
                            }

                            <h3 class="h5">Submitted questionnaire answers</h3>
                            @if (Model.QuestionnaireSections.Count == 0)
                            {
                                <p class="text-secondary">No readable submitted answers are available.</p>
                            }
                            else
                            {
                                @foreach (var answerSection in Model.QuestionnaireSections)
                                {
                                    <div class="border-top pt-3 mt-3">
                                        <h4 class="h6">@answerSection.Title</h4>
                                        <dl class="mb-0">
                                            @foreach (var answer in answerSection.Answers)
                                            {
                                                <dt class="small text-secondary">@answer.Number — @answer.Question</dt>
                                                <dd class="mb-2">@answer.Answer</dd>
                                            }
                                        </dl>
                                    </div>
                                }
                            }
                        </div>
                    </section>
                </div>
                <div class="col-12 col-xl-6">
                    <section class="card sentinel-card border-0 rounded-4 h-100" aria-labelledby="workspaceHeading">
                        <div class="card-body p-3 p-md-4">
                            <h2 id="workspaceHeading" class="h4 fw-semibold">Consultant report workspace</h2>
                            <p class="small text-secondary">Edit the Executive Summary, Industrial Data &amp; Systems, AI Opportunities &amp; ROI, Technical Gaps &amp; Architecture, Implementation Roadmap, and Executive Presentation Drafts. Evidence and frozen scoring remain read-only in the adjacent panel.</p>
                            @if (Model.SaveStatus is string saveStatus && saveStatus != "AI Opportunities & ROI Draft saved." && saveStatus != "Technical Gaps & Architecture Draft saved." && saveStatus != "Implementation Roadmap Draft saved." && saveStatus != "Executive Presentation Draft saved.")
                            {
                                <div class="alert alert-success" role="status">@saveStatus</div>
                            }
                            @{
                                                            var reportTabs = new (string Id, string Label)[]
                                                            {
                                                                ("executiveSummary", "Executive Summary"),
                                                                ("industrialData", "Industrial Data & Systems"),
                                                                ("aiOpportunities", "AI Opportunities & ROI"),
                                                                ("technicalGaps", "Technical Gaps & Architecture"),
                                                                ("roadmap", "Implementation Roadmap"),
                                                                ("executivePresentation", "Executive Presentation")
                                                            };
                                                        }
                                                        <div class="report-tabs-scroll mb-3">
                                                            <div class="nav nav-pills flex-nowrap report-tabs" id="reportTabList" role="tablist" aria-label="Consultant report sections">
                                                                @for (var tabIndex = 0; tabIndex < reportTabs.Length; tabIndex++)
                                                                {
                                                                    var tab = reportTabs[tabIndex];
                                                                    var isFirstTab = tabIndex == 0;
                                                                    <button type="button" class="nav-link@(isFirstTab ? " active" : "")" id="tab-@tab.Id" role="tab" data-report-tab="@tab.Id" aria-controls="@tab.Id" aria-selected="@(isFirstTab ? "true" : "false")" tabindex="@(isFirstTab ? "0" : "-1")">@tab.Label<span class="report-tab-dirty" aria-hidden="true" hidden> &bull;</span></button>
                                                                }
                                                            </div>
                                                        </div>
                                                        <section id="executiveSummary" class="report-tab-panel" role="tabpanel" aria-labelledby="tab-executiveSummary" tabindex="0">
                                                        <form method="post" asp-page-handler="SaveExecutiveSummary" asp-fragment="executiveSummary" class="border border-info rounded-3 p-3 mb-4" aria-labelledby="executiveSummaryHeading">
                                                            <input type="hidden" name="Input.EvidenceSubmitted" value="true" />
                                <input type="hidden" asp-for="AssessmentId" />
                                <input type="hidden" asp-for="SubmittedResponseId" />
                                <input type="hidden" asp-for="RevisionId" />
                                <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                <h3 id="executiveSummaryHeading" class="h5 fw-semibold">Executive Summary editor</h3>
                                <p class="small text-secondary">This area edits Draft consultant content only. Submitted answers and the scoring snapshot cannot be changed here.</p>
                                @if (Model.LastSavedUtc.HasValue)
                                {
                                    <p class="small text-secondary">Last saved: <time datetime="@Model.LastSavedUtc.Value.ToUniversalTime().ToString("O")">@Model.LastSavedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</time></p>
                                }
                                <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                                @if (Model.ValidationIssues.Count > 0)
                                {
                                    <div class="mb-3" role="status">
                                        @foreach (var issue in Model.ValidationIssues)
                                        {
                                            <div class="alert @(issue.Severity == SentinelMfgSuite.Web.Services.Assessments.Reports.ReportContentValidationSeverity.Error ? "alert-danger" : "alert-warning") py-2 mb-2">
                                                <strong>@issue.Severity:</strong> @issue.Message
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="mb-3">
                                    <label asp-for="Input.State" class="form-label">Assessment state</label>
                                    <select asp-for="Input.State" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState>()" class="form-select bg-dark text-light border-secondary"></select>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Input.Narrative" class="form-label">Executive Summary narrative</label>
                                    <textarea asp-for="Input.Narrative" rows="8" class="form-control bg-dark text-light border-secondary" autocomplete="off"></textarea>
                                    <span asp-validation-for="Input.Narrative" class="text-danger"></span>
                                </div>
                                <fieldset class="mb-3">
                                    <legend class="form-label">Questionnaire evidence references</legend>
                                    @if (Model.EvidenceOptions.Count == 0)
                                    {
                                        <p class="small text-secondary">No questionnaire answers are available to reference.</p>
                                    }
                                    else
                                    {
                                        @foreach (var answer in Model.EvidenceOptions)
                                        {
                                            var selected = Model.Input.EvidenceQuestionIds?.Contains(answer.QuestionId, StringComparer.Ordinal) == true;
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="Input.EvidenceQuestionIds" value="@answer.QuestionId" id="evidence-@answer.QuestionId" checked="@selected" />
                                                <label class="form-check-label small" for="evidence-@answer.QuestionId">@answer.Number — @answer.Question</label>
                                            </div>
                                        }
                                    }
                                </fieldset>
                                <h4 class="h6">Findings</h4>
                                <p class="small text-secondary">Reminder: link findings to evidence and avoid unsupported conclusions. New findings are preliminary, consultant-entered and unverified. Saved findings cannot be removed here.</p>
                                <div id="execFindingsList">
                                    @for (var i = 0; i < Model.Input.Findings.Count; i++)
                                    {
                                        var storedFinding = Model.ReportContent?.ExecutiveSummary.Findings?.FirstOrDefault(f => f.Id == Model.Input.Findings[i].Id);
                                        var execFindingModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.AiFindingEditorModel(Model.Input.Findings[i], i.ToString(), Model.EvidenceOptions, storedFinding, "Input.Findings", "exec-finding", "exec-finding-entry");
                                        <partial name="_AiFindingEditor" model="execFindingModel" />
                                    }
                                </div>
                                <button type="button" class="btn btn-outline-light btn-sm mb-3" id="addExecFinding">Add finding</button>
                                @{
                                    var newExecFindingModel = new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.AiFindingEditorModel(new SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments.ReportModel.FindingInput(), "__index__", Model.EvidenceOptions, null, "Input.Findings", "exec-finding", "exec-finding-entry");
                                }
                                <template id="execFindingTemplate">
                                    <partial name="_AiFindingEditor" model="newExecFindingModel" />
                                    <button type="button" class="btn btn-outline-danger btn-sm mb-3 remove-exec-finding">Remove unsaved finding</button>
                                </template>
                                <div class="d-block"></div>
                                <button type="submit" class="btn-sentinel-primary" disabled="@(Model.RevisionStatus != SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft)">Save Draft</button>
                            </form>
                            <div class="border border-secondary rounded-3 p-3 mb-4" aria-labelledby="execReadinessHeading">
                                <h4 id="execReadinessHeading" class="h6">Readiness representation</h4>
                                <p class="small text-secondary">Read-only. Values are copied from the frozen scoring snapshot only; they cannot be entered or recalculated here.</p>
                                @if (Model.Scoring is { } execScore)
                                {
                                    <p class="mb-1">Frozen snapshot: @execScore.OverallStatus@(execScore.OverallScore.HasValue ? $" · {execScore.OverallScore}/100 · {execScore.Classification}" : string.Empty)</p>
                                }
                                <p class="mb-1">Recorded readiness: @(Model.ReportContent?.ExecutiveSummary.Readiness is { } recordedReadiness ? $"{recordedReadiness.OverallStatus}{(recordedReadiness.OverallDisplayScore0To100.HasValue ? $" · {recordedReadiness.OverallDisplayScore0To100}/100" : string.Empty)}" : "None")</p>
                                <p class="mb-2"><strong>Synchronization:</strong> <span id="readinessSyncStatus">@Model.ReadinessSyncStatus</span></p>
                                <form method="post" asp-page-handler="RecordReadiness" asp-fragment="executiveSummary" class="d-inline-block me-2" data-report-action>
                                    <input type="hidden" asp-for="AssessmentId" />
                                    <input type="hidden" asp-for="SubmittedResponseId" />
                                    <input type="hidden" asp-for="RevisionId" />
                                    <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                    @if (Model.ReportContent?.ExecutiveSummary.Readiness is not null)
                                    {
                                        <div class="form-check"><input class="form-check-input" type="checkbox" id="confirmReplaceReadiness" name="Input.ConfirmReplaceReadiness" value="true" /><label class="form-check-label small" for="confirmReplaceReadiness">Replace the recorded readiness</label></div>
                                    }
                                    <button type="submit" class="btn btn-outline-light btn-sm" disabled="@(Model.RevisionStatus != SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft)">Record readiness from frozen snapshot</button>
                                </form>
                                <form method="post" asp-page-handler="ClearReadiness" asp-fragment="executiveSummary" class="d-inline-block" data-report-action>
                                    <input type="hidden" asp-for="AssessmentId" />
                                    <input type="hidden" asp-for="SubmittedResponseId" />
                                    <input type="hidden" asp-for="RevisionId" />
                                    <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                    <button type="submit" class="btn btn-outline-warning btn-sm" disabled="@(Model.RevisionStatus != SentinelMfgSuite.Web.Models.Assessments.AssessmentReportRevisionStatus.Draft)">Clear recorded readiness</button>
                                </form>
                            </div>
                            </section>
                            <p class="small text-secondary">@(Model.SaveConflict ? "Resolve the conflict by reloading and reviewing the newer Draft before reapplying your text." : "Executive Summary state, narrative, findings, questionnaire evidence references and readiness recording are editable here.")</p>
                            <section id="industrialData" class="report-tab-panel border border-info rounded-3 p-3 mb-4" role="tabpanel" aria-labelledby="tab-industrialData" tabindex="0" hidden>
                                <h3 id="industrialSystemsHeading" class="h5 fw-semibold">Industrial Data &amp; Systems</h3>
                                <p class="small text-secondary">System IDs, provenance, verification status, and evidence are preserved. New systems are consultant-entered and unverified, with no evidence added automatically.</p>
                                @if (Model.SaveStatus == "Industrial Data & Systems Draft saved.")
                                {
                                    <div class="alert alert-success" role="status">@Model.SaveStatus</div>
                                }
                                @if (Model.LastSavedUtc.HasValue)
                                {
                                    <p class="small text-secondary">Last saved: <time datetime="@Model.LastSavedUtc.Value.ToUniversalTime().ToString("O")">@Model.LastSavedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</time></p>
                                }
                                <form method="post" asp-page-handler="SaveIndustrialData" asp-fragment="industrialData">
                                    <input type="hidden" asp-for="AssessmentId" />
                                    <input type="hidden" asp-for="SubmittedResponseId" />
                                    <input type="hidden" asp-for="RevisionId" />
                                    <input type="hidden" asp-for="ExpectedConcurrencyStamp" />
                                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
                                    @if (Model.ValidationIssues.Count > 0)
                                    {
                                        <div class="mb-3" role="status">
                                            @foreach (var issue in Model.ValidationIssues)
                                            {
                                                <div class="alert @(issue.Severity == SentinelMfgSuite.Web.Services.Assessments.Reports.ReportContentValidationSeverity.Error ? "alert-danger" : "alert-warning") py-2 mb-2">
                                                    <strong>@issue.Severity:</strong> @issue.Message
                                                </div>
                                            }
                                        </div>
                                    }
                                    <div class="mb-3">
                                        <label asp-for="IndustrialInput.State" class="form-label">Section assessment state</label>
                                        <select asp-for="IndustrialInput.State" asp-items="Html.GetEnumSelectList<SentinelMfgSuite.Web.Models.Assessments.Reports.ReportAssessmentState>()" class="form-select bg-dark text-light border-secondary"></select>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h4 class="h6 mb-0">System inventory</h4>
                                        <button type="button" class="btn btn-outline-info btn-sm" id="addIndustrialSystem">Add System</button>
                                    </div>
                                    <div id="industrialSystemsList">
                                        @for (var index = 0; index < Model.IndustrialInput.Systems.Count; index++)
                                        {
