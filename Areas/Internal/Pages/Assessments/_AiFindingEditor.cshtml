@using SentinelMfgSuite.Web.Models.Assessments.Reports
@using SentinelMfgSuite.Web.Areas.Internal.Pages.Assessments
@model ReportModel.AiFindingEditorModel
@{
    var input = Model.Input;
    var prefix = $"AiInput.Findings[{Model.Index}]";
    var idPrefix = $"ai-finding-{Model.Index}";
    var otherEvidence = Model.Stored?.EvidenceReferences
        .Where(reference => reference.Kind != ReportEvidenceKind.QuestionnaireAnswer).ToArray();
    var evidenceModel = new ReportModel.EvidenceCheckboxModel(Model.Options, prefix + ".EvidenceQuestionIds", idPrefix + "-evidence", input.EvidenceQuestionIds);
}
<fieldset class="border border-secondary rounded-3 p-3 mb-3 ai-finding-entry">
    <legend class="float-none w-auto px-2 small">Finding</legend>
    <input type="hidden" name="@(prefix + ".Id")" value="@input.Id" />
    <div class="mb-2"><label class="form-label" for="@(idPrefix)-title">Title <span class="text-danger">*</span></label><input id="@(idPrefix)-title" name="@(prefix + ".Title")" value="@input.Title" class="form-control bg-dark text-light border-secondary" autocomplete="off" /></div>
    <div class="mb-2"><label class="form-label" for="@(idPrefix)-narrative">Narrative <span class="text-danger">*</span></label><textarea id="@(idPrefix)-narrative" name="@(prefix + ".Narrative")" rows="4" class="form-control bg-dark text-light border-secondary">@input.Narrative</textarea></div>
    <div class="row g-2">
        <div class="col-md-4 mb-2"><label class="form-label" for="@(idPrefix)-class">Classification</label><select id="@(idPrefix)-class" name="@(prefix + ".Classification")" class="form-select bg-dark text-light border-secondary">@foreach (var value in Enum.GetValues<ReportFindingClassification>()) { <option value="@value" selected="@(value == input.Classification)">@value</option> }</select></div>
        <div class="col-md-4 mb-2"><label class="form-label" for="@(idPrefix)-prov">Provenance</label><select id="@(idPrefix)-prov" name="@(prefix + ".Provenance")" class="form-select bg-dark text-light border-secondary">@foreach (var value in Enum.GetValues<ReportContentProvenance>()) { <option value="@value" selected="@(value == input.Provenance)">@value</option> }</select></div>
        <div class="col-md-4 mb-2"><label class="form-label" for="@(idPrefix)-ver">Verification status</label><select id="@(idPrefix)-ver" name="@(prefix + ".VerificationStatus")" class="form-select bg-dark text-light border-secondary">@foreach (var value in Enum.GetValues<ReportVerificationStatus>()) { <option value="@value" selected="@(value == input.VerificationStatus)">@value</option> }</select></div>
    </div>
    <div class="mb-2"><label class="form-label" for="@(idPrefix)-notes">Consultant notes</label><textarea id="@(idPrefix)-notes" name="@(prefix + ".ConsultantNotes")" rows="3" class="form-control bg-dark text-light border-secondary">@input.ConsultantNotes</textarea></div>
    <details class="mb-1">
        <summary class="small">Questionnaire evidence references</summary>
        <partial name="_EvidenceCheckboxes" model="evidenceModel" />
        @if (otherEvidence is { Length: > 0 })
        {
            <p class="small text-secondary mt-2 mb-0">Other preserved evidence references (read-only): @string.Join(", ", otherEvidence.Select(reference => $"{reference.Kind}: {reference.ReferenceId}"))</p>
        }
    </details>
</fieldset>
